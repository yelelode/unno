    for i = math.max(1, #rec.incidents - 9), #rec.incidents do
        local x = rec.incidents[i]
        lines[#lines + 1] = string.format("[%s] (%s, SEV %d) \"%s\"", x.time, x.cat, x.sev, x.msg)
    end
    for _, x in ipairs(rec.incidents) do if not catSeen[x.cat] then catSeen[x.cat] = true; catList[#catList + 1] = x.cat end end
    lines[#lines + 1] = "Applicable rules: " .. reasonText(catList)
    lines[#lines + 1] = ""
    lines[#lines + 1] = buildLogTextFor(rec.key, rec.name, rec.userId)
    return table.concat(lines, "\n")
end

local REPORT_MSG = { noreason = "No matching Roblox reason.", gone = "Player left the server.", self = "You can't report yourself.", failed = "Direct report blocked on this executor. Pack copied." }
local function submitReport(info, player)
    local reason = CFG.REPORT_REASON[info.cat]
    if not reason then return "noreason" end
    if typeof(player) ~= "Instance" or not player.Parent then return "gone" end
    if player == LocalPlayer then return "self" end
    local ok = pcall(function() Players:ReportAbuse(player, reason, buildTinyReport(info)) end)
    return ok and "sent" or "failed"
end

local function bindReport(btn, getInfo, getPlayer, onDone)
    local armed, token, done = false, 0, false
    btn.Activated:Connect(function()
        if done then return end
        if not armed then
            armed = true; token += 1
            local my = token
            setBtn(btn, "⚠ Confirm?", Th.AMBER)
            task.delay(3, function() if St.alive and armed and my == token and btn.Parent then armed = false; setBtn(btn, "⚡ Report", Th.RED) end end)
            return
        end
        armed = false; token += 1
        local waitT = CFG.REPORT_COOLDOWN - (os.clock() - St.lastReportAt)
        if waitT > 0 then
            toast("Cooldown: " .. math.ceil(waitT) .. "s", Th.AMBER)
            setBtn(btn, "⚡ Report", Th.RED); return
        end
        local info = getInfo()
        local status = submitReport(info, getPlayer())
        if status == "sent" then
            St.lastReportAt = os.clock(); done = true
            setBtn(btn, "✅ Reported", Th.GREEN); toast("✅ Report sent: " .. info.name, Th.GREEN)
            if onDone then onDone() end
        else
            if status ~= "self" then copyToClipboard(buildReportPack(info)) end
            setBtn(btn, "📋 Pack copied", Th.BLUE)
            toast(REPORT_MSG[status] or "Report failed.", Th.AMBER)
            task.delay(2.5, function() if St.alive and btn.Parent and not done then setBtn(btn, "⚡ Report", Th.RED) end end)
        end
    end)
end

