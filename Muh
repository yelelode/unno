local function applyTXRBranding(parent)
    if not parent then return end

    for _, existing in ipairs(parent:GetChildren()) do
        if existing:IsA("ScreenGui") and existing.Name == "TXR_UI" then
            installTopbarAndSettingsControls(existing)
        end
    end

    parent.ChildAdded:Connect(function(gui)
        if gui:IsA("ScreenGui") and gui.Name == "Rayfield" then
            gui.Name = "TXR_UI"

            for _, desc in ipairs(gui:GetDescendants()) do
                applyGlassyStyle(desc)
            end
            gui.DescendantAdded:Connect(applyGlassyStyle)
            installTopbarAndSettingsControls(gui)
        end
    end)
end

