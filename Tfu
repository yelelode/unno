function H.installShield()
    if H.shieldSet then return true end
    if TCS.ChatVersion ~= Enum.ChatVersion.TextChatService then return false end
    local okR, old = pcall(function() return TCS.OnIncomingMessage end)
    H.oldIncoming = okR and old or nil
    local ok = pcall(function()
        TCS.OnIncomingMessage = function(message)
            local props = H.oldIncoming and H.oldIncoming(message) or nil
            if S.alive then
                local src = message.TextSource
                if src and src.UserId ~= LP.UserId then
                    local plr = Players:GetPlayerByUserId(src.UserId)
                    if not (plr and H.trusted(plr)) then
                        local hide, tag
                        local now = os.clock()
                        if S.hidden[tostring(src.UserId)] then hide, tag = true, "hidden" end
                        if not hide and S.calmUntil > now then hide, tag = true, "calm" end
                        local su = S.spamUntil[src.UserId]
                        if not hide and S.hideSpam and su and now < su then hide, tag = true, "spam" end
                        if not hide and S.shield then
                            local ok2, sev = pcall(D.quick, message.Text)
                            if ok2 and type(sev) == "number" and sev >= S.shieldLevel then hide, tag = true, "SEV" .. sev end
                        end
                        if hide then
                            props = props or Instance.new("TextChatMessageProperties")
                            props.Text = "[hidden by Phantom OS · " .. tag .. "]"
                        end
                    end
                end
            end
            return props
        end
    end)
    H.shieldSet = ok
    return ok
end
