end

local function autoScroll(sf)
    track(sf:GetPropertyChangedSignal("AbsoluteCanvasSize"), function()
        sf.CanvasPosition = Vector2.new(0, math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y))
    end)
end

local function segmented(parent, options, initial, onChange, pos, size)
    local f = new("Frame", { Position = pos, Size = size, BackgroundColor3 = PANEL, BorderSizePixel = 0 }, parent)
    round(f, 7)
    outline(f, LINE, 1, 0.3)
    local btns, obj = {}, {}
    local function paint(v)
        for _, o in ipairs(options) do
            local act = (o == v)
            btns[o].BackgroundColor3 = act and NEON_DARK or PANEL
            btns[o].TextColor3 = act and WHITE or MUTED
        end
    end
    for i, o in ipairs(options) do
        local b = new("TextButton", {
            Position = UDim2.new((i - 1) / #options, 2, 0, 2), Size = UDim2.new(1 / #options, -4, 1, -4),
            BackgroundColor3 = PANEL, Text = o, TextSize = 10, Font = Enum.Font.GothamBold,
            TextColor3 = MUTED, AutoButtonColor = false, BorderSizePixel = 0,
        }, f)
        round(b, 5)
        btns[o] = b
        b.Activated:Connect(function()
            paint(o)
            if onChange then
                onChange(o)
            end
        end)
    end
    function obj.set(v)
        paint(v)
    end
    obj.frame = f
    paint(initial)
    return obj
end

local function toggleRow(parent, text, initial, onChange, order)
    local row = new("Frame", { Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = CARD, BorderSizePixel = 0, LayoutOrder = order or 0 }, parent)
    round(row, 8)
    label(row, text, 12, TXT, Enum.Font.GothamMedium, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -66, 1, 0), TextWrapped = false })
    local sw = new("TextButton", {
        Text = "", Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = LINE, AutoButtonColor = false, BorderSizePixel = 0,
    }, row)
    round(sw, 10)
    local knob = new("Frame", { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, sw)
    round(knob, 8)
    local state = initial
    local function paint()
        tw(sw, { BackgroundColor3 = state and NEON_DARK or LINE }, 0.12)
        tw(knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }, 0.12)
    end
    paint()
    sw.Activated:Connect(function()
        state = not state
        paint()
        onChange(state)
    end)
    return { set = function(v) state = v; paint() end }
end

local function segRow(parent, text, options, initial, onChange, order)
