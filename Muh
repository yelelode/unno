}

local function lockCardTopPosition(card, orderVal)
    if not card or not card:IsA("GuiObject") or card:GetAttribute("TXR_PosLocked") then
        return
    end
    card:SetAttribute("TXR_PosLocked", true)
    card.LayoutOrder = orderVal
    card:GetPropertyChangedSignal("LayoutOrder"):Connect(function()
        if card.LayoutOrder ~= orderVal then
            card.LayoutOrder = orderVal
        end
    end)
end

local function enforceModeListOrder(lbl)
    local orderNum = modeOrderMap[lbl.Text]
    if not orderNum then return end

    local itemFrame = lbl.Parent
    if itemFrame and itemFrame:IsA("GuiObject") then
        local listContainer = itemFrame.Parent
        if listContainer and (listContainer.Name == "List" or (listContainer.Parent and listContainer.Parent.Name == "List")) then
            itemFrame.LayoutOrder = orderNum
            local lay = listContainer:FindFirstChildOfClass("UIListLayout")
            if lay and lay.SortOrder ~= Enum.SortOrder.LayoutOrder then
                lay.SortOrder = Enum.SortOrder.LayoutOrder
            end
        end
    end
end

local function applyGlassyStyle(obj)
    if not obj or not obj.Parent then return end

    if obj:IsA("ScrollingFrame") then
        obj.ScrollBarThickness = 2
        obj.ScrollBarImageColor3 = Color3.fromRGB(0, 225, 255)
        obj.ScrollBarImageTransparency = 0.45
    end

    if isCustomDevCard(obj) then
        return
    end

    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        local function fixText()
            if obj.Text and (obj.Text:find("Rayfield") or obj.Text:find("rayfield")) then
                local updated = obj.Text
                updated = updated:gsub("Rayfield UI", "ᴛxʀ ᴜɪ"):gsub("rayfield ui", "ᴛxʀ ᴜɪ")
                updated = updated:gsub("Rayfield", "ᴛxʀ"):gsub("rayfield", "ᴛxʀ")
                obj.Text = updated
            end

            if obj.Text == "ᴇᴍᴩ ꜱᴩᴀᴍᴍᴇʀ ᴠ2.06  •  ꜱʏꜱᴛᴇᴍ" and obj.Parent then
                lockCardTopPosition(obj.Parent, -100)
            elseif obj.Text == "ꜱᴄʀɪᴩᴛ ᴍᴀᴅᴇ ʙʏ: ᴀꜱʜᴜ" and obj.Parent then
                lockCardTopPosition(obj.Parent, -90)
            elseif obj.Text == "Select Spam Style" and obj.Parent then
                lockCardTopPosition(obj.Parent, -80)
            elseif modeOrderMap[obj.Text] then
                task.defer(function() enforceModeListOrder(obj) end)
            end
        end
        fixText()
        obj:GetPropertyChangedSignal("Text"):Connect(fixText)
    elseif obj:IsA("ImageLabel") and obj.Parent and obj.Parent.Name == "Loading" then
        obj.Visible = false
    end

    if obj:IsA("UIStroke") then
        if not obj:GetAttribute("TXR_StrokeKilled") then
            obj:SetAttribute("TXR_StrokeKilled", true)
            obj.Enabled = false
            obj.Transparency = 1
            obj:GetPropertyChangedSignal("Enabled"):Connect(function()
                if obj.Enabled then obj.Enabled = false end
            end)
            obj:GetPropertyChangedSignal("Transparency"):Connect(function()
                if obj.Transparency ~= 1 then obj.Transparency = 1 end
            end)
        end
    end

    if obj:IsA("Frame") and not obj:GetAttribute("TXR_GlassStyled") then
        obj:SetAttribute("TXR_GlassStyled", true)
        local n = obj.Name
        if n == "Main" then
            obj.BackgroundColor3 = Color3.fromRGB(14, 16, 22)
            obj.BackgroundTransparency = 0.36
            obj.ClipsDescendants = true

            local grad = obj:FindFirstChild("TXR_AcrylicMain") or Instance.new("UIGradient", obj)
            grad.Name = "TXR_AcrylicMain"
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.4, Color3.fromRGB(205, 215, 230)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 170, 185))
            })
            grad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.04),
                NumberSequenceKeypoint.new(1, 0.24)
            })
            grad.Rotation = 115
        elseif n == "Topbar" then
            obj.BackgroundColor3 = Color3.fromRGB(10, 12, 18)
            obj.BackgroundTransparency = 0.48
            obj.ClipsDescendants = true
        elseif n == "Elements" or n == "TabBar" or n == "Placeholder" or n == "List" then
            obj.BackgroundTransparency = 1
        elseif obj.Parent and obj.Parent:IsA("ScrollingFrame") and obj.BackgroundTransparency < 0.85 then
            obj.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
            obj.BackgroundTransparency = 0.48

            local cardSheen = obj:FindFirstChild("TXR_CardGlassSheen") or Instance.new("UIGradient", obj)
            cardSheen.Name = "TXR_CardGlassSheen"
            cardSheen.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(215, 225, 240)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 195, 210))
            })
            cardSheen.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.02),
                NumberSequenceKeypoint.new(1, 0.18)
            })
            cardSheen.Rotation = 25
        elseif obj.Parent and obj.Parent.Parent and obj.Parent.Parent:IsA("ScrollingFrame") and obj.BackgroundTransparency < 0.85 then
            if obj.Size.Y.Offset >= 24 and obj.Size.Y.Offset <= 40 then
                obj.BackgroundColor3 = Color3.fromRGB(14, 17, 24)
                obj.BackgroundTransparency = 0.45
            end
        end
    end
