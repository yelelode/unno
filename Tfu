function V.addBubble(role, text)
    V.aiOrder += 1
    local bg, col, prefix = T.CARD, T.TXT, "AI  "
    if role == "user" then bg, prefix = Color3.fromRGB(16, 52, 40), "You  "
    elseif role == "sys" then bg, col, prefix = T.PANEL, T.AMBT, "⚙  " end
    local l = U.label(V.aiScroll, prefix .. text, 12, col, Enum.Font.Gotham, {
        Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0, BackgroundColor3 = bg,
        TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = V.aiOrder,
    })
    U.round(l, 10)
    U.pad(l, 8, 6, 8, 6)
    V.aiBubbles[#V.aiBubbles + 1] = l
    if #V.aiBubbles > 50 then local old = table.remove(V.aiBubbles, 1) if old then old:Destroy() end end
    return l
end
function V.command(text)
    local cmd, arg = text:match("^/(%a+)%s*(.-)%s*$")
    cmd = (cmd or ""):lower()
    arg = (arg or ""):lower():gsub("[^%a]", "")
    if cmd == "add" and #arg >= 2 then
        S.custom[arg] = { cat = "profanity", sev = 3 }
        D.add(arg, "profanity", 3, nil, false)
        S.whitelist[arg] = nil
        N.save()
        V.addBubble("sys", "Added '" .. arg .. "' to the bad-word list.")
    elseif cmd == "white" and #arg >= 2 then
        S.whitelist[arg], S.custom[arg], S.learned[arg], D.remote[arg] = true, nil, nil, nil
        if not D.builtin[D.c2(arg)] then D.exact[D.c2(arg)] = nil D.exact[D.c1(arg)] = nil end
        N.save()
        V.addBubble("sys", "'" .. arg .. "' is now ignored (whitelisted).")
    elseif cmd == "stats" then
        local names = {}
        for _, p in ipairs(A.providers()) do names[#names + 1] = p.name end
        V.addBubble("sys", "Scanned " .. S.scanned .. " | Flagged " .. S.flagged .. " | Offenders " .. U.count(S.strikes) .. " | Tags " .. S.tags
            .. " | Learned " .. U.count(S.learned) .. " | Lists " .. D.rstat.words .. "w/" .. D.rstat.phrases .. "p (" .. D.rstat.status .. ")"
            .. " | AI: " .. (#names > 0 and table.concat(names, ">") or "none") .. " | last " .. S.aiLast)
    elseif cmd == "refresh" then
        V.addBubble("sys", "Re-downloading internet lists…")
        task.spawn(function()
            D.remote, D.rphr = {}, {}
            pcall(N.loadRemote, true)
            if S.alive then V.addBubble("sys", "Lists: " .. D.rstat.words .. " words / " .. D.rstat.phrases .. " phrases (" .. D.rstat.status .. ")") end
        end)
    elseif cmd == "reset" then
        S.strikes, S.chatLog = {}, {}
        S.flagged, S.tags, S.lastFlagged = 0, 0, nil
        H.refreshAll()
        V.status()
        V.addBubble("sys", "Strikes and logs cleared.")
    else
        V.addBubble("sys", "Commands: /add <word> • /white <word> • /stats • /refresh • /reset")
    end
end
function V.buildAI()
    local page = V.pages.AI
    V.aiScroll = U.scroll(page, UDim2.new(), UDim2.new(1, 0, 1, -98))
    U.autoScroll(V.aiScroll)
    V.aiOrder, V.aiBubbles = 0, {}
    local chipRow = U.new("Frame", { Position = UDim2.new(0, 0, 1, -94), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, page)
    for i, c in ipairs({ { "📊 Stats", "/stats" }, { "🔄 Lists", "/refresh" }, { "🧹 Reset", "/reset" }, { "ℹ Help", "/help" } }) do
        U.button(chipRow, c[1], T.PANEL, UDim2.new(0.25, -4, 1, 0), UDim2.new((i - 1) / 4, 2, 0, 0), function() V.command(c[2]) end, 10)
    end
    local analyze = U.button(page, "🤖 Analyze last flagged message", T.NEOND, UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 1, -66), nil, 11)
    local input = U.new("TextBox", {
        Position = UDim2.new(0, 0, 1, -34), Size = UDim2.new(1, -64, 0, 32), BackgroundColor3 = T.CARD, Text = "", PlaceholderText = "Ask AI or type /help",
        PlaceholderColor3 = T.MUTED, TextColor3 = T.TXT, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0,
    }, page)
    U.round(input, 8)
    U.outline(input, T.NEON, 1, 0.5)
    U.pad(input, 8, 0, 8, 0)
    local send = U.button(page, "Send", T.NEON, UDim2.new(0, 58, 0, 32), UDim2.new(1, -58, 1, -34), nil, 12)
    send.TextColor3 = T.BG
    V.addBubble("sys", "Free AI ready. Live chat is auto-checked in the Live tab. Use the chips below or type /help.")

    local convo, busy = {}, false
    local function sendChat(override, shown)
        if busy or not S.alive then return end
        local text = override or (input.Text or ""):match("^%s*(.-)%s*$")
        if not text or text == "" then return end
        if not override then
            input.Text = ""
            if text:sub(1, 1) == "/" then V.command(text) return end
        end
        V.addBubble("user", shown or text)
        table.insert(convo, { role = "user", content = text })
        busy = true
        U.setBtn(send, "…")
        local thinking = V.addBubble("ai", "thinking…")
        task.spawn(function()
            local msgs = { { role = "system", content = "You are a concise assistant inside a Roblox moderation tool that helps keep chats safe and kind. Keep answers short." } }
            for i = math.max(1, #convo - 9), #convo do msgs[#msgs + 1] = convo[i] end
            local reply, prov, err = A.call(msgs, 300)
            if reply then
                table.insert(convo, { role = "assistant", content = reply })
                S.aiLast = prov or S.aiLast
                reply = reply .. "\n(" .. tostring(prov) .. ")"
            else
                reply = "Error: " .. tostring(err)
            end
            if S.alive then
                if thinking and thinking.Parent then thinking.Text = "AI  " .. reply else V.addBubble("ai", reply) end
                U.setBtn(send, "Send")
                V.status()
            end
            busy = false
        end)
    end
    send.Activated:Connect(function() sendChat() end)
    input.FocusLost:Connect(function(enter) if enter then sendChat() end end)
    analyze.Activated:Connect(function()
        local m = S.lastFlagged
        if not m then V.addBubble("sys", "No flagged message yet.") return end
        sendChat("Moderation review. Is this Roblox chat message a violation of Roblox Community Standards? Player: " .. m.name .. ". Message: \""
            .. m.msg:sub(1, 200) .. "\". Auto-detected: " .. table.concat(m.cats, ", ") .. " (severity " .. m.sev
            .. "/5). Reply briefly: verdict, whether it could be a false positive, and best report category.", "Analyze: " .. m.name .. ": " .. m.msg:sub(1, 60))
    end)
end

