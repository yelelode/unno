local function refreshProviders()
    local enabled = {
        Groq = hasKey(GROQ_KEY), Gemini = hasKey(GEMINI_KEY), OpenRouter = hasKey(AI_API_KEY), Pollinations = USE_FREE_FALLBACK,
    }
    local now = os.clock()
    local anyReady, anyCool = false, false
    for name, lbl in pairs(provLabels) do
        if not enabled[name] then
            lbl.Text, lbl.TextColor3 = "○ off (no key)", MUTED
        elseif rate[name].coolUntil > now then
            anyCool = true
            lbl.Text, lbl.TextColor3 = "● cooling " .. math.ceil(rate[name].coolUntil - now) .. "s", AMBER
        else
            anyReady = true
            lbl.Text, lbl.TextColor3 = "● ready", GREEN
        end
    end
    statusDot.BackgroundColor3 = anyReady and GREEN or (anyCool and AMBER or RED)
    listsLabel.Text = "🌐 " .. remoteStats.words .. " words · " .. remoteStats.phrases .. " phrases · " .. remoteStats.status
end

