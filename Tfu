-- staggered entrance fade for list items
function U.pop(inst, delay)
    if S.perfNow or not inst or not inst.Parent then return end
    if inst:IsA("CanvasGroup") then
        inst.GroupTransparency = 1
        task.delay(math.min(delay or 0, 0.45), function()
            if inst.Parent then U.tw(inst, { GroupTransparency = 0 }, 0.45) end
        end)
        return
    end
    local bt = inst.BackgroundTransparency
    local st = inst:FindFirstChildOfClass("UIStroke")
    local stt = st and st.Transparency
    inst.BackgroundTransparency = 1
    if st then st.Transparency = 1 end
    task.delay(math.min(delay or 0, 0.45), function()
        if inst.Parent then
            U.tw(inst, { BackgroundTransparency = bt }, 0.4)
            if st then U.tw(st, { Transparency = stt }, 0.4) end
        end
    end)
end
