    Pollinations = { gap = 6, min = 4, max = 25, nextAt = 0, coolUntil = 0, pen = 4 },
}
function A.providers()
    local l = {}
    if U.hasKey(KEYS.groq) then l[#l + 1] = { name = "Groq", url = CFG.groq.url, model = CFG.groq.model, key = KEYS.groq } end
    if U.hasKey(KEYS.gemini) then l[#l + 1] = { name = "Gemini", url = CFG.gemini.url, model = CFG.gemini.model, key = KEYS.gemini, extra = { reasoning_effort = "none" }, minTokens = 200 } end
    if U.hasKey(KEYS.openrouter) then l[#l + 1] = { name = "OpenRouter", url = CFG.openrouter.url, model = CFG.openrouter.model, key = KEYS.openrouter, openrouter = true } end
    if CFG.pollinations.enabled then l[#l + 1] = { name = "Pollinations", url = CFG.pollinations.url, model = CFG.pollinations.model } end
    return l
end
function A.ordered()
    local now = os.clock()
    local ready, cool = {}, {}
    for _, p in ipairs(A.providers()) do
        if A.rate[p.name].coolUntil > now then cool[#cool + 1] = p else ready[#ready + 1] = p end
    end
    table.sort(ready, function(a, b)
        local ra, rb = A.rate[a.name], A.rate[b.name]
        return math.max(ra.nextAt, now) + ra.pen < math.max(rb.nextAt, now) + rb.pen
    end)
    for _, p in ipairs(cool) do ready[#ready + 1] = p end
    return ready
end
function A.slot(name)
    local r = A.rate[name]
    local now = os.clock()
    local at = math.max(now, r.nextAt)
    r.nextAt = at + r.gap
    if at > now then task.wait(at - now) end
end
function A.try(p, rq, messages, maxTokens)
    local r = A.rate[p.name]
    local headers = { ["Content-Type"] = "application/json" }
    if p.key then headers["Authorization"] = "Bearer " .. p.key end
    if p.openrouter then headers["HTTP-Referer"] = "https://www.roblox.com" headers["X-Title"] = "Phantom OS" end
    local lastErr, lastCode = p.name .. ": failed", 0
    for attempt = 1, (p.extra and 2 or 1) do
        local payload = { model = p.model, messages = messages, max_tokens = math.max(maxTokens or 300, p.minTokens or 0), temperature = 0 }
        if p.extra and attempt == 1 then for k, v in pairs(p.extra) do payload[k] = v end end
        local okE, body = pcall(HS.JSONEncode, HS, payload)
        if not okE then return nil, p.name .. ": encode error", 0 end
        A.slot(p.name)
        local ok, res = pcall(rq, { Url = p.url, Method = "POST", Headers = headers, Body = body })
        if ok and type(res) == "table" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            local raw = res.Body or ""
            local okD, data = pcall(HS.JSONDecode, HS, raw)
            local content, err
            if okD and type(data) == "table" then
                local ch = data.choices and data.choices[1]
                if ch and ch.message and type(ch.message.content) == "string" then content = ch.message.content
                elseif data.error then err = type(data.error) == "table" and (data.error.message or "api error") or tostring(data.error) end
            end
            if not content and not err and code >= 200 and code < 300 and type(raw) == "string" and raw ~= "" then content = raw end
            if content and content ~= "" then r.gap = math.max(r.min, r.gap * 0.92) return content, nil, code end
            lastCode = code
            lastErr = p.name .. ": " .. tostring(err or ("HTTP " .. tostring(code)))
            if code == 429 then
                r.gap = math.min(r.max, r.gap * 2)
                r.coolUntil = os.clock() + 30
                return nil, p.name .. ": rate limited (429)", code
            elseif code == 401 or code == 403 then
                r.coolUntil = os.clock() + 300
                return nil, p.name .. ": key rejected (" .. code .. ")", code
            end
            if not (code == 400 and p.extra and attempt == 1) then break end
        else
            r.coolUntil = os.clock() + 10
            return nil, p.name .. ": request failed", 0
        end
    end
    return nil, lastErr, lastCode
end
function A.call(messages, maxTokens)
    local rq = N.requester()
    if not rq then return nil, nil, "Executor has no HTTP request function.", 0 end
    local order = A.ordered()
    if #order == 0 then return nil, nil, "No AI provider enabled.", 0 end
    local lastErr, lastCode = "unknown error", 0
    S.ai.calls += 1
    for _, p in ipairs(order) do
        local t0 = os.clock()
        local content, err, code = A.try(p, rq, messages, maxTokens)
        if content then
            S.ai.ok += 1
            local st = S.ai.prov[p.name] or { n = 0, ms = 0 }
            st.n += 1
            st.ms += (os.clock() - t0) * 1000
            S.ai.prov[p.name] = st
            return content, p.name, nil, code
        end
        lastErr, lastCode = err or lastErr, code or lastCode
    end
    return nil, nil, lastErr, lastCode
end
A.SYSTEM = "Roblox chat moderator. Players write English/Hindi/Hinglish. Abbreviations or misspellings can hide Hindi abuse "
