local function dotFormatName(nameStr)
    local chars = {}
    for i = 1, #nameStr do
        local c = nameStr:sub(i, i)
        if c ~= " " then
            table.insert(chars, c)
        end
    end
    return table.concat(chars, ".")
end

local function applyAntiTag(nameStr)
    local upperName = string.upper(nameStr)
    if antiTag or (autoFallbackEnabled and tagMemoryCache[upperName]) then
        return dotFormatName(upperName)
    end
    return upperName
end

