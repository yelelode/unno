function H.record(p)
    local k = U.key(p)
    local r = S.strikes[k]
    if not r then
        local inst = typeof(p) == "Instance"
        r = {
            key = k, player = inst and p or nil, name = inst and p.Name or tostring(p), display = inst and p.DisplayName or tostring(p),
            userId = inst and p.UserId or 0, age = inst and p.AccountAge or 0, count = 0, tags = 0, reports = 0, maxSev = 0,
            nextAlert = CFG.strikeAlert, incidents = {},
        }
        S.strikes[k] = r
    end
    return r
end
function H.sorted()
    local l = {}
    for _, d in pairs(S.strikes) do l[#l + 1] = d end
    table.sort(l, function(a, b)
        if a.count ~= b.count then return a.count > b.count end
        if a.tags ~= b.tags then return a.tags > b.tags end
        return a.name < b.name
    end)
    return l
end
function H.schedule()
    if S.dirty then return end
    S.dirty = true
    task.delay(0.5, H.refreshAll)
end
function H.refreshAll()
    S.dirty = false
    if not S.alive then return end
    V.refreshStrikes()
    V.refreshReports()
end
function H.addTag(player)
    local rec = H.record(player)
    rec.tags += 1
    S.tags += 1
    H.schedule()
    V.status()
end
function H.register(player, name, msg, cats, sev, blocked, tagged, targeted)
    local rec = H.record(player)
    rec.count += 1
    if tagged then rec.tags += 1 S.tags += 1 end
    if sev > rec.maxSev then rec.maxSev = sev end
    local inc = { time = os.date("%H:%M:%S"), msg = msg:sub(1, 200), cat = cats[1] or "harass", sev = sev, targeted = targeted or false }
    table.insert(rec.incidents, inc)
    if #rec.incidents > 20 then table.remove(rec.incidents, 1) end
    S.flagged += 1
    S.lastFlagged = { name = name, msg = msg, cats = cats, sev = sev }
    for _, c in ipairs(cats) do S.catCount[c] = (S.catCount[c] or 0) + 1 end
    local m = math.floor(os.time() / 60)
    S.timeline[m] = (S.timeline[m] or 0) + 1
    if not blocked then
        if rec.count >= rec.nextAlert then
            rec.nextAlert = rec.count + 3
            U.notify("🚨 REPEAT OFFENDER: " .. name .. " (" .. rec.count .. " strikes)")
            if CFG.autoCopy then U.copy(R.pack(R.infoRec(rec))) end
        elseif sev >= 5 then
            U.notify("🚨 SEVERE: " .. name .. " — " .. table.concat(cats, "+"))
            if CFG.autoCopy then U.copy(R.pack(R.infoRec(rec))) end
        elseif sev >= 4 then
            U.toast(name .. " flagged (SEV " .. sev .. "): " .. table.concat(cats, "+"), T.RED)
        end
    end
    H.schedule()
    V.status()
    return inc
end
function H.undo(player, inc)
    local rec = S.strikes[U.key(player)]
    if not rec or not inc then return end
    for i, x in ipairs(rec.incidents) do if x == inc then table.remove(rec.incidents, i) break end end
    rec.count = math.max(0, rec.count - 1)
    local m = 0
    for _, x in ipairs(rec.incidents) do if x.sev > m then m = x.sev end end
    rec.maxSev = m
    if rec.count == 0 and rec.tags == 0 then S.strikes[U.key(player)] = nil end
    S.flagged = math.max(0, S.flagged - 1)
    H.schedule()
    V.status()
end
function H.trusted(player)
    if typeof(player) ~= "Instance" or player == LP then return false end
