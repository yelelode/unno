local pushOrderBookPacket = nil

local function buildFinalMsg()
    local currentTarget = targetList[targetIndex]
    if not currentTarget or currentTarget == "" then
        currentTarget = "TARGET 1"
    end
    targetIndex = (targetIndex % #targetList) + 1
    lastTargetUsed = string.upper(currentTarget)

    local msg = buildRawMsgForTarget(currentTarget)
    local packetState = "CLEAN"

    if autoFallbackEnabled then
        local attempts = 0
        while attempts < 3 and predictMessageTagged(msg) do
            attempts += 1
            filterStats.rerolled += 1
            tagMemoryCache[lastTargetUsed] = true
            updateFallbackMonitor("ᴛᴀɢ ᴅᴇᴛᴇᴄᴛᴇᴅ -> ʀᴇ-ʀᴏʟʟɪɴɢ...")
            msg = buildRawMsgForTarget(currentTarget)
        end

        if predictMessageTagged(msg) then
            filterStats.fallbackUsed += 1
            tagMemoryCache[lastTargetUsed] = true
            local safeDotted = dotFormatName(lastTargetUsed)
            msg = string.format("★ %s // %s // ᴇᴍᴩ ᴏɴ ᴛᴏᴩ ★", safeDotted, getRandomWord())
            packetState = "FALLBACK"
            updateFallbackMonitor("ꜱᴀꜰᴇ ꜰᴀʟʟʙᴀᴄᴋ ᴅᴇᴩʟᴏʏᴇᴅ ✓")
        else
            filterStats.passed += 1
            packetState = (attempts > 0) and "REROLLED" or "CLEAN"
            updateFallbackMonitor("0 ᴛᴀɢꜱ • ᴄʟᴇᴀɴ ᴅᴇʟɪᴠᴇʀʏ ✓")
        end
    end

    totalBytesSent += #msg

    if pushOrderBookPacket then
        pushOrderBookPacket(lastTargetUsed, #msg, packetState)
    end

    return msg
end

