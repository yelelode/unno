function R.reasonText(cats)
    local p = {}
    for _, c in ipairs(cats) do p[#p + 1] = R.REASONS[c] or c end
    return table.concat(p, " ")
end
function R.game() return "Game PlaceId: " .. tostring(game.PlaceId) .. " | JobId: " .. tostring(game.JobId) end
function R.cut(s, n)
    if #s <= n then return s end
    local c = n
    while c > 0 do
        local b = s:byte(c + 1)
        if b and b >= 128 and b < 192 then c -= 1 else break end
    end
    return s:sub(1, c)
end
function R.logFor(key, name, uid)
    local log = S.chatLog[key] or {}
    local lines = { "CHAT LOG — " .. tostring(name) .. " (UserId " .. tostring(uid) .. ") | " .. R.game() }
    if #log == 0 then lines[#lines + 1] = "(no messages captured)" end
    for _, e in ipairs(log) do
        local line = "[" .. e.time .. "] " .. e.text .. ((e.dups and e.dups > 1) and ("  (×" .. e.dups .. " repeated)") or "")
        if e.taggedOnly then line = line .. "   ← TAGGED by Roblox (original hidden)"
        elseif e.tagged then line = line .. "   ← TAGGED by Roblox as: " .. tostring(e.tagText) end
        lines[#lines + 1] = line
    end
    return table.concat(lines, "\n")
end
function R.tiny(i)
    local m = #i.msg > 70 and (R.cut(i.msg, 70) .. "…") or i.msg
    local s = "\"" .. m .. "\" at " .. i.time .. "."
    if (i.dupN or 0) >= 3 then s = s .. " Repeated x" .. i.dupN .. "." end
    if i.evasion and #i.evasion > 0 then s = s .. " Filter avoidance used." end
    if i.targeted then s = s .. " Aimed at a player." end
    if i.count and i.count > 1 then s = s .. " Flagged x" .. i.count .. "." end
    return R.cut(s, 190)
end
function R.build(i, max)
    max = math.min(max or CFG.reportMax, 1000)
    local p = R.POLICY[i.cat] or R.POLICY.profanity
    local spamCat = (i.cat == "spam")
    local jid = tostring(game.JobId)
    if jid == "" then jid = "n/a" end
    local REQ = "Request: please review the chat logs for this server and time and apply appropriate chat restrictions to this account. Evidence available on request."

    local function make(msgLen)
        local m = i.msg
        if #m > msgLen then m = R.cut(m, msgLen) .. "…" end
        local rep = ""
        if (i.dupN or 0) == 2 then rep = " [sent twice]" end
        local fixed = {
            "CHAT REPORT — " .. i.name .. " (UserID " .. tostring(i.userId) .. ")",
            "Policy: Roblox Community Standards – " .. p[1] .. ".",
            "Violation: the user " .. p[2] .. ".",
            "Message: \"" .. m .. "\"" .. rep,
        }
        local where = "Where/when: PlaceId " .. tostring(game.PlaceId) .. ", server " .. jid .. ", " .. i.time .. "."
        local opt = {}
        if i.evasion and #i.evasion > 0 then
            opt[#opt + 1] = { "Filter avoidance: " .. table.concat(i.evasion, "; ") .. " — an apparent deliberate attempt to bypass the chat filter.", spamCat and 2 or 1 }
        end
        local sp = {}
        if (i.dupN or 0) >= 3 then
            sp[#sp + 1] = "identical message repeated ×" .. i.dupN .. ((i.dupSecs and i.dupSecs >= 1) and (" in " .. math.floor(i.dupSecs) .. "s") or "")
        end
        if (i.peak or 0) >= 6 then sp[#sp + 1] = "peak of " .. i.peak .. " messages in 10 seconds" end
        if (i.wave or 0) >= 3 then sp[#sp + 1] = "same text posted by " .. i.wave .. " accounts at once (coordinated)" end
        if #sp > 0 then opt[#opt + 1] = { "Spam pattern: " .. table.concat(sp, "; ") .. ".", spamCat and 1 or 3 } end
        if i.targeted then opt[#opt + 1] = { "The message was directed at another player.", 4 } end
        if i.tagged then opt[#opt + 1] = { "Roblox's own chat filter also tagged this user's message (" .. tostring(i.tags or 1) .. " tag).", 5 } end
        if (i.count or 0) > 1 then opt[#opt + 1] = { "Repeat behaviour: " .. i.count .. " flagged messages from this account this session.", 6 } end
        opt[#opt + 1] = { "Why: " .. p[3], 7 }
        table.sort(opt, function(a, b) return a[2] < b[2] end)
        return fixed, where, opt
    end

    local text, msgLen = "", 170
    for _ = 1, 6 do
        local fixed, where, opt = make(msgLen)
        local keep = {}
        for _, o in ipairs(opt) do keep[#keep + 1] = o end
        local function join()
            local lines = {}
            for _, l in ipairs(fixed) do lines[#lines + 1] = l end
            for _, o in ipairs(keep) do lines[#lines + 1] = o[1] end
            lines[#lines + 1] = where
            lines[#lines + 1] = REQ
            return table.concat(lines, "\n")
        end
        text = join()
        while #text > max and #keep > 0 do
            table.remove(keep)
            text = join()
        end
        if #text <= max then break end
        msgLen = math.max(24, math.floor(msgLen / 2))
    end
    return R.cut(text, max)
end
function R.spamFacts(key)
    local ps = S.pstats[key] or {}
    return { dupN = ps.dupMax, dupSecs = ps.dupSecs, peak = ps.peak, wave = ps.wave, msgs = ps.msgs }
end
function R.info(player, name, msg, sev, cats, o)
    o = o or {}
    local inst = typeof(player) == "Instance"
    local key = U.key(player)
    local rec = S.strikes[key]
    local sf = R.spamFacts(key)
    return {
        name = name, display = inst and player.DisplayName or name, userId = inst and player.UserId or 0,
        age = inst and player.AccountAge or 0, key = key, msg = msg, sev = sev, cats = cats, cat = cats[1] or "profanity",
        time = o.time or os.date("%H:%M:%S"), tagged = o.tagged, tagText = o.tagText, targeted = o.targeted, extra = o.extra,
        evasion = o.evasion or {}, count = rec and rec.count or 1, tags = rec and rec.tags or 0,
        dupN = sf.dupN, dupSecs = sf.dupSecs, peak = sf.peak, wave = sf.wave, msgs = sf.msgs,
    }
end
function R.infoRec(rec)
    local best
    for _, x in ipairs(rec.incidents) do if not best or x.sev >= best.sev then best = x end end
    best = best or { msg = "(see chat log)", sev = rec.maxSev, cat = "profanity", time = os.date("%H:%M:%S") }
    local sf = R.spamFacts(rec.key)
    return {
        name = rec.name, display = rec.display, userId = rec.userId, age = rec.age, key = rec.key, msg = best.msg,
        sev = best.sev, cats = { best.cat }, cat = best.cat, time = best.time, tagged = rec.tags > 0,
        targeted = best.targeted, evasion = best.evasion or {}, count = rec.count, tags = rec.tags,
        dupN = sf.dupN, dupSecs = sf.dupSecs, peak = sf.peak, wave = sf.wave, msgs = sf.msgs,
    }
end
function R.evidence(rec)
    local sf = R.spamFacts(rec.key)
    local L = {
        "PHANTOM OS EVIDENCE REPORT", R.game(),
        "Reported user: " .. rec.name .. " (Display: " .. rec.display .. ", UserId: " .. tostring(rec.userId) .. ", Account age: " .. tostring(rec.age) .. " days)",
        "Total strikes: " .. rec.count .. " | Roblox-filter tags: " .. rec.tags .. " | Spam repeats: " .. (rec.spam or 0) .. " | Highest severity: " .. rec.maxSev .. "/5",
        "Spam facts: max identical repeats " .. tostring(sf.dupN or 0) .. " | peak " .. tostring(sf.peak or 0) .. " msgs/10s | wave size " .. tostring(sf.wave or 0),
        "Incidents (latest 10):",
    }
    local seen, cl = {}, {}
    for i = math.max(1, #rec.incidents - 9), #rec.incidents do
        local x = rec.incidents[i]
        L[#L + 1] = string.format("[%s] (%s, SEV %d) \"%s\"%s", x.time, x.cat, x.sev, x.msg, (x.evasion and #x.evasion > 0) and ("  [avoidance: " .. table.concat(x.evasion, "; ") .. "]") or "")
    end
    for _, x in ipairs(rec.incidents) do if not seen[x.cat] then seen[x.cat] = true cl[#cl + 1] = x.cat end end
    L[#L + 1] = "Applicable rules: " .. R.reasonText(cl)
    L[#L + 1] = ""
    L[#L + 1] = R.logFor(rec.key, rec.name, rec.userId)
    return table.concat(L, "\n")
end
function R.risk(d)
    local now, w = os.time(), 0
    for _, x in ipairs(d.incidents) do
        local age = now - (x.t or now)
        w += (age < 900 and 1) or (age < 2700 and 0.6) or 0.3
    end
    w += math.max(0, d.count - #d.incidents) * 0.3
    local r = w * 12 + d.tags * 10 + d.maxSev * 6 + math.min(25, (d.spam or 0) / 4)
    if d.age and d.age < CFG.newAcct then r += 8 end
    local rp = S.rep[tostring(d.userId)]
    if rp then r += math.min(12, math.max(0, (rp.n or 0) - d.count) * 1.5) end
    return math.min(100, math.floor(r + 0.5))
end
function R.summary()
    local L = {
        "PHANTOM OS SESSION SUMMARY", R.game(),
        "Duration: " .. math.floor((os.time() - S.started) / 60) .. " min | Scanned: " .. S.scanned .. " | Flagged: " .. S.flagged
            .. " | Roblox tags: " .. S.tags .. " | Reports sent: " .. S.reportsSent
            .. " | Duplicates merged: " .. S.dupSuppressed .. " | Quarantined msgs: " .. S.quarCount, "", "By category:",
    }
    for c, n in pairs(S.catCount) do L[#L + 1] = "  - " .. c .. ": " .. n end
    L[#L + 1] = ""
    L[#L + 1] = "Offenders:"
    for _, d in ipairs(H.sorted()) do
        L[#L + 1] = string.format("  - %s (UserId %s): %d strikes, %d tags, max SEV %d, risk %d%%", d.name, tostring(d.userId), d.count, d.tags, d.maxSev, R.risk(d))
    end
    return table.concat(L, "\n")
end
function R.dump()
    local parts = { R.summary(), "" }
    for _, d in ipairs(H.sorted()) do parts[#parts + 1] = R.evidence(d) parts[#parts + 1] = "" end
    return table.concat(parts, "\n")
end
function R.saveFile()
    if not writefile then return false end
    local name = "PhantomOS_log_" .. os.time() .. ".txt"
    local ok = pcall(writefile, name, R.dump())
    return ok, name
end
function R.log(info, status)
    table.insert(S.reportLog, 1, { time = os.date("%H:%M:%S"), name = info.name, cat = info.cat, status = status, msg = info.msg:sub(1, 40) })
    if #S.reportLog > 40 then table.remove(S.reportLog) end
    if V.refreshHistory then V.refreshHistory() end
end
function R.submit(info, player)
    local reason = CFG.reportReason[info.cat]
    if not reason then return "noreason" end
    if typeof(player) ~= "Instance" or not player.Parent then return "gone" end
    if player == LP then return "self" end
    local ok = pcall(function() Players:ReportAbuse(player, reason, R.build(info, math.min(CFG.reportMax, CFG.directMax))) end)
    if not ok then ok = pcall(function() Players:ReportAbuse(player, reason, R.tiny(info)) end) end
    return ok and "sent" or "failed"
end
R.MSG = {
    noreason = "No matching Roblox reason for this category — report text copied, report manually.",
    gone = "Player left the server — report text copied.",
    self = "You can't report yourself.",
    failed = "Direct report blocked on this executor — report text copied. Paste it in Roblox's report menu.",
}
function R.mark(player)
    local rec = typeof(player) == "Instance" and S.strikes[U.key(player)] or nil
    if rec then rec.reports = (rec.reports or 0) + 1 H.schedule() end
    S.reportsSent += 1
end
function R.bind(btn, getInfo, getPlayer, onDone)
    local armed, token, done = false, 0, false
    btn.Activated:Connect(function()
        if done then return end
        if not armed then
            armed = true
            token += 1
            local my = token
            U.setBtn(btn, "⚠ Confirm?", T.AMBER)
            task.delay(3, function()
                if S.alive and armed and my == token and btn.Parent then armed = false U.setBtn(btn, "⚡ Report", T.RED) end
            end)
            return
        end
        armed = false
        token += 1
        local wait = CFG.reportCooldown - (os.clock() - S.lastReportAt)
        if wait > 0 then U.toast("Cooldown: " .. math.ceil(wait) .. "s", T.AMBER) U.setBtn(btn, "⚡ Report", T.RED) return end
        local info = getInfo()
        local status = R.submit(info, getPlayer())
        if status == "sent" then
            S.lastReportAt = os.clock()
            done = true
            U.setBtn(btn, "✅ Reported", T.GREEN)
            U.toast("✅ Report sent: " .. info.name, T.GREEN)
            R.log(info, "sent")
