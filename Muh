local function getServerPingMs()
    local ping = 65
    pcall(function()
        local net = Stats:FindFirstChild("Network")
        local item = net and net:FindFirstChild("ServerStatsItem")
        local dataPing = item and item:FindFirstChild("Data Ping")
        if dataPing then
            ping = math.floor(dataPing:GetValue())
        elseif lp and lp.GetNetworkPing then
            ping = math.floor(lp:GetNetworkPing() * 1000)
        end
    end)
    return math.max(10, ping)
end

local function computeBalancedSafeDelay(pingMs)
    local pingBuffer = math.clamp(pingMs / 1000, 0.04, 0.55)
    local baseSafeInterval = 1.32 + (pingBuffer * 0.85)
    return math.floor(baseSafeInterval * 100 + 0.5) / 100
end

