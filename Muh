                tileJobId.Text   = "#" .. shortJobId
                tileMemory.Text  = string.format("%d MB", memMb)
                tilePackets.Text = string.format("%d SENT", totalSentCount)
                tileUptime.Text  = string.format("%02dm:%02ds", mins, secs)

                if running then
                    engineStatusLabel.Text = "LIVE ACTIVE"
                    engineStatusLabel.TextColor3 = Color3.fromRGB(0, 230, 140)
                    enginePillFrame.BackgroundColor3 = Color3.fromRGB(12, 34, 24)
