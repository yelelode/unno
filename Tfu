-- 1-second tick: sparkline data + hero texts
function V.heroTick()
    local L = V.live
    S.spark[#S.spark + 1] = S.secMsgs
    S.secMsgs = 0
    while #S.spark > 48 do table.remove(S.spark, 1) end
    local key, label, col, ten = H.mood()
    S.tension = ten
    V.heroTarget = col
    V.heroSpeed = ({ calm = 1, heated = 1.6, toxic = 2.3, storm = 3.5 })[key]
    local emoji = H.MOODEMOJI[key]
    if V.subtitle then V.subtitle.Text = "Chat: " .. emoji .. " " .. label .. " • v10" end
    if not L or not L.mood.Parent then return end
    if L.moodKey ~= key then
        L.moodKey = key
        if S.perfNow then L.mood.Text = label
        else
            U.tw(L.mood, { TextTransparency = 1 }, 0.12)
            task.delay(0.13, function()
                if L.mood.Parent then
                    L.mood.Text = label
                    L.mood.TextColor3 = col:Lerp(T.WHITE, 0.4)
                    U.tw(L.mood, { TextTransparency = 0 }, 0.25)
                end
            end)
        end
    end
    local rate = 0
    for i = math.max(1, #S.spark - 9), #S.spark do rate += S.spark[i] end
    L.sub.Text = string.format("%.1f msg/s · %d flagged · %d players", rate / math.max(1, math.min(10, #S.spark)), S.flagged, #Players:GetPlayers())
    if L.chev then L.chev.Text = S.heroOpen and "▾" or "▸" end
end

function V.addEntry(player, name, msg, sev, cats, blocked, doubt, incident, flags, ge)
    if not S.alive or not V.liveScroll or not V.liveScroll.Parent then return nil end
    flags = flags or {}
    S.liveOrder += 1
    local cur, curCats = sev, cats
    local tagged, taggedOnly, tagText = flags.tagged or false, flags.taggedOnly or false, flags.tagText
    local targeted, trusted = flags.targeted or false, flags.trusted or false
    local evasion = flags.evasion or {}
    local stamp, stampFull = os.date("%H:%M"), os.date("%H:%M:%S")
    local extra, noteAI = "", ""
    local checking = (sev == 0 and doubt) and true or false
    local inst = typeof(player) == "Instance"
    local shown = #msg > 160 and (msg:sub(1, 160) .. "...") or msg
    local nameL, textL = name:lower(), msg:lower()

    local card = U.new("Frame", {
        Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.CARD, BorderSizePixel = 0,
        LayoutOrder = S.liveOrder, Visible = H.passes(sev, cats, nameL, textL),
    }, V.liveScroll)
    U.round(card, 11)
    local stroke = U.outline(card, T.WHITE, 1, 0.88)
    U.pad(card, 8, 7, 8, 7)
    U.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)

    local head = U.new("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1 }, card)
    local nx = 0
    if inst and not S.perfNow then U.avatar(head, player.UserId, 20, UDim2.new()) nx = 26 end
    U.label(head, name, 12, T.TXT, Enum.Font.GothamBold, { Position = UDim2.new(0, nx, 0, 0), Size = UDim2.new(1, -nx - 130, 1, 0), TextWrapped = false })
    local timeL = U.label(head, stamp, 9, T.MUTED, Enum.Font.Gotham, { Position = UDim2.new(1, -124, 0, 3), Size = UDim2.new(0, 74, 0, 14), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
    local pill = U.label(head, "", 9, T.WHITE, Enum.Font.GothamBold, {
        Position = UDim2.new(1, -48, 0, 2), Size = UDim2.new(0, 48, 0, 16), BackgroundTransparency = 0, BackgroundColor3 = T.LINE,
        TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Visible = false,
    })
    U.round(pill, 8)
    local msgL = U.label(card, "", 12, T.TXT, Enum.Font.Gotham, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
    local chips = U.label(card, "", 10, T.BLUE, Enum.Font.Gotham, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Visible = false })
    local actions = U.new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 4, Visible = false }, card)

    local function getInfo()
        return R.info(player, name, msg, cur, curCats, { time = stampFull, tagged = tagged, tagText = tagText, targeted = targeted, extra = extra, evasion = evasion })
    end
    local repBtn = U.button(actions, "⚡ Report", T.RED, UDim2.new(0.34, -3, 1, 0), UDim2.new(0, 0, 0, 0), nil, 10)
    R.bind(repBtn, getInfo, function() return player end, function() R.mark(player) end)
    U.button(actions, "📝 Copy", T.PANEL, UDim2.new(0.22, -3, 1, 0), UDim2.new(0.34, 2, 0, 0), function()
        local t = R.build(getInfo())
        U.toast(U.copy(t) and ("📝 Report copied (" .. #t .. "/" .. CFG.reportMax .. ")") or "⚠ No clipboard", T.NEON)
    end, 10)
    U.button(actions, "👁 Ctx", T.PANEL, UDim2.new(0.22, -3, 1, 0), UDim2.new(0.56, 3, 0, 0), function() H.showContext(ge) end, 10)
    U.button(actions, "⋯", T.PANEL, UDim2.new(0.22, -3, 1, 0), UDim2.new(0.78, 4, 0, 0), function() V.preview(getInfo(), player) end, 12)

    local count = 1
    local function render()
        local active = cur > 0 or checking
        local col = checking and T.AMBER or V.sevColor(cur)
        U.tw(stroke, { Color = active and col or T.WHITE, Transparency = active and 0.2 or 0.88 }, 0.3)
        pill.Visible = cur > 0
        pill.Text = "SEV " .. cur
        pill.BackgroundColor3 = V.sevColor(cur)
        timeL.Text = stamp .. (count > 1 and (" ×" .. count) or "")
        msgL.Text = (blocked and "🛡 [Blocked — not sent] " or "") .. shown
        msgL.TextColor3 = cur >= 4 and T.REDT or (cur > 0 and T.AMBT or T.TXT)
        local parts = {}
        if cur > 0 then parts[#parts + 1] = "● " .. table.concat(curCats, ", ") end
        if #evasion > 0 then parts[#parts + 1] = "🕵 avoidance: " .. table.concat(evasion, ", ") end
        if count > 1 then parts[#parts + 1] = "🔁 repeated " .. count .. "×" end
        if tagged then parts[#parts + 1] = taggedOnly and "🏷 Roblox hid the text" or "🏷 Tagged by Roblox" end
        if flags.known then parts[#parts + 1] = "🔁 known offender (" .. flags.known .. " past)" end
        if flags.newAcct then parts[#parts + 1] = "🆕 new account (" .. tostring(flags.age) .. "d)" end
        if flags.watched then parts[#parts + 1] = "⭐ watched" end
        if trusted then parts[#parts + 1] = "👥 trusted (not scanned)" end
        if checking then parts[#parts + 1] = "🟡 AI checking…" end
        if noteAI ~= "" then parts[#parts + 1] = noteAI end
        chips.Text = table.concat(parts, "  •  ")
        chips.Visible = #parts > 0
        actions.Visible = cur > 0 and not blocked
    end
    render()
    U.pop(card, 0)
    if checking and not S.perfNow then
        U.anim(function(t)
            if not card.Parent or not checking then return true end
            stroke.Transparency = 0.3 + math.sin(t * 6) * 0.25
        end)
    end

    local h = {}
    function h.setVerifying()
        if cur > 0 then noteAI = "🟡 AI verifying…" render() end
    end
    function h.bump(n, s2, c2, tg, ev2)
        if not card.Parent then return end
        count, stamp = n, os.date("%H:%M")
        if tg then targeted = true end
        if ev2 and #ev2 > #evasion then evasion = ev2 end
        if s2 > cur and #c2 > 0 then
            cur, curCats = s2, c2
            if player and not blocked and not incident then incident = H.register(player, name, msg, curCats, cur, blocked, false, targeted, evasion) end
            if ge then ge.sev = cur end
            card.Visible = H.passes(cur, curCats, nameL, textL)
        end
        render()
        if not S.perfNow then
            timeL.TextColor3 = T.WHITE
            U.tw(timeL, { TextColor3 = T.MUTED }, 0.5)
        end
    end
    function h.markTagged(tt)
        if not S.alive or not card.Parent then return end
        tagged, tagText, checking = true, tt, false
        if cur == 0 then
            cur, curCats = 3, { "filtered" }
            if player then incident = H.register(player, name, msg, curCats, cur, blocked, true, targeted, evasion) end
        else
            if cur < 3 then
                cur = 3
                if incident then incident.sev = 3 end
                local rec = player and S.strikes[U.key(player)]
                if rec and rec.maxSev < 3 then rec.maxSev = 3 end
            end
            if player then H.addTag(player) end
        end
        if ge then ge.sev = cur end
        extra = "Roblox filter tagged this message as: " .. tostring(tt)
        render()
        card.Visible = true
    end
    function h.applyAI(res)
        if not S.alive or not card.Parent then return end
        local was = checking
        checking = false
        if not res then noteAI = "" render() return end
        if res.violation then
            if cur == 0 then
                cur, curCats = res.severity, { res.category }
                if player and not blocked then incident = H.register(player, name, msg, curCats, cur, blocked, false, targeted, evasion) end
                if ge then ge.sev = cur end
            end
            extra = "AI review confirmed: " .. res.reason
            noteAI = "🤖 ✅ " .. res.reason
        else
            if cur == 0 then
                noteAI = "🤖 ⚪ " .. res.reason
            else
                if cur <= 3 and incident and player and not tagged then H.undo(player, incident) incident = nil end
                extra = "Note: an AI review doubted this: " .. res.reason
                noteAI = "🤖 ❓ likely OK: " .. res.reason
            end
        end
        render()
        if was then card.Visible = H.passes(cur, curCats, nameL, textL) end
    end

    S.liveEntries[#S.liveEntries + 1] = { frame = card, name = nameL, text = textL, info = function() return cur, curCats end }
    local cap = S.perfNow and 15 or 30
    while #S.liveEntries > cap do
        local old = table.remove(S.liveEntries, 1)
        if old and old.frame then old.frame:Destroy() end
    end
    return h
end

