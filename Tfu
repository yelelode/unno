    V.aiSeg = U.segmented(L.ctrl, { "Smart", "Strict", "Off" }, U.cap(S.aiMode), A.setMode, UDim2.new(), UDim2.new(0.44, -3, 1, 0))
    local chip = U.button(L.ctrl, "Show: " .. S.filterMode, T.PANEL, UDim2.new(0.28, -3, 1, 0), UDim2.new(0.44, 1, 0, 0), nil, 10)
    chip.Activated:Connect(function()
        local idx = 1
        for i, f in ipairs(V.FILTERS) do if f == S.filterMode then idx = i end end
        S.filterMode = V.FILTERS[idx % #V.FILTERS + 1]
        U.setBtn(chip, "Show: " .. S.filterMode, S.filterMode == "All" and T.PANEL or T.NEOND)
