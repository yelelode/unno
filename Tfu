-- animated number counter with a little flash
function U.num(lbl, target, fmt)
    fmt = fmt or tostring
    local cur = lbl:GetAttribute("n") or 0
    if cur == target then
        if lbl.Text == "" then lbl.Text = fmt(target) end
        return
    end
    lbl:SetAttribute("n", target)
    if S.perfNow then lbl.Text = fmt(target) return end
    local id = (lbl:GetAttribute("id") or 0) + 1
    lbl:SetAttribute("id", id)
    local up = target > cur
    task.spawn(function()
        for s = 1, 12 do
            if not S.alive or not lbl.Parent or lbl:GetAttribute("id") ~= id then return end
            local f = 1 - (1 - s / 12) ^ 2
            lbl.Text = fmt(math.floor(cur + (target - cur) * f + 0.5))
            task.wait(0.02)
        end
        lbl.Text = fmt(target)
    end)
    if up then
        local base = lbl:GetAttribute("col") or lbl.TextColor3
        lbl:SetAttribute("col", base)
        lbl.TextColor3 = T.WHITE
        U.tw(lbl, { TextColor3 = base }, 0.5)
    end
end
function U.shimmer(parent, period, phase, strength)
    local f = U.new("Frame", { Size = UDim2.new(0.3, 0, 1.6, 0), Position = UDim2.new(-0.4, 0, -0.3, 0), BackgroundColor3 = T.WHITE, BackgroundTransparency = 0, BorderSizePixel = 0, Rotation = 18, ZIndex = 5 }, parent)
    U.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, strength or 0.88), NumberSequenceKeypoint.new(1, 1) }) }, f)
    U.anim(function(t)
        if not f.Parent then return true end
        local p = ((t / period) + (phase or 0)) % 1.6
        f.Position = UDim2.new(p - 0.4, 0, -0.3, 0)
    end)
    return f
end
function U.draggable(handle, target, onTap)
    local dragging, dInput, dStart, sPos, moved = false, nil, nil, nil, false
    U.trackUI(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dStart, sPos, moved = true, input.Position, target.Position, false
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if c then c:Disconnect() end
                    if onTap and not moved then onTap() end
                end
            end)
        end
    end)
    U.trackUI(handle.InputChanged, function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dInput = input end
    end)
    U.trackUI(UIS.InputChanged, function(input)
        if dragging and input == dInput and dStart and sPos then
            local d = input.Position - dStart
            if d.Magnitude > 8 then moved = true end
            if moved or not onTap then
                U.tw(target, { Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y) }, 0.07)
            end
        end
    end)
end
-- segmented control with a sliding pill
function U.segmented(parent, options, initial, onChange, pos, size)
    local f = U.new("Frame", { Position = pos, Size = size, BackgroundColor3 = T.PANEL, BorderSizePixel = 0 }, parent)
    U.round(f, 8)
    local n = #options
    local pill = U.new("Frame", { Size = UDim2.new(1 / n, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = T.NEOND, BorderSizePixel = 0 }, f)
    U.round(pill, 6)
    U.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.3) }), Rotation = 90 }, pill)
    local btns, obj = {}, {}
    local function paint(v, anim)
        for i, o in ipairs(options) do
            btns[o].TextColor3 = (o == v) and T.WHITE or T.MUTED
            if o == v then
                local p = UDim2.new((i - 1) / n, 2, 0, 2)
                if anim then U.tw(pill, { Position = p }, 0.26, Enum.EasingStyle.Back) else pill.Position = p end
            end
        end
    end
    for i, o in ipairs(options) do
        local b = U.new("TextButton", {
            Position = UDim2.new((i - 1) / n, 0, 0, 0), Size = UDim2.new(1 / n, 0, 1, 0), BackgroundTransparency = 1,
            Text = o, TextSize = 10, Font = Enum.Font.GothamBold, TextColor3 = T.MUTED, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 2,
        }, f)
        btns[o] = b
        b.Activated:Connect(function()
            paint(o, true)
            if onChange then onChange(o) end
        end)
    end
    function obj.set(v) paint(v, true) end
    obj.frame = f
    paint(initial, false)
    return obj
end
function U.toggle(parent, text, initial, onChange, order)
    local row = U.new("Frame", { Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = T.CARD, BorderSizePixel = 0, LayoutOrder = order or 0 }, parent)
    U.round(row, 9)
    U.label(row, text, 12, T.TXT, Enum.Font.GothamMedium, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -66, 1, 0), TextWrapped = false })
    local sw = U.new("TextButton", {
        Text = "", Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = T.LINE, AutoButtonColor = false, BorderSizePixel = 0,
    }, row)
    U.round(sw, 10)
    local knob = U.new("Frame", { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = T.WHITE, BorderSizePixel = 0 }, sw)
    U.round(knob, 8)
    local state = initial
    local function paint(anim)
        local pos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        if anim then
            U.tw(knob, { Size = UDim2.new(0, 22, 0, 16) }, 0.08)
            task.delay(0.08, function()
                if knob.Parent then U.tw(knob, { Size = UDim2.new(0, 16, 0, 16), Position = pos }, 0.2, Enum.EasingStyle.Back) end
            end)
            if state then U.tw(knob, { Position = UDim2.new(1, -24, 0.5, -8) }, 0.08) end
        else
            knob.Position = pos
        end
        U.tw(sw, { BackgroundColor3 = state and T.NEOND or T.LINE }, 0.2)
    end
    paint(false)
    sw.Activated:Connect(function()
        state = not state
        paint(true)
        onChange(state)
    end)
    return { set = function(v) state = v paint(true) end }
end
