function N.requester()
    return (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
end
function N.get(url)
    local rq = N.requester()
    if rq then
        local ok, res = pcall(rq, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and res.Body ~= "" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            if code >= 200 and code < 300 then return res.Body end
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and body ~= "" then return body end
    return nil
end
function N.loadRemote(force)
    local rc = CFG.remote
    if not rc.enabled then D.rstat.status = "off" return end
    D.rstat.status = "loading..."
    if not force and isfile and readfile then
        local ok, d = pcall(function()
            if isfile(rc.cache) then return HS:JSONDecode(readfile(rc.cache)) end
        end)
        if ok and type(d) == "table" and type(d.t) == "number" and type(d.words) == "table" and os.time() - d.t < rc.hours * 3600 then
            for _, w in ipairs(d.words) do D.remote[w] = true end
            for _, ph in ipairs(d.phrases or {}) do D.rphr[#D.rphr + 1] = ph end
            D.rstat.words, D.rstat.phrases, D.rstat.status = #d.words, #D.rphr, "cached"
            return
        end
    end
    local words, phrases, n, okAny = {}, {}, 0, false
    for _, url in ipairs(rc.words) do
        local body = N.get(url)
        if body then
            okAny = true
            for line in body:gmatch("[^\r\n]+") do
                local w = line:lower():gsub("^%s+", ""):gsub("%s+$", "")
                if w:match("^%a+$") and #w >= 4 and #w <= 14 and not D.STOP[w] and not D.builtin[w] then
                    local k = D.c2(w)
                    if not D.remote[k] and n < 3500 then D.remote[k] = true words[#words + 1] = k n += 1 end
                end
            end
        end
    end
    for _, url in ipairs(rc.phrases) do
        local body = N.get(url)
        if body then
            okAny = true
            for line in body:gmatch("[^\r\n]+") do
                local ph = D.fold(line):lower():gsub("^%s+", ""):gsub("%s+$", "")
                if #ph >= 6 and #ph <= 60 and #phrases < 300 then phrases[#phrases + 1] = ph D.rphr[#D.rphr + 1] = ph end
            end
        end
    end
    D.rstat.words, D.rstat.phrases = n, #D.rphr
    D.rstat.status = okAny and "downloaded" or "offline (no list fetched)"
    if okAny and writefile then
        pcall(function() writefile(rc.cache, HS:JSONEncode({ t = os.time(), words = words, phrases = phrases })) end)
    end
end

