handleCommand = function(text)
    local cmd, arg = text:match("^/(%a+)%s*(.-)%s*$")
    cmd = (cmd or ""):lower()
    arg = (arg or ""):lower()
    arg = arg:gsub("[^%a]", "")

    if cmd == "add" and #arg >= 2 then
        custom[arg] = { cat = "profanity", sev = 3 }
        addExact(arg, "profanity", 3, nil, false)
        whitelist[arg] = nil
        markSave()
        addBubble("sys", "Added '" .. arg .. "' to the bad-word list.")
    elseif cmd == "white" and #arg >= 2 then
        whitelist[arg] = true
        custom[arg] = nil
        learned[arg] = nil
        remoteSet[arg] = nil
        if not builtin[c2(arg)] then
            exactSet[c2(arg)] = nil
            exactSet[c1(arg)] = nil
        end
        markSave()
        addBubble("sys", "'" .. arg .. "' is now ignored (whitelisted).")
    elseif cmd == "stats" then
        addBubble("sys", "Flagged: " .. flaggedCount .. " | Offenders: " .. countKeys(strikes) .. " | Roblox tags: " .. tagTotal
            .. " | Learned: " .. countKeys(learned) .. " | Custom: " .. countKeys(custom)
            .. " | Lists: " .. remoteStats.words .. " words / " .. remoteStats.phrases .. " phrases (" .. remoteStats.status .. ")"
            .. " | Providers: " .. providerNames() .. " | last: " .. aiLast)
    elseif cmd == "refresh" then
        addBubble("sys", "Re-downloading internet lists…")
        task.spawn(function()
            remoteSet, remotePhrases = {}, {}
            pcall(loadRemote, true)
            if alive then
                addBubble("sys", "Lists: " .. remoteStats.words .. " words / " .. remoteStats.phrases .. " phrases (" .. remoteStats.status .. ")")
            end
        end)
    elseif cmd == "reset" then
        strikes, chatLog = {}, {}
        flaggedCount, tagTotal, lastFlagged = 0, 0, nil
        refreshAll()
        updateStatus()
        addBubble("sys", "Strikes and logs cleared.")
    else
        addBubble("sys", "Commands: /add <word> • /white <word> • /stats • /refresh • /reset")
    end
end

local convo = {}
local aiBusy = false

local function sendChat(overrideText, shownText)
    if aiBusy or not alive then
        return
    end
    local text = overrideText or (aiInput.Text or ""):match("^%s*(.-)%s*$")
    if not text or text == "" then
        return
    end
    if not overrideText then
        aiInput.Text = ""
        if text:sub(1, 1) == "/" then
            handleCommand(text)
            return
        end
    end
    addBubble("user", shownText or text)
    table.insert(convo, { role = "user", content = text })

    aiBusy = true
    setBtn(sendBtn, "…")
    local thinking = addBubble("ai", "thinking…")

    task.spawn(function()
        local messages = {
            { role = "system", content = "You are a concise assistant inside a Roblox moderation tool that helps keep chats safe and kind. Keep answers short." },
        }
        for i = math.max(1, #convo - 9), #convo do
            table.insert(messages, convo[i])
        end
        local reply, prov, err = callAI(messages, 300)
        if reply then
            table.insert(convo, { role = "assistant", content = reply })
            aiLast = prov or aiLast
            reply = reply .. "\n(" .. tostring(prov) .. ")"
        else
            reply = "Error: " .. tostring(err)
        end
        if alive then
            if thinking and thinking.Parent then
                thinking.Text = "AI  " .. reply
            else
                addBubble("ai", reply)
            end
            setBtn(sendBtn, "Send")
            updateStatus()
        end
        aiBusy = false
    end)
end

