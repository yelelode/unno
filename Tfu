-- ============================== UI TOOLKIT ==============================
local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function round(inst, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, inst)
end

local function outline(inst, color, th, tr)
    return new("UIStroke", {
        Color = color or Th.LINE, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function pad(inst, l, t, r, b)
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
    }, inst)
end

local function tw(inst, props, t, style)
    pcall(function()
        TweenService:Create(inst, TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
    end)
end

local function label(parent, text, size, color, font, props)
    local l = new("TextLabel", {
        BackgroundTransparency = 1, Text = text, TextSize = size or 12, TextColor3 = color or Th.TXT,
        Font = font or Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, RichText = false,
    }, parent)
    if props then
        for k, v in pairs(props) do
            l[k] = v
        end
    end
    return l
end

local function attachFx(btn)
    btn.AutoButtonColor = false
    btn:SetAttribute("base", btn.BackgroundColor3)
    local function base()
        return btn:GetAttribute("base") or btn.BackgroundColor3
    end
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            tw(btn, { BackgroundColor3 = base():Lerp(Th.WHITE, 0.2) }, 0.06)
        elseif i.UserInputType == Enum.UserInputType.MouseMovement then
            tw(btn, { BackgroundColor3 = base():Lerp(Th.WHITE, 0.08) }, 0.1)
        end
    end)
    btn.InputEnded:Connect(function()
        tw(btn, { BackgroundColor3 = base() }, 0.12)
    end)
end

local function setBtn(btn, text, color)
    if text then btn.Text = text end
    if color then
        btn:SetAttribute("base", color)
        tw(btn, { BackgroundColor3 = color }, 0.12)
    end
end

local function button(parent, text, color, size, pos, onClick, textSize)
    local b = new("TextButton", {
        Text = text, BackgroundColor3 = color, TextColor3 = Th.TXT, Font = Enum.Font.GothamBold,
        TextSize = textSize or 11, Size = size, Position = pos or UDim2.new(), BorderSizePixel = 0,
    }, parent)
    round(b, 7)
    attachFx(b)
    if onClick then
        b.Activated:Connect(onClick)
    end
    return b
end

local function makeScroll(parent, pos, size)
    local sf = new("ScrollingFrame", {
        Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = Th.NEON, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
    }, parent)
    new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
    pad(sf, 0, 0, 5, 4)
    return sf
end

local function autoScroll(sf)
    track(sf:GetPropertyChangedSignal("AbsoluteCanvasSize"), function()
        sf.CanvasPosition = Vector2.new(0, math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y))
    end)
end

local function segmented(parent, options, initial, onChange, pos, size)
    local f = new("Frame", { Position = pos, Size = size, BackgroundColor3 = Th.PANEL, BorderSizePixel = 0 }, parent)
    round(f, 7)
    outline(f, Th.LINE, 1, 0.3)
    local btns, obj = {}, {}
    local function paint(v)
        for _, o in ipairs(options) do
            local act = (o == v)
            btns[o].BackgroundColor3 = act and Th.NEON_DARK or Th.PANEL
            btns[o].TextColor3 = act and Th.WHITE or Th.MUTED
        end
    end
    for i, o in ipairs(options) do
        local b = new("TextButton", {
            Position = UDim2.new((i - 1) / #options, 2, 0, 2), Size = UDim2.new(1 / #options, -4, 1, -4),
            BackgroundColor3 = Th.PANEL, Text = o, TextSize = 10, Font = Enum.Font.GothamBold,
            TextColor3 = Th.MUTED, AutoButtonColor = false, BorderSizePixel = 0,
        }, f)
        round(b, 5)
        btns[o] = b
        b.Activated:Connect(function()
            paint(o)
            if onChange then onChange(o) end
        end)
    end
    function obj.set(v) paint(v) end
    obj.frame = f
    paint(initial)
    return obj
end

local function toggleRow(parent, text, initial, onChange, order)
    local row = new("Frame", { Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = Th.CARD, BorderSizePixel = 0, LayoutOrder = order or 0 }, parent)
    round(row, 8)
    label(row, text, 12, Th.TXT, Enum.Font.GothamMedium, { Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -66, 1, 0), TextWrapped = false })
    local sw = new("TextButton", {
        Text = "", Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = Th.LINE, AutoButtonColor = false, BorderSizePixel = 0,
    }, row)
    round(sw, 10)
    local knob = new("Frame", { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Th.WHITE, BorderSizePixel = 0 }, sw)
    round(knob, 8)
    local state = initial
    local function paint()
        tw(sw, { BackgroundColor3 = state and Th.NEON_DARK or Th.LINE }, 0.12)
        tw(knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }, 0.12)
    end
    paint()
    sw.Activated:Connect(function()
        state = not state
        paint()
        onChange(state)
    end)
    return { set = function(v) state = v; paint() end }
end

local function segRow(parent, text, options, initial, onChange, order)
