        if not hero.Parent then return true end
        local tgt = V.heroTarget or T.GREEN
        heroCol = heroCol:Lerp(tgt, math.min(1, dt * 4))
        V.heroColor = heroCol
        local sp = V.heroSpeed or 1
        orb.BackgroundColor3 = heroCol
        tint.BackgroundColor3 = heroCol
        local sz = 24 + math.sin(t * 3 * sp) * 1.6
        orb.Size = UDim2.new(0, sz, 0, sz)
        if S.storm then orb.BackgroundTransparency = 0.5 - 0.5 * math.abs(math.sin(t * 9)) else orb.BackgroundTransparency = 0 end
        for _, r in ipairs(L.rings) do
            local p = (t * 0.55 * sp + r.ph) % 1
            local s = 24 + p * 30
            r.f.Size = UDim2.new(0, s, 0, s)
            r.s.Transparency = 0.3 + p * 0.7
            r.s.Color = heroCol
        end
        fr += 1
        if fr % 2 == 0 then
            for i = 1, 24 do
                local v = S.spark[#S.spark - 24 + i] or 0
                local target = math.min(28, 2 + v * 4)
                hs[i] = hs[i] + (target - hs[i]) * math.min(1, dt * 14)
                bars[i].Size = UDim2.new(1 / 24, -1, 0, hs[i])
                bars[i].Position = UDim2.new((i - 1) / 24, 0, 1, -hs[i])
                bars[i].BackgroundColor3 = heroCol
            end
        end
        tens = tens + (S.tension - tens) * math.min(1, dt * 3)
        fill.Size = UDim2.new(math.max(0.02, tens), 0, 1, 0)
        local bright = heroCol:Lerp(T.WHITE, 0.55)
        fillGrad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, heroCol), ColorSequenceKeypoint.new(0.5, bright), ColorSequenceKeypoint.new(1, heroCol) })
        fillGrad.Offset = Vector2.new(((t * 0.7) % 2) - 1, 0)
        L.tenLbl.Text = math.floor(tens * 100 + 0.5) .. "%"
        local calmOn = S.calmUntil > os.clock()
        L.calmBtn.BackgroundColor3 = calmOn and T.BLUE or T.PANEL
    end)

    -- stat cards
    L.strip = U.new("Frame", { Size = UDim2.new(1, -6, 0, 38), Position = UDim2.new(0, 0, 0, L.heroH + 5), BackgroundTransparency = 1 }, page)
    V.sv = {}
    local function stat(i, cap, key, capKey)
