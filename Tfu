function U.ripple(btn, input)
    if S.perfNow then return end
    local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
    if as.X <= 0 or as.Y <= 0 then return end
    local rx = math.clamp((input.Position.X - ap.X) / as.X, 0, 1)
    local ry = math.clamp((input.Position.Y - ap.Y) / as.Y, 0, 1)
    local d = math.max(as.X, as.Y) * 1.7 / math.max(S.scale, 0.1)
    local r = U.new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(rx, 0, ry, 0), Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = T.WHITE, BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = btn.ZIndex + 1,
    }, btn)
    U.new("UICorner", { CornerRadius = UDim.new(1, 0) }, r)
    U.tw(r, { Size = UDim2.new(0, d, 0, d), BackgroundTransparency = 1 }, 0.5)
    task.delay(0.55, function() r:Destroy() end)
end
function U.fx(btn)
    btn.AutoButtonColor = false
    btn.ClipsDescendants = true
    btn:SetAttribute("base", btn.BackgroundColor3)
    local sc = U.new("UIScale", { Scale = 1 }, btn)
    local function base() return btn:GetAttribute("base") or btn.BackgroundColor3 end
    btn.InputBegan:Connect(function(i)
        local ty = i.UserInputType
        if ty == Enum.UserInputType.Touch or ty == Enum.UserInputType.MouseButton1 then
            U.tw(btn, { BackgroundColor3 = base():Lerp(T.WHITE, 0.2) }, 0.07, Enum.EasingStyle.Quad)
            U.tw(sc, { Scale = 0.96 }, 0.08, Enum.EasingStyle.Quad)
            U.ripple(btn, i)
        elseif ty == Enum.UserInputType.MouseMovement then
            U.tw(btn, { BackgroundColor3 = base():Lerp(T.WHITE, 0.09) }, 0.12)
        end
    end)
    btn.InputEnded:Connect(function()
        U.tw(btn, { BackgroundColor3 = base() }, 0.2)
        U.tw(sc, { Scale = 1 }, 0.32, Enum.EasingStyle.Back)
    end)
end
