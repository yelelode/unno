local HOMO = {
    [0x430] = "a", [0x435] = "e", [0x43E] = "o", [0x440] = "p", [0x441] = "c", [0x445] = "x", [0x443] = "y",
    [0x456] = "i", [0x455] = "s", [0x4CF] = "l",
    [0x410] = "a", [0x415] = "e", [0x41E] = "o", [0x420] = "p", [0x421] = "c", [0x425] = "x", [0x423] = "y",
    [0x406] = "i", [0x405] = "s",
    [0x3BF] = "o", [0x3B1] = "a", [0x3B9] = "i", [0x3BD] = "v",
    [0xE0] = "a", [0xE1] = "a", [0xE2] = "a", [0xE3] = "a", [0xE4] = "a", [0xE5] = "a",
    [0xE8] = "e", [0xE9] = "e", [0xEA] = "e", [0xEB] = "e",
    [0xEC] = "i", [0xED] = "i", [0xEE] = "i", [0xEF] = "i",
    [0xF2] = "o", [0xF3] = "o", [0xF4] = "o", [0xF5] = "o", [0xF6] = "o",
    [0xF9] = "u", [0xFA] = "u", [0xFB] = "u", [0xFC] = "u",
    [0xE7] = "c", [0xF1] = "n",
}
local ZERO = { [0x200B] = true, [0x200C] = true, [0x200D] = true, [0x200E] = true, [0x200F] = true, [0x2060] = true, [0xFEFF] = true, [0xAD] = true }

local function foldUnicode(s)
    if not s:find("[\128-\255]") then
        return s
    end
    if not utf8.len(s) then
        return (s:gsub("[\128-\255]", " "))
    end
    local out = {}
    for _, cp in utf8.codes(s) do
        if not ZERO[cp] then
            if cp < 128 then
                out[#out + 1] = string.char(cp)
            elseif cp >= 0xFF01 and cp <= 0xFF5E then
                out[#out + 1] = string.char(cp - 0xFEE0)
            elseif HOMO[cp] then
                out[#out + 1] = HOMO[cp]
            else
                out[#out + 1] = " "
            end
        end
    end
    return table.concat(out)
end

local function c2(s)
    return (s:gsub("(%a)%1%1+", "%1%1"))
end

local function c1(s)
    return (s:gsub("(%a)%1+", "%1"))
end

local LEET = { ["0"] = "o", ["1"] = "i", ["3"] = "e", ["4"] = "a", ["5"] = "s", ["@"] = "a", ["$"] = "s" }

local function normalize(msg)
    local s = foldUnicode(msg):lower():gsub("[01345@%$]", function(ch)
        return LEET[ch] or ch
    end)
    return c2(s)
end

local SYMS = "[%*%.%-_~'`%^%+|\\/\"%(%)%[%]{}<>,;:]"

local function skeleton(t)
    local s = t:gsub("[aeiouyh]", "")
    s = s:gsub("(.)%1+", "%1")
    return s
end

local function tokenize(norm)
    local raw = {}
    for t in norm:gmatch("%a+") do
        raw[#raw + 1] = t
    end
    local out, run = {}, {}
    local function flush()
        if #run >= 3 then
            out[#out + 1] = table.concat(run)
        else
            for _, r in ipairs(run) do
                out[#out + 1] = r
            end
        end
        run = {}
    end
    for _, t in ipairs(raw) do
        if #t == 1 then
            run[#run + 1] = t
        else
            flush()
            out[#out + 1] = t
        end
    end
    flush()
    return out
end

