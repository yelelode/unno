local function addTag(player)
    local rec = getRecord(player)
    rec.tags += 1
    tagTotal += 1
    scheduleStrikeRefresh()
    updateStatus()
end

local function registerFlag(player, name, msg, cats, sev, blocked, tagged, targeted)
    local rec = getRecord(player)
    rec.count += 1
    if tagged then
        rec.tags += 1
        tagTotal += 1
    end
    if sev > rec.maxSev then
        rec.maxSev = sev
    end
    local incident = {
        time = os.date("%H:%M:%S"),
        msg = msg:sub(1, 200),
        cat = cats[1] or "harass",
        sev = sev,
        targeted = targeted or false,
    }
    table.insert(rec.incidents, incident)
    if #rec.incidents > 20 then
        table.remove(rec.incidents, 1)
    end
    flaggedCount += 1
    lastFlagged = { name = name, msg = msg, cats = cats, sev = sev }

    if not blocked then
        if rec.count >= rec.nextAlert then
            rec.nextAlert = rec.count + 3
            notify("🚨 REPEAT OFFENDER: " .. name .. " (" .. rec.count .. " strikes). Report + Block now!")
            if CFG.AUTO_COPY_EVIDENCE then
                copyToClipboard(buildReportPack(infoFromRec(rec)))
            end
        elseif sev >= 5 then
            notify("🚨 SEVERE: " .. name .. " — " .. table.concat(cats, "+") .. ". Report pack copied.")
            if CFG.AUTO_COPY_EVIDENCE then
                copyToClipboard(buildReportPack(infoFromRec(rec)))
            end
        elseif sev >= 4 then
            notify(name .. " flagged (SEV " .. sev .. "): " .. table.concat(cats, "+"))
        end
    end

    scheduleStrikeRefresh()
    updateStatus()
    return incident
end

local function undoFlag(player, incident)
    local rec = strikes[keyOf(player)]
    if not rec or not incident then
        return
    end
    for i, x in ipairs(rec.incidents) do
        if x == incident then
            table.remove(rec.incidents, i)
            break
        end
    end
    rec.count = math.max(0, rec.count - 1)
    local m = 0
    for _, x in ipairs(rec.incidents) do
        if x.sev > m then
            m = x.sev
        end
    end
    rec.maxSev = m
    if rec.count == 0 and rec.tags == 0 then
        strikes[keyOf(player)] = nil
    end
    flaggedCount = math.max(0, flaggedCount - 1)
    scheduleStrikeRefresh()
    updateStatus()
end

