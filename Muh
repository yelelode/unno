local function quinticEase(t)
    return t * t * t * (t * (t * 6 - 15) + 10)
end

local function computeThemeColor(modeName, phase, offset, modeLevel)
    if modeName == "11. Full Spectrum Mix (Rainbow)" then
        local rawHue = ((phase * 0.14) + (offset or 0)) % 1
        if modeLevel == "Hyper-Smooth 10x (240Hz Quantum)" then
            local microWave = math.sin(rawHue * math.pi * 2) * 0.008
            rawHue = (rawHue + microWave) % 1
        end
        return Color3.fromHSV(rawHue, 0.96, 1)
    end
    local theme = cyberThemes[modeName] or cyberThemes["1. Cyber Crimson (Red-Dark)"]
    local rawWave = (math.sin(phase + (offset or 0)) + 1) / 2
    local wave = rawWave
    if modeLevel == "Hyper-Smooth 10x (240Hz Quantum)" then
        wave = quinticEase(quinticEase(rawWave))
    elseif modeLevel == "Ultra-Smooth (144Hz Cine-Blend)" then
        wave = rawWave * rawWave * (3 - 2 * rawWave)
    end
    return theme.dark:Lerp(theme.bright, wave)
end

