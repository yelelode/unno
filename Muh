-- ========================================================
-- SHARED HTTP HELPER FOR GLOBAL SYNC & WEBHOOKS
-- ========================================================
local reqFn = (syn and syn.request) or (http and http.request) or http_request or request

local function rawHttp(method, url, bodyStr)
    local resBody, okCode = "", false
    pcall(function()
        local headers = {
            ["Content-Type"] = "application/json",
            ["User-Agent"] = "Roblox/WinInet"
        }
        if reqFn then
            local opts = {Url = url, Method = method, Headers = headers}
            if bodyStr then opts.Body = bodyStr end
            local res = reqFn(opts)
            if res then
                if res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300 then
                    okCode = true
                end
                if res.Body and res.Body ~= "" then
                    resBody = res.Body
                    okCode = true
                end
            end
        elseif method == "GET" and game.HttpGet then
            resBody = game:HttpGet(url)
            if resBody and resBody ~= "" then okCode = true end
        end
    end)
    return resBody, okCode
end

local function postToGlobalServer(rawPayload, isHiddenFlag)
    return rawHttp("POST", GLOBAL_CHAT_SERVER .. "/send", HttpService:JSONEncode({
        user = (lp and lp.Name or "Player") .. "::" .. tostring(lp and lp.UserId or 0),
        msg = rawPayload,
        jobId = game.JobId or "global",
        hidden = isHiddenFlag == true
    }))
end

