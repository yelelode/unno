    label(head, stamp, 9, MUTED, Enum.Font.Gotham, {
        Position = UDim2.new(1, -96, 0, 3), Size = UDim2.new(0, 44, 0, 14), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false,
    })
    local pill = label(head, "", 9, WHITE, Enum.Font.GothamBold, {
        Position = UDim2.new(1, -48, 0, 2), Size = UDim2.new(0, 48, 0, 16), BackgroundTransparency = 0,
        BackgroundColor3 = LINE, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Visible = false,
    })
    round(pill, 8)

    local msgLabel = label(card, "", 12, TXT, Enum.Font.Gotham, {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
    })
    local chips = label(card, "", 10, BLUE, Enum.Font.Gotham, {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Visible = false,
    })

    local actions = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 4, Visible = false }, card)
    local function getInfo()
        return makeInfo(player, name, msg, curSev, curCats, {
            time = stampFull, tagged = tagged, tagText = tagText, targeted = targeted, extra = extraLine,
        })
    end
    local repBtn = button(actions, "⚡ Report", RED, UDim2.new(0.4, -3, 1, 0), UDim2.new(0, 0, 0, 0), nil, 10)
    bindReport(repBtn, getInfo, function()
        return player
    end, function()
        markReported(player)
    end)
    button(actions, "📦 Pack", PANEL, UDim2.new(0.3, -3, 1, 0), UDim2.new(0.4, 2, 0, 0), function()
        toast(copyToClipboard(buildReportPack(getInfo())) and "📦 Report pack copied" or "⚠ No clipboard", NEON)
    end, 10)
    button(actions, "🚫 Block", PANEL, UDim2.new(0.3, -3, 1, 0), UDim2.new(0.7, 4, 0, 0), function()
        if isInst and player.Parent then
            if not pcall(function()
                StarterGui:SetCore("PromptBlockPlayer", player)
            end) then
                toast("Block prompt unavailable here", AMBER)
            end
        else
            toast("Player not available", AMBER)
        end
    end, 10)

    local function render()
        local active = curSev > 0 or checking
        local col = checking and AMBER or sevColor(curSev)
        cStroke.Color = active and col or LINE
        cStroke.Transparency = active and 0.2 or 0.5
        pill.Visible = curSev > 0
        pill.Text = "SEV " .. curSev
        pill.BackgroundColor3 = sevColor(curSev)
        msgLabel.Text = (blocked and "🛡 [Blocked — not sent] " or "") .. shown
        msgLabel.TextColor3 = curSev >= 4 and RED_TXT or (curSev > 0 and AMBER_TXT or TXT)
        local parts = {}
        if curSev > 0 then
            parts[#parts + 1] = "● " .. table.concat(curCats, ", ")
        end
        if tagged then
            parts[#parts + 1] = taggedOnly and "🏷 Roblox hid the text" or "🏷 Tagged by Roblox"
        end
        if checking then
            parts[#parts + 1] = "🟡 AI checking…"
        end
        if noteAI ~= "" then
            parts[#parts + 1] = noteAI
        end
        chips.Text = table.concat(parts, "  •  ")
        chips.Visible = #parts > 0
        actions.Visible = curSev > 0 and not blocked
    end
    render()

    card.BackgroundTransparency = 1
    tw(card, { BackgroundTransparency = 0 }, 0.2)

    local handle = {}

    function handle.setVerifying()
        if curSev > 0 then
            noteAI = "🟡 AI verifying…"
            render()
        end
    end

    function handle.markTagged(tText)
        if not alive or not card.Parent then
            return
        end
        tagged, tagText, checking = true, tText, false
        if curSev == 0 then
            curSev, curCats = 3, { "filtered" }
            if player then
                incident = registerFlag(player, name, msg, curCats, curSev, blocked, true, targeted)
            end
        else
            if curSev < 3 then
                curSev = 3
                if incident then
                    incident.sev = 3
                end
                local rec = player and strikes[keyOf(player)]
                if rec and rec.maxSev < 3 then
                    rec.maxSev = 3
                end
            end
            if player then
                addTag(player)
            end
        end
        extraLine = "Roblox filter tagged this message as: " .. tostring(tText)
        render()
        card.Visible = true
    end

    function handle.applyAI(res)
        if not alive or not card.Parent then
            return
        end
        local wasChecking = checking
        checking = false
        if not res then
            noteAI = ""
            render()
            return
        end
        if res.violation then
            if curSev == 0 then
                curSev, curCats = res.severity, { res.category }
                if player and not blocked then
                    incident = registerFlag(player, name, msg, curCats, curSev, blocked, false, targeted)
                end
            end
            extraLine = "AI review confirmed: " .. res.reason
            noteAI = "🤖 ✅ " .. res.reason
        else
            if curSev == 0 then
                noteAI = "🤖 ⚪ " .. res.reason
            else
                if curSev <= 3 and incident and player and not tagged then
                    undoFlag(player, incident)
                    incident = nil
                end
                extraLine = "Note: an AI review doubted this: " .. res.reason
                noteAI = "🤖 ❓ likely OK: " .. res.reason
            end
        end
        render()
        if wasChecking and onlyFlagged then
            card.Visible = curSev > 0
        end
    end

    table.insert(liveEntries, { frame = card, isFlagged = function() return curSev > 0 end })
    if #liveEntries > MAX_HISTORY then
        local old = table.remove(liveEntries, 1)
        if old and old.frame then
            old.frame:Destroy()
        end
    end
    return handle
end

