function V.testMessage(text)
    local norm = D.norm(text)
    local sev, cats, hits, doubt, hint, _, targeted = D.analyze(nil, text, true)
    local verdict = (sev >= 4 and "🔴 REPORT-worthy") or (sev >= 1 and "🟠 flagged") or (doubt and "🟡 would be sent to AI") or "⚪ safe"
    U.sheet("🧪 Test result", table.concat({
        "Input: " .. text, "Normalized: " .. norm, "Tokens: " .. table.concat(D.tokenize(norm), " | "), "",
        "Severity: " .. sev .. "/5", "Categories: " .. (#cats > 0 and table.concat(cats, ", ") or "none"),
        "Matches: " .. (#hits > 0 and table.concat(hits, ", ") or "none"), "Aimed at someone: " .. tostring(targeted),
        "Needs AI check: " .. tostring(doubt), "Notes: " .. (hint ~= "" and hint or "—"), "", "Result: " .. verdict,
    }, "\n"))
end
