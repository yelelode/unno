-- info = {name, display, userId, age, key, msg, sev, cats, cat, time, tagged, tagText, targeted, extra, count, tags}
local function buildShortReport(info)
    local p = POLICY[info.cat] or POLICY.profanity
    local m = info.msg
    if #m > 90 then
        m = m:sub(1, 90) .. "..."
    end
    local s = "Reporting " .. info.name .. " (UserId " .. tostring(info.userId) .. ") who " .. p.desc
        .. ". Message: \"" .. m .. "\" at " .. info.time .. ". "
    if info.targeted then
        s = s .. "It was aimed at another player. "
    end
    if info.count and info.count > 1 then
        s = s .. "This is flagged message #" .. info.count .. " from this user this session. "
    end
    if info.tagged then
        s = s .. "Roblox's own filter also tagged it. "
    end
    return s .. "Violates the Community Standards (" .. p.title .. ")."
end

local function buildFullReport(info)
    local p = POLICY[info.cat] or POLICY.profanity
    local m = info.msg
    if #m > 300 then
        m = m:sub(1, 300) .. "..."
    end
    local lines = {
        "Subject: Chat report — " .. info.name .. " (UserId " .. tostring(info.userId) .. ")",
        "",
        "Hello Roblox Trust & Safety,",
        "",
        "I am reporting the user " .. info.name .. " (display name: " .. tostring(info.display) .. ", UserId: "
            .. tostring(info.userId) .. ", account age: " .. tostring(info.age or 0) .. " days) for violating the Roblox Community Standards ("
            .. p.title .. ").",
        "",
        "What happened:",
        "- At " .. info.time .. " in experience PlaceId " .. tostring(game.PlaceId) .. " (server JobId " .. tostring(game.JobId)
            .. "), the user " .. p.desc .. ".",
        "- Exact message: \"" .. m .. "\"",
    }
    if info.targeted then
        lines[#lines + 1] = "- The message was directed at another player."
    else
        lines[#lines + 1] = "- The message was posted in public chat, visible to other players in the server."
    end
    if info.count and info.count > 1 then
        lines[#lines + 1] = "- This is not an isolated incident: " .. info.count .. " flagged messages from this user were captured in this session."
    end
    if info.tagged then
        lines[#lines + 1] = "- Roblox's automated chat filter also tagged at least one of this user's messages (" .. tostring(info.tags or 1) .. " tag(s))."
    end
    if info.extra and info.extra ~= "" then
        lines[#lines + 1] = "- " .. info.extra
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "Why this violates the rules: " .. p.rule
    lines[#lines + 1] = ""
    lines[#lines + 1] = "A timestamped chat log captured live is included below as evidence."
    lines[#lines + 1] = "Please review this report and take action consistent with your policies. Thank you."
    return table.concat(lines, "\n")
end

local function buildReportPack(info)
    local out = {
