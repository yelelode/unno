        "- Exact message: \"" .. m .. "\"",
        i.targeted and "- The message was directed at another player." or "- The message was posted in public chat, visible to other players in the server.",
    }
    if i.count and i.count > 1 then L[#L + 1] = "- Not an isolated incident: " .. i.count .. " flagged messages from this user were captured in this session." end
    if i.tagged then L[#L + 1] = "- Roblox's automated chat filter also tagged at least one of this user's messages (" .. tostring(i.tags or 1) .. " tag(s))." end
    if i.extra and i.extra ~= "" then L[#L + 1] = "- " .. i.extra end
