local function isCustomDevCard(obj)
    local curr = obj
    while curr do
        if curr:GetAttribute("TXR_CustomCard") then
            return true
        end
        curr = curr.Parent
    end
    return false
end

local modeOrderMap = {
    ["Mode 1: Classic Border"]       = 1,
    ["Mode 2: Beta Bolo EMP On Top"] = 2,
    ["Mode 3: 40x Symbol Preset"]    = 3,
    ["Mode 4: Box-Arrow Wave"]       = 4,
