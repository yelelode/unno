            local pulseSpeed = running and 3.4 or 1.8
            local wave = (math.sin(animClock * pulseSpeed) + 1) / 2
            local smoothWave = wave * wave * (3 - 2 * wave)
            local haloCycle = (animClock * (running and 1.35 or 0.75)) % 1
            local haloEase = 1 - math.pow(1 - haloCycle, 3)

