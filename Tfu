A.rate = {
    Groq = { gap = 2.2, min = 2.1, max = 30, nextAt = 0, coolUntil = 0, pen = 0 },
    Gemini = { gap = 6, min = 4, max = 40, nextAt = 0, coolUntil = 0, pen = 1 },
    OpenRouter = { gap = 3.3, min = 3, max = 30, nextAt = 0, coolUntil = 0, pen = 2 },
    Pollinations = { gap = 6, min = 4, max = 25, nextAt = 0, coolUntil = 0, pen = 4 },
}
function A.providers()
    local l = {}
    if U.hasKey(KEYS.groq) then l[#l + 1] = { name = "Groq", url = CFG.groq.url, model = CFG.groq.model, key = KEYS.groq } end
    if U.hasKey(KEYS.gemini) then l[#l + 1] = { name = "Gemini", url = CFG.gemini.url, model = CFG.gemini.model, key = KEYS.gemini, extra = { reasoning_effort = "none" }, minTokens = 200 } end
    if U.hasKey(KEYS.openrouter) then l[#l + 1] = { name = "OpenRouter", url = CFG.openrouter.url, model = CFG.openrouter.model, key = KEYS.openrouter, openrouter = true } end
    if CFG.pollinations.enabled then l[#l + 1] = { name = "Pollinations", url = CFG.pollinations.url, model = CFG.pollinations.model } end
    return l
end
function A.ordered()
    local now = os.clock()
    local ready, cool = {}, {}
    for _, p in ipairs(A.providers()) do
        if A.rate[p.name].coolUntil > now then cool[#cool + 1] = p else ready[#ready + 1] = p end
    end
    table.sort(ready, function(a, b)
        local ra, rb = A.rate[a.name], A.rate[b.name]
        return math.max(ra.nextAt, now) + ra.pen < math.max(rb.nextAt, now) + rb.pen
    end)
    for _, p in ipairs(cool) do ready[#ready + 1] = p end
    return ready
end
function A.slot(name)
    local r = A.rate[name]
    local now = os.clock()
    local at = math.max(now, r.nextAt)
    r.nextAt = at + r.gap
    if at > now then task.wait(at - now) end
end
function A.try(p, rq, messages, maxTokens)
    local r = A.rate[p.name]
    local headers = { ["Content-Type"] = "application/json" }
    if p.key then headers["Authorization"] = "Bearer " .. p.key end
    if p.openrouter then headers["HTTP-Referer"] = "https://www.roblox.com" headers["X-Title"] = "Phantom OS" end
    local lastErr, lastCode = p.name .. ": failed", 0
    for attempt = 1, (p.extra and 2 or 1) do
        local payload = { model = p.model, messages = messages, max_tokens = math.max(maxTokens or 300, p.minTokens or 0), temperature = 0 }
        if p.extra and attempt == 1 then for k, v in pairs(p.extra) do payload[k] = v end end
        local okE, body = pcall(HS.JSONEncode, HS, payload)
        if not okE then return nil, p.name .. ": encode error", 0 end
        A.slot(p.name)
        local ok, res = pcall(rq, { Url = p.url, Method = "POST", Headers = headers, Body = body })
        if ok and type(res) == "table" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            local raw = res.Body or ""
            local okD, data = pcall(HS.JSONDecode, HS, raw)
            local content, err
            if okD and type(data) == "table" then
                local ch = data.choices and data.choices[1]
                if ch and ch.message and type(ch.message.content) == "string" then content = ch.message.content
                elseif data.error then err = type(data.error) == "table" and (data.error.message or "api error") or tostring(data.error) end
            end
            if not content and not err and code >= 200 and code < 300 and type(raw) == "string" and raw ~= "" then content = raw end
            if content and content ~= "" then r.gap = math.max(r.min, r.gap * 0.92) return content, nil, code end
            lastCode = code
            lastErr = p.name .. ": " .. tostring(err or ("HTTP " .. tostring(code)))
            if code == 429 then
                r.gap = math.min(r.max, r.gap * 2)
                r.coolUntil = os.clock() + 30
                return nil, p.name .. ": rate limited (429)", code
            elseif code == 401 or code == 403 then
                r.coolUntil = os.clock() + 300
                return nil, p.name .. ": key rejected (" .. code .. ")", code
            end
            if not (code == 400 and p.extra and attempt == 1) then break end
        else
            r.coolUntil = os.clock() + 10
            return nil, p.name .. ": request failed", 0
        end
    end
    return nil, lastErr, lastCode
end
function A.call(messages, maxTokens)
    local rq = N.requester()
    if not rq then return nil, nil, "Executor has no HTTP request function.", 0 end
    local order = A.ordered()
    if #order == 0 then return nil, nil, "No AI provider enabled.", 0 end
    local lastErr, lastCode = "unknown error", 0
    S.ai.calls += 1
    for _, p in ipairs(order) do
        local t0 = os.clock()
        local content, err, code = A.try(p, rq, messages, maxTokens)
        if content then
            S.ai.ok += 1
            local st = S.ai.prov[p.name] or { n = 0, ms = 0 }
            st.n += 1
            st.ms += (os.clock() - t0) * 1000
            S.ai.prov[p.name] = st
            return content, p.name, nil, code
        end
        lastErr, lastCode = err or lastErr, code or lastCode
    end
    return nil, nil, lastErr, lastCode
end
A.SYSTEM = "Roblox chat moderator. Players write English/Hindi/Hinglish. Abbreviations or misspellings can hide Hindi abuse "
    .. "(tmc/tmkc=teri maa ki.., mc/bc/bkl/bsdk, chuda/cuda/chud=chudai abuse, lund, gand) but may be harmless "
    .. "(bc=because, mc=Minecraft, cud=cud, chod=leave). Also flag scam/spam scripts (free robux, loadstring, script ads, invite spam). "
    .. "Use recent chat for context. Friendly banter is not a violation. "
    .. "Reply ONLY JSON: {\"v\":0|1,\"c\":\"profanity|hindi|harass|hate|sexual|scam|threat|spam|offsite|none\",\"s\":0-5,\"r\":\"max 8 words\"}"
A.VALID = { profanity = true, hindi = true, harass = true, hate = true, sexual = true, scam = true, threat = true, spam = true, offsite = true }

function A.judge(item)
    local prompt = "Chat:\n" .. (item.ctx ~= "" and item.ctx or "(none)") .. "\nJudge " .. item.name .. ": \"" .. item.msg:sub(1, 160) .. "\""
        .. (item.hint ~= "" and ("\nNotes: " .. item.hint:sub(1, 160)) or "")
    local text, prov = A.call({ { role = "system", content = A.SYSTEM }, { role = "user", content = prompt } }, 60)
    if not text then return nil end
    S.aiLast = prov or "-"
    local data
    local j = text:match("%b{}")
    if j then
        local ok, d = pcall(HS.JSONDecode, HS, j)
        if ok and type(d) == "table" then data = d end
    end
    local viol, cat, sev, reason
    if data then
        local v = data.v
        if v == nil then v = data.violation end
        viol = (v == 1) or (v == true) or (v == "1") or (v == "true")
        cat = tostring(data.c or data.category or "none"):lower()
        sev = tonumber(data.s or data.severity) or 0
        reason = tostring(data.r or data.reason or "")
    else
        local low = text:lower()
        viol = (low:find("violation%W+true") ~= nil) or (low:find("\"v\"%W+1") ~= nil)
        cat, sev, reason = "none", viol and 3 or 0, text:sub(1, 60)
    end
    if viol then
        if not A.VALID[cat] then cat = "harass" end
        sev = math.clamp(math.floor(sev + 0.5), 1, 5)
    end
    if #reason > 80 then reason = reason:sub(1, 80) end
    if reason == "" then reason = viol and "violates chat rules" or "looks fine" end
    local res = { violation = viol, category = cat, severity = sev, reason = reason }
    S.verdictN += 1
    if S.verdictN > 150 then S.verdict, S.verdictN = {}, 1 end
    S.verdict[item.key] = res
    return res
end
function A.learn(item, res)
    if not res or not item.ctoks then return end
    for _, tok in ipairs(item.ctoks) do
        if not D.builtin[tok] and #tok >= 3 and #tok <= 14 then
            if res.violation then
                S.learnV[tok] = (S.learnV[tok] or 0) + 1
                if S.learnV[tok] >= CFG.learnVotes and not D.exact[tok] then
                    local cat = A.VALID[res.category] and res.category or "hindi"
                    local sev = math.clamp(res.severity, 2, 4)
                    D.add(tok, cat, sev, nil, false)
                    S.learned[tok] = { cat = cat, sev = sev }
                    N.save()
                    U.toast("🧠 Learned new word: " .. tok, T.NEON)
                end
            else
                S.safeV[tok] = (S.safeV[tok] or 0) + 1
                if S.safeV[tok] >= 2 then S.whitelist[tok] = true N.save() end
            end
        end
    end
end
function A.enqueue(item)
    local q = S.queue
    if #q >= CFG.queueMax then
        local worst, wi = 0, nil
        for i, x in ipairs(q) do if x.pri > worst then worst, wi = x.pri, i end end
        if wi and worst >= item.pri then
            local d = table.remove(q, wi)
            pcall(d.handle.applyAI, nil)
        else
            pcall(item.handle.applyAI, nil)
            return
        end
    end
    local pos = #q + 1
    for i, x in ipairs(q) do if x.pri > item.pri then pos = i break end end
    table.insert(q, pos, item)
    V.status()
end
function A.setMode(v)
    S.aiMode = v:upper()
    local c = U.cap(v)
    if V.aiSeg then V.aiSeg.set(c) end
    if V.aiSegSetup then V.aiSegSetup.set(c) end
    N.save()
end
function A.startWorkers()
    for _ = 1, CFG.workers do
        task.spawn(function()
            while S.alive do
                local item = table.remove(S.queue, 1)
                if item then
                    if os.clock() - item.t > 40 then
                        pcall(item.handle.applyAI, nil)
                    else
                        local res = A.judge(item)
                        if S.alive then
                            pcall(item.handle.applyAI, res)
                            A.learn(item, res)
                            V.status()
                        end
                    end
                else
                    task.wait(0.25)
                end
            end
        end)
    end
end

-- chat intake -------------------------------------------------------------
function H.logMessage(player, msg, o)
    local k = U.key(player)
    local log = S.chatLog[k]
    if not log then log = {} S.chatLog[k] = log end
    local e = { t = os.clock(), time = os.date("%H:%M:%S"), text = msg, tagged = o.tagged or false, tagText = o.tagText, taggedOnly = o.taggedOnly or false }
    log[#log + 1] = e
    if #log > 15 then table.remove(log, 1) end
    return e
end
function H.findRaw(player, tagged)
    local log = S.chatLog[U.key(player)]
    if not log then return nil end
    local now = os.clock()
    for i = #log, 1, -1 do
        local e = log[i]
        if now - e.t > 6 then break end
        if not e.tagged and not e.taggedOnly and D.posMatch(tagged, e.text) then return e end
    end
    return nil
end
function H.takePending(player, raw)
    local list = S.pending[player]
    if not list then return nil end
    for _, p in ipairs(list) do
        if not p.done and D.posMatch(p.text, raw) then p.done = true return p.text end
    end
    return nil
end
function H.learnTag(raw, tt)
    local words, total = D.filteredWords(raw, tt)
    if #words == 0 or #words > 2 or #words >= total then return end
    for _, w in ipairs(words) do
        if #w >= 3 and #w <= 14 and not D.STOP[w] and not D.exact[w] and not S.whitelist[w] then
            S.tagV[w] = (S.tagV[w] or 0) + 1
            if S.tagV[w] >= CFG.tagVotes then
                D.add(w, "profanity", 2, nil, false)
                S.learned[w] = { cat = "profanity", sev = 2 }
                N.save()
                U.toast("🏷 Roblox keeps tagging '" .. w .. "' — learned", T.NEON)
            end
        end
    end
end
function H.recent(name, msg)
    local r = S.recent
    r[#r + 1] = name .. ": " .. msg:sub(1, 70)
    if #r > 6 then table.remove(r, 1) end
end
function H.snapshot()
    local n, t = #S.recent, {}
    for i = math.max(1, n - CFG.ctxLines + 1), n do t[#t + 1] = S.recent[i] end
    return table.concat(t, "\n")
end
function H.commit(player, msg, blocked, tagText, taggedOnly)
    local name = (typeof(player) == "Instance" and player.Name) or tostring(player)
    S.scanned += 1
    local trusted = H.trusted(player)
    local sev, cats, _, doubt, hint, ctoks, targeted = D.analyze(player, msg)
    local tagged = (tagText ~= nil) or taggedOnly or false
    if trusted and not tagged then sev, cats, doubt = 0, {}, false end
    if tagged then
        if sev < 3 then sev = 3 end
        if #cats == 0 then cats = { "filtered" } end
        doubt = false
    end
    if blocked and sev == 0 then sev, cats = 3, { "profanity" } end

    local entry = H.logMessage(player, msg, { tagged = tagged, tagText = tagText, taggedOnly = taggedOnly })
    local ge = { t = os.clock(), time = os.date("%H:%M:%S"), name = name, text = msg:sub(1, 160), sev = sev }
    S.allLog[#S.allLog + 1] = ge
    if #S.allLog > 120 then table.remove(S.allLog, 1) end

    local inc
    if sev > 0 then inc = H.register(player, name, msg, cats, sev, blocked, tagged, targeted) end
    local handle = V.addEntry(player, name, msg, sev, cats, blocked, doubt, inc, {
        tagged = tagged, taggedOnly = taggedOnly, tagText = tagText, targeted = targeted, trusted = trusted,
    }, ge)
    entry.handle = handle
    local ctx = H.snapshot()
    H.recent(name, msg)
    V.status()
    if tagText then H.learnTag(msg, tagText) end

    if handle and S.aiMode ~= "OFF" and not blocked and not tagged and not trusted and player ~= LP then
        local pri
        if sev > 0 and doubt then pri = 1
        elseif sev == 0 and doubt then pri = 2
        elseif sev > 0 and CFG.confirmStrong and sev <= 3 then pri = 2
        elseif S.aiMode == "STRICT" and sev == 0 and #S.queue < 3 and #msg >= 4 then pri = 3 end
        if pri then
            local key = D.norm(msg)
            local cached = S.verdict[key]
            if cached then
                S.ai.cache += 1
                handle.applyAI(cached)
            else
                if sev > 0 then handle.setVerifying() end
                A.enqueue({ pri = pri, handle = handle, name = name, msg = msg, ctx = ctx, hint = hint, ctoks = ctoks, key = key, t = os.clock() })
            end
        end
    end
end
function H.onChat(player, msg, blocked, source)
    if not S.alive or type(msg) ~= "string" or msg == "" then return end
    local name = (typeof(player) == "Instance" and player.Name) or tostring(player)
    local key = name .. "|" .. msg
    local now = os.clock()
    if S.seen[key] and now - S.seen[key] < 1.5 then return end
    S.seen[key] = now
    S.seenN += 1
    if S.seenN > 60 then
        for k, t in pairs(S.seen) do if now - t > 3 then S.seen[k] = nil end end
        S.seenN = 0
    end
    if D.isTagged(msg) then
        if source == "display" then
            local e = H.findRaw(player, msg)
            if e then
                e.tagged, e.tagText = true, msg
                if e.handle then e.handle.markTagged(msg) end
                H.learnTag(e.text, msg)
                return
            end
            local list = S.pending[player]
            if not list then list = {} S.pending[player] = list end
            local p = { text = msg, done = false }
            list[#list + 1] = p
            if #list > 6 then table.remove(list, 1) end
            task.delay(0.8, function()
                if S.alive and not p.done then p.done = true H.commit(player, msg, false, nil, true) end
            end)
        else
            H.commit(player, msg, false, nil, true)
        end
        return
    end
    local tt = H.takePending(player, msg)
    H.commit(player, msg, blocked, tt, false)
end
function H.hook(player)
    if S.hooked[player] then return end
    S.hooked[player] = true
    U.track(player.Chatted, function(msg) H.onChat(player, msg, false, "chatted") end)
    H.cacheFriend(player)
end
function H.start()
    S.hooked = {}
    for _, p in ipairs(Players:GetPlayers()) do H.hook(p) end
    U.track(Players.PlayerAdded, H.hook)
    U.track(Players.PlayerRemoving, function(p) S.hooked[p] = nil S.flood[p] = nil S.pending[p] = nil end)
    pcall(function()
        if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            U.track(TCS.MessageReceived, function(m)
                local src = m.TextSource
                if src then
                    local plr = Players:GetPlayerByUserId(src.UserId)
                    if plr then H.onChat(plr, m.Text, false, "display") end
                end
            end)
        end
    end)
    pcall(function()
        if not (hookmetamethod and getnamecallmethod) then return end
        local old
        local function handler(self, ...)
            local method = getnamecallmethod()
            if S.alive and (method == "FireServer" or method == "SendAsync") and typeof(self) == "Instance" then
                local legacy = method == "FireServer" and self.Name == "SayMessageRequest"
                local new = method == "SendAsync" and self.ClassName == "TextChannel"
                if (legacy or new) and not (checkcaller and checkcaller()) then
                    local msg = ...
                    if type(msg) == "string" then
                        if S.guard then
                            local okS, sev = pcall(D.quick, msg)
                            if okS and type(sev) == "number" and sev >= 3 then
                                task.defer(U.toast, "🛡 Message blocked — keep chat kind", T.AMBER)
                                task.defer(H.onChat, LP, msg, true, "hook")
                                return
                            end
                        end
                        task.defer(H.onChat, LP, msg, false, "hook")
                    end
                end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
    end)
end

