local function toast(text, color)
    if not St.alive then return end
    St.toastN += 1
    local t = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Th.CARD, BorderSizePixel = 0, LayoutOrder = St.toastN, ZIndex = 41,
    }, toastLayer)
    round(t, 8)
    local st = outline(t, color or Th.NEON, 1, 0.2)
    label(t, text, 11, Th.TXT, Enum.Font.GothamMedium, {
        Size = UDim2.new(1, -12, 1, 0), Position = UDim2.new(0, 8, 0, 0), TextWrapped = false, ZIndex = 42,
    })
    local kids = toastLayer:GetChildren()
    local count = 0
    for _, k in ipairs(kids) do
        if k:IsA("Frame") then count += 1 end
    end
    if count > 3 then
        for _, k in ipairs(kids) do
            if k:IsA("Frame") and k ~= t then
                k:Destroy()
                break
            end
        end
    end
    task.delay(2.6, function()
        if t.Parent then
            tw(t, { BackgroundTransparency = 1 }, 0.25)
            tw(st, { Transparency = 1 }, 0.25)
            task.wait(0.28)
            t:Destroy()
        end
    end)
end

