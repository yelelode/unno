local verdictCache, cacheN = {}, 0
local learnVotes, safeVotes, tagVotes = {}, {}, {}

local function judge(item)
    local prompt = "Chat:\n" .. (item.ctx ~= "" and item.ctx or "(none)")
        .. "\nJudge " .. item.name .. ": \"" .. item.msg:sub(1, 160) .. "\""
        .. (item.hint ~= "" and ("\nNotes: " .. item.hint:sub(1, 160)) or "")
    local text, prov = callAI({
        { role = "system", content = JUDGE_SYSTEM },
        { role = "user", content = prompt },
    }, 60)

    if not text then
        return nil
    end
    aiLast = prov or "-"

    local data
    local j = text:match("%b{}")
    if j then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, j)
        if ok and type(d) == "table" then
            data = d
        end
    end

    local violation, category, severity, reason
    if data then
        local v = data.v
        if v == nil then
            v = data.violation
        end
        violation = (v == 1) or (v == true) or (v == "1") or (v == "true")
        category = tostring(data.c or data.category or "none"):lower()
        severity = tonumber(data.s or data.severity) or 0
        reason = tostring(data.r or data.reason or "")
    else
        local low = text:lower()
        violation = (low:find("violation%W+true") ~= nil) or (low:find("\"v\"%W+1") ~= nil)
        category, severity, reason = "none", violation and 3 or 0, text:sub(1, 60)
    end

    if violation then
        if not VALID_CAT[category] then
            category = "harass"
        end
        severity = math.clamp(math.floor(severity + 0.5), 1, 5)
    end
    if #reason > 80 then
        reason = reason:sub(1, 80)
    end
    if reason == "" then
        reason = violation and "violates chat rules" or "looks fine"
    end
    local res = { violation = violation, category = category, severity = severity, reason = reason }

    cacheN += 1
    if cacheN > 150 then
        verdictCache, cacheN = {}, 1
    end
    verdictCache[item.key] = res
    return res
end

-- Self-learning: AI verdicts teach the local detector (instant next time)
local function learnFromVerdict(item, res)
    if not res or not item.ctoks then
        return
    end
    for _, tok in ipairs(item.ctoks) do
        if not builtin[tok] and #tok >= 3 and #tok <= 14 then
            if res.violation then
                learnVotes[tok] = (learnVotes[tok] or 0) + 1
                if learnVotes[tok] >= CFG.LEARN_VOTES and not exactSet[tok] then
                    local cat = VALID_CAT[res.category] and res.category or "hindi"
                    local sev = math.clamp(res.severity, 2, 4)
                    addExact(tok, cat, sev, nil, false)
                    learned[tok] = { cat = cat, sev = sev }
                    markSave()
                    notify("🧠 Learned new word: " .. tok)
                end
            else
                safeVotes[tok] = (safeVotes[tok] or 0) + 1
                if safeVotes[tok] >= 2 then
                    whitelist[tok] = true
                    markSave()
                end
            end
        end
    end
end

local function enqueue(item)
    if #queue >= CFG.QUEUE_MAX then
        local worstPri, wi = 0, nil
        for i, q in ipairs(queue) do
            if q.pri > worstPri then
                worstPri, wi = q.pri, i
            end
        end
        if wi and worstPri >= item.pri then
            local dropped = table.remove(queue, wi)
            pcall(dropped.handle.applyAI, nil)
        else
            pcall(item.handle.applyAI, nil)
            return
        end
    end
    local pos = #queue + 1
    for i, q in ipairs(queue) do
        if q.pri > item.pri then
            pos = i
            break
        end
    end
    table.insert(queue, pos, item)
    updateStatus()
end

for _ = 1, CFG.WORKERS do
    task.spawn(function()
        while alive do
            local item = table.remove(queue, 1)
            if item then
                if os.clock() - item.t > 40 then
                    pcall(item.handle.applyAI, nil)
                else
                    local res = judge(item)
                    if alive then
                        pcall(item.handle.applyAI, res)
                        learnFromVerdict(item, res)
                        updateStatus()
                    end
                end
            else
                task.wait(0.25)
            end
        end
    end)
end

-- ============================== INTERNET LISTS ==============================
local function httpGet(url)
    local requester = getRequester()
    if requester then
        local ok, res = pcall(requester, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and res.Body ~= "" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            if code >= 200 and code < 300 then
                return res.Body
            end
        end
    end
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" and body ~= "" then
        return body
    end
    return nil
end

local function loadRemote(force)
    if not CFG.REMOTE_ENABLED then
        remoteStats.status = "off"
        return
    end
    remoteStats.status = "loading..."

    if not force and isfile and readfile then
        local ok, d = pcall(function()
            if isfile(CFG.REMOTE_CACHE) then
                return HttpService:JSONDecode(readfile(CFG.REMOTE_CACHE))
            end
        end)
        if ok and type(d) == "table" and type(d.t) == "number" and type(d.words) == "table"
            and os.time() - d.t < CFG.REMOTE_REFRESH_HOURS * 3600 then
            for _, w in ipairs(d.words) do
                remoteSet[w] = true
            end
            for _, ph in ipairs(d.phrases or {}) do
                remotePhrases[#remotePhrases + 1] = ph
            end
            remoteStats.words = #d.words
            remoteStats.phrases = #remotePhrases
            remoteStats.status = "cached"
            return
        end
    end

    local words, phrases, n = {}, {}, 0
    local okAny = false
    for _, url in ipairs(CFG.REMOTE_WORD_URLS) do
        local body = httpGet(url)
        if body then
            okAny = true
            for line in body:gmatch("[^\r\n]+") do
                local w = line:lower():gsub("^%s+", ""):gsub("%s+$", "")
                if w:match("^%a+$") and #w >= 4 and #w <= 14 and not STOP[w] and not builtin[w] then
                    local k = c2(w)
                    if not remoteSet[k] and n < 3500 then
                        remoteSet[k] = true
                        words[#words + 1] = k
                        n += 1
                    end
                end
            end
        end
    end
    for _, url in ipairs(CFG.REMOTE_PHRASE_URLS) do
        local body = httpGet(url)
        if body then
            okAny = true
            for line in body:gmatch("[^\r\n]+") do
                local ph = foldUnicode(line):lower():gsub("^%s+", ""):gsub("%s+$", "")
                if #ph >= 6 and #ph <= 60 and #phrases < 300 then
                    phrases[#phrases + 1] = ph
                    remotePhrases[#remotePhrases + 1] = ph
                end
            end
        end
    end

    remoteStats.words = n
    remoteStats.phrases = #remotePhrases
    remoteStats.status = okAny and "downloaded" or "offline (no list fetched)"
    if okAny and writefile then
        pcall(function()
            writefile(CFG.REMOTE_CACHE, HttpService:JSONEncode({ t = os.time(), words = words, phrases = phrases }))
        end)
    end
end

