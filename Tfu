local function foldUnicode(s)
    if not s:find("[\128-\255]") then return s end
    if not utf8.len(s) then return (s:gsub("[\128-\255]", " ")) end
    local out = {}
    for _, cp in utf8.codes(s) do
        if not Dc.ZERO[cp] then
            if cp < 128 then out[#out + 1] = string.char(cp)
            elseif cp >= 0xFF01 and cp <= 0xFF5E then out[#out + 1] = string.char(cp - 0xFEE0)
            elseif Dc.HOMO[cp] then out[#out + 1] = Dc.HOMO[cp]
            else out[#out + 1] = " " end
        end
    end
    return table.concat(out)
end

local function c2(s) return (s:gsub("(%a)%1%1+", "%1%1")) end
local function c1(s) return (s:gsub("(%a)%1+", "%1")) end
local function normalize(msg)
    local s = foldUnicode(msg):lower():gsub("[01345@%$]", function(ch) return Dc.LEET[ch] or ch end)
    return c2(s)
end
local function skeleton(t)
    local s = t:gsub("[aeiouyh]", "")
    return (s:gsub("(.)%1+", "%1"))
end

local function tokenize(norm)
    local raw = {}
    for t in norm:gmatch("%a+") do raw[#raw + 1] = t end
    local out, run = {}, {}
    local function flush()
        if #run >= 3 then out[#out + 1] = table.concat(run)
        else for _, r in ipairs(run) do out[#out + 1] = r end end
        run = {}
    end
    for _, t in ipairs(raw) do
        if #t == 1 then run[#run + 1] = t else flush(); out[#out + 1] = t end
    end
    flush()
    return out
end

local function addExact(token, cat, sev, ambig, isBuiltin)
    local e = { cat = cat, sev = sev, ambig = ambig }
    local k2 = c2(token)
    St.exactSet[k2] = e
    local k1 = c1(token)
    if #k1 >= 4 then St.exactSet[k1] = e end
    if isBuiltin then St.builtin[k2] = true; St.builtin[k1] = true end
end

