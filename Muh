                    WaterTransparency = terrain.WaterTransparency
                }
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 0
            end
        end)

        savedGraphics.postEffects = {}
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("PostEffect") then
                savedGraphics.postEffects[obj] = obj.Enabled
                obj.Enabled = false
            end
        end

        task.spawn(function()
            savedGraphics.particles = {}
            savedGraphics.materials = {}
            savedGraphics.decals = {}

            local descendants = workspace:GetDescendants()
            for i, obj in ipairs(descendants) do
                if not lagFreeActive then break end

                if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                    savedGraphics.materials[obj] = {
                        Material = obj.Material,
                        CastShadow = obj.CastShadow,
                        Reflectance = obj.Reflectance
                    }
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.CastShadow = false
                    obj.Reflectance = 0
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    savedGraphics.particles[obj] = obj.Enabled
                    obj.Enabled = false
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    savedGraphics.decals[obj] = obj.Transparency
                    obj.Transparency = 1
                end

                if i % 250 == 0 then
                    task.wait()
                end
            end
        end)
    else
        pcall(function()
            if savedGraphics.lighting.GlobalShadows ~= nil then
                Lighting.GlobalShadows = savedGraphics.lighting.GlobalShadows
                Lighting.FogEnd = savedGraphics.lighting.FogEnd
                Lighting.EnvironmentDiffuseScale = savedGraphics.lighting.EnvironmentDiffuseScale
                Lighting.EnvironmentSpecularScale = savedGraphics.lighting.EnvironmentSpecularScale
            end
        end)

        pcall(function()
            if savedGraphics.qualityLevel then
                settings().Rendering.QualityLevel = savedGraphics.qualityLevel
            end
        end)

        pcall(function()
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain and savedGraphics.terrain.WaterWaveSize ~= nil then
                terrain.WaterWaveSize = savedGraphics.terrain.WaterWaveSize
                terrain.WaterWaveSpeed = savedGraphics.terrain.WaterWaveSpeed
                terrain.WaterReflectance = savedGraphics.terrain.WaterReflectance
                terrain.WaterTransparency = savedGraphics.terrain.WaterTransparency
            end
        end)

        for obj, wasEnabled in pairs(savedGraphics.postEffects) do
            if obj and obj.Parent then
                pcall(function() obj.Enabled = wasEnabled end)
            end
        end

        task.spawn(function()
            local count = 0
            for obj, data in pairs(savedGraphics.materials) do
                if lagFreeActive then break end
                if obj and obj.Parent then
                    pcall(function()
                        obj.Material = data.Material
                        obj.CastShadow = data.CastShadow
                        obj.Reflectance = data.Reflectance
                    end)
                end
                count += 1
                if count % 250 == 0 then task.wait() end
            end

            for obj, wasEnabled in pairs(savedGraphics.particles) do
                if lagFreeActive then break end
                if obj and obj.Parent then
                    pcall(function() obj.Enabled = wasEnabled end)
                end
            end

            for obj, origTrans in pairs(savedGraphics.decals) do
                if lagFreeActive then break end
                if obj and obj.Parent then
                    pcall(function() obj.Transparency = origTrans end)
                end
            end
        end)
    end
end

