-- Sub-Pixel Spring Press + Magnetic Hover Physics
local function attachSmoothClick(btn)
    if not btn or not btn:IsA("GuiButton") or btn:GetAttribute("TXR_ClickHooked") then
        return
    end
    btn:SetAttribute("TXR_ClickHooked", true)

    if isTopbarButton(btn) then
        return
    end

    local targetObj = btn
    if btn.BackgroundTransparency >= 0.95 and btn.Parent and btn.Parent:IsA("Frame") and btn.Parent.Size.Y.Offset <= 58 then
        targetObj = btn.Parent
    end

    local isHovered = false
    local isPressed = false

    btn.MouseEnter:Connect(function()
        isHovered = true
        if not isPressed then
            setSpringTarget(targetObj, 1.015, 340, 24)
        end
    end)

    btn.MouseLeave:Connect(function()
        isHovered = false
        if not isPressed then
            setSpringTarget(targetObj, 1.0, 320, 24)
        end
    end)

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPressed = true
            setSpringTarget(targetObj, 0.962, 520, 30)
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPressed = false
            setSpringTarget(targetObj, isHovered and 1.015 or 1.0, 420, 22)
        end
    end)
end

-- Hyper-Fluid Tab Page Switch + Elastic Waterfall Stagger
local function hookSmoothTabPage(scrollFrame)
    if not scrollFrame or not scrollFrame:IsA("ScrollingFrame") or scrollFrame:GetAttribute("TXR_PageSmooth") then
        return
    end
    scrollFrame:SetAttribute("TXR_PageSmooth", true)
    scrollFrame.ScrollBarThickness = 2
    scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(0, 235, 255)
    scrollFrame.ScrollBarImageTransparency = 0.35

    scrollFrame:GetPropertyChangedSignal("Visible"):Connect(function()
        if scrollFrame.Visible then
            local pScale = scrollFrame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", scrollFrame)
            pScale.Scale = 0.972
            setSpringTarget(scrollFrame, 1.0, 360, 25)

            local visibleIdx = 0
            for _, child in ipairs(scrollFrame:GetChildren()) do
                if child:IsA("Frame") and child.Visible and not child:GetAttribute("TXR_CustomCard") then
                    visibleIdx += 1
                    if visibleIdx <= 12 then
                        local cScale = child:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", child)
                        cScale.Scale = 0.955
                        task.delay((visibleIdx - 1) * 0.018, function()
                            if child and child.Parent then
                                setSpringTarget(child, 1.0, 410, 23)
                            end
                        end)
                    end
                end
            end
        end
    end)
end

