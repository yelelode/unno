end)

local function takePending(player, raw)
    local list = St.pendingTagged[player]
    if not list then return nil end
    for _, p in ipairs(list) do
        if not p.done and posMatch(p.text, raw) then p.done = true; return p.text end
    end
    return nil
end

local function learnFromTag(raw, tText)
    local words, total = filteredWords(raw, tText)
    if #words == 0 or #words > 2 or #words >= total then return end
    for _, w in ipairs(words) do
        if #w >= 3 and #w <= 14 and not Dc.STOP[w] and not St.exactSet[w] and not St.whitelist[w] then
            St.tagVotes[w] = (St.tagVotes[w] or 0) + 1
            if St.tagVotes[w] >= CFG.TAG_LEARN_VOTES then
                addExact(w, "profanity", 2, nil, false); St.learned[w] = { cat = "profanity", sev = 2 }; markSave()
                toast("🏷 Roblox keeps tagging '" .. w .. "' — learned", Th.NEON)
            end
        end
    end
end

local function commitMessage(player, msg, blocked, tagText, taggedOnly)
    local name = (typeof(player) == "Instance" and player.Name) or tostring(player)
    local sev, cats, _, doubt, hint, ctoks, targeted = analyze(player, msg)
    local tagged = (tagText ~= nil) or taggedOnly or false

    if tagged then if sev < 3 then sev = 3 end; if #cats == 0 then cats = { "filtered" } end; doubt = false end
    if blocked and sev == 0 then sev, cats = 3, { "profanity" } end

    local entry = logMessage(player, msg, { tagged = tagged, tagText = tagText, taggedOnly = taggedOnly })
    local incident
    if sev > 0 then incident = registerFlag(player, name, msg, cats, sev, blocked, tagged, targeted) end

    local handle = addChatEntry(player, name, msg, sev, cats, blocked, doubt, incident, { tagged = tagged, taggedOnly = taggedOnly, tagText = tagText, targeted = targeted })
    entry.handle = handle

    local ctx = recentSnapshot()
    pushRecent(name, msg); updateStatus()
    if tagText then learnFromTag(msg, tagText) end

    if handle and St.aiMode ~= "OFF" and not blocked and not tagged and player ~= LocalPlayer then
        local pri
        if sev > 0 and doubt then pri = 1 elseif sev == 0 and doubt then pri = 2 elseif sev > 0 and CFG.AI_CONFIRM_STRONG and sev <= 3 then pri = 2 elseif St.aiMode == "STRICT" and sev == 0 and #St.queue < 3 and #msg >= 4 then pri = 3 end
        if pri then
            local key = normalize(msg)
            local cached = St.verdictCache[key]
            if cached then handle.applyAI(cached)
            else
                if sev > 0 then handle.setVerifying() end
                enqueue({ pri = pri, handle = handle, name = name, msg = msg, ctx = ctx, hint = hint, ctoks = ctoks, key = key, t = os.clock() })
            end
        end
    end
end

local function onChat(player, msg, blocked, source)
    if not St.alive or type(msg) ~= "string" or msg == "" then return end
    local name = (typeof(player) == "Instance" and player.Name) or tostring(player)
    local key = name .. "|" .. msg
    local now = os.clock()
    if St.seen[key] and now - St.seen[key] < 1.5 then return end
    St.seen[key] = now; St.seenCount += 1
    if St.seenCount > 60 then
        for k, t in pairs(St.seen) do if now - t > 3 then St.seen[k] = nil end end
        St.seenCount = 0
    end

    if isTagged(msg) then
        if source == "display" then
            local e = findRaw(player, msg)
            if e then
                e.tagged, e.tagText = true, msg
                if e.handle then e.handle.markTagged(msg) end
                learnFromTag(e.text, msg)
                return
            end
            local list = St.pendingTagged[player]
            if not list then list = {}; St.pendingTagged[player] = list end
            local p = { text = msg, done = false }; list[#list + 1] = p
            if #list > 6 then table.remove(list, 1) end
            task.delay(0.8, function() if St.alive and not p.done then p.done = true; commitMessage(player, msg, false, nil, true) end end)
        else commitMessage(player, msg, false, nil, true) end
        return
    end

    local tagText = takePending(player, msg)
    commitMessage(player, msg, blocked, tagText, false)
end

local function hookPlayer(player)
    if St.hooked[player] then return end
    St.hooked[player] = true
    track(player.Chatted, function(msg) onChat(player, msg, false, "chatted") end)
end
