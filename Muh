local function computeThemeColor(modeName, phase, offset, useCineEase)
    if modeName == "11. Full Spectrum Mix (Rainbow)" then
        local hue = ((phase * 0.14) + (offset or 0)) % 1
        return Color3.fromHSV(hue, 0.96, 1)
    end
    local theme = cyberThemes[modeName] or cyberThemes["1. Cyber Crimson (Red-Dark)"]
    local rawWave = (math.sin(phase + (offset or 0)) + 1) / 2
    local wave = useCineEase and (rawWave * rawWave * (3 - 2 * rawWave)) or rawWave
    return theme.dark:Lerp(theme.bright, wave)
end

