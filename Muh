                local highVal = math.min(148, math.max(openVal, closeVal) + math.random(2, 7))
                local lowVal = math.max(10, math.min(openVal, closeVal) - math.random(2, 7))
                local volNorm = math.clamp(((rxKbps + txKbps) / 60) + (running and 0.14 or 0.04), 0.05, 0.28)
                lastClose = closeVal

                for i = 1, candleCount - 1 do
                    candleHistory[i] = candleHistory[i + 1]
                end
                candleHistory[candleCount] = {o = openVal, h = highVal, l = lowVal, c = closeVal, v = volNorm}

                local minScale, maxScale = 999, 0
                for i = 1, candleCount do
                    if candleHistory[i].l < minScale then minScale = candleHistory[i].l end
                    if candleHistory[i].h > maxScale then maxScale = candleHistory[i].h end
                end
                local span = math.max(12, maxScale - minScale)

                for g = 1, 4 do
                    local val = maxScale - ((g - 0.5) / 4.5) * span
                    priceAxisLabels[g].Text = string.format("%.2f", val)
                end

                for i = 1, candleCount do
                    local d = candleHistory[i]
                    local bullish = d.c >= d.o
                    local col = bullish and Color3.fromRGB(0, 200, 118) or Color3.fromRGB(246, 70, 93)

                    local topWickY = (1 - ((d.h - minScale) / span)) * 0.74
                    local botWickY = (1 - ((d.l - minScale) / span)) * 0.74
                    local wickH = math.max(0.03, botWickY - topWickY)

                    local topBodyY = (1 - ((math.max(d.o, d.c) - minScale) / span)) * 0.74
                    local botBodyY = (1 - ((math.min(d.o, d.c) - minScale) / span)) * 0.74
                    local bodyH = math.max(0.03, botBodyY - topBodyY)

                    candles[i].tWickY = topWickY
                    candles[i].tWickH = wickH
                    candles[i].tBodyY = topBodyY
                    candles[i].tBodyH = bodyH
                    candles[i].tVolH = d.v
                    candles[i].tCol = col
                end

                local closeNormY = math.clamp((1 - ((closeVal - minScale) / span)) * 0.74, 0.08, 0.76)
                local lastBullish = closeVal >= openVal
                targetTagY = closeNormY
                targetTagCol = lastBullish and Color3.fromRGB(0, 200, 118) or Color3.fromRGB(246, 70, 93)
                liveTagPrice.Text = string.format("%.2f", closeVal)

                local kbSent = totalBytesSent / 1024
                topStats.Text = string.format("24H VOL: %d PKT  •  %.2f KB", totalSentCount, kbSent)
                heroPrice.Text = string.format("%.2f FPS  •  %dms", closeVal, pingMs)

