    for _, c in ipairs(cats) do
        local x = R.POLICY[c]
        p[#p + 1] = x and ("Roblox Community Standards – " .. x[1] .. ": " .. x[3]) or c
    end
    return table.concat(p, " ")
end
function R.game() return "Game PlaceId: " .. tostring(game.PlaceId) .. " | JobId: " .. tostring(game.JobId) end
function R.cut(s, n)
    if #s <= n then return s end
    local c = n
    while c > 0 do
        local b = s:byte(c + 1)
        if b and b >= 128 and b < 192 then c -= 1 else break end
    end
    return s:sub(1, c)
end
function R.logFor(key, name, uid)
    local log = S.chatLog[key] or {}
    local lines = { "CHAT LOG — " .. tostring(name) .. " (UserId " .. tostring(uid) .. ") | " .. R.game() }
    if #log == 0 then lines[#lines + 1] = "(no messages captured)" end
    for _, e in ipairs(log) do
        local line = "[" .. e.time .. "] " .. e.text .. ((e.dups and e.dups > 1) and ("  (×" .. e.dups .. " repeated)") or "")
        if e.taggedOnly then line = line .. "   ← TAGGED by Roblox (original hidden)"
        elseif e.tagged then line = line .. "   ← TAGGED by Roblox as: " .. tostring(e.tagText) end
        lines[#lines + 1] = line
    end
    return table.concat(lines, "\n")
end
function R.tiny(i)
    local m = #i.msg > 70 and (R.cut(i.msg, 70) .. "…") or i.msg
    local s = "\"" .. m .. "\" at " .. i.time .. "."
    if (i.dupN or 0) >= 3 then s = s .. " Repeated x" .. i.dupN .. "." end
    if i.evasion and #i.evasion > 0 then s = s .. " Filter avoidance used." end
    if i.targeted then s = s .. " Aimed at a player." end
    if i.count and i.count > 1 then s = s .. " Flagged x" .. i.count .. "." end
    return R.cut(s, 190)
end
function R.build(i, max)
    max = math.min(max or CFG.reportMax, 1000)
    local p = R.POLICY[i.cat] or R.POLICY.profanity
    local spamCat = (i.cat == "spam")
    local jid = tostring(game.JobId)
    if jid == "" then jid = "n/a" end
    local REQ = "Request: please review the chat logs for this server and time and apply appropriate chat restrictions to this account. Evidence available on request."

    local function make(msgLen)
        local m = i.msg
        if #m > msgLen then m = R.cut(m, msgLen) .. "…" end
        local rep = ((i.dupN or 0) == 2) and " [sent twice]" or ""
        local fixed = {
            "CHAT REPORT — " .. i.name .. " (UserID " .. tostring(i.userId) .. ")",
            "Policy: Roblox Community Standards – " .. p[1] .. ".",
            "Violation: the user " .. p[2] .. ".",
            "Message: \"" .. m .. "\"" .. rep,
        }
        local where = "Where/when: PlaceId " .. tostring(game.PlaceId) .. ", server " .. jid .. ", " .. i.time .. "."
        local opt = {}
        if i.evasion and #i.evasion > 0 then
            opt[#opt + 1] = { "Filter avoidance: " .. table.concat(i.evasion, "; ") .. " — an apparent deliberate attempt to bypass the chat filter.", spamCat and 2 or 1 }
        end
        local sp = {}
        if (i.dupN or 0) >= 3 then
            sp[#sp + 1] = "identical message repeated ×" .. i.dupN .. ((i.dupSecs and i.dupSecs >= 1) and (" in " .. math.floor(i.dupSecs) .. "s") or "")
        end
        if (i.peak or 0) >= 6 then sp[#sp + 1] = "peak of " .. i.peak .. " messages in 10 seconds" end
        if (i.wave or 0) >= 3 then sp[#sp + 1] = "same text posted by " .. i.wave .. " accounts at once (coordinated)" end
        if #sp > 0 then opt[#opt + 1] = { "Spam pattern: " .. table.concat(sp, "; ") .. ".", spamCat and 1 or 3 } end
        if i.targeted then opt[#opt + 1] = { "The message was directed at another player.", 4 } end
        if i.tagged then opt[#opt + 1] = { "Roblox's own chat filter also tagged this user's message (" .. tostring(i.tags or 1) .. " tag).", 5 } end
        if (i.count or 0) > 1 then opt[#opt + 1] = { "Repeat behaviour: " .. i.count .. " flagged messages from this account this session.", 6 } end
        opt[#opt + 1] = { "Why: " .. p[3], 7 }
        table.sort(opt, function(a, b) return a[2] < b[2] end)
        return fixed, where, opt
    end

    local text, msgLen = "", 170
    for _ = 1, 6 do
        local fixed, where, opt = make(msgLen)
        local keep = {}
        for _, o in ipairs(opt) do keep[#keep + 1] = o end
        local function join()
            local lines = {}
            for _, l in ipairs(fixed) do lines[#lines + 1] = l end
            for _, o in ipairs(keep) do lines[#lines + 1] = o[1] end
            lines[#lines + 1] = where
            lines[#lines + 1] = REQ
            return table.concat(lines, "\n")
        end
        text = join()
        while #text > max and #keep > 0 do
            table.remove(keep)
            text = join()
        end
        if #text <= max then break end
        msgLen = math.max(24, math.floor(msgLen / 2))
    end
    return R.cut(text, max)
end
