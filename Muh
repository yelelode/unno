local function getPlayerAvailableTags(uidNum)
    local uidStr = tostring(uidNum or 0)
    local meta = globalPlayerMeta[uidStr]
    local options = {}

    if uidNum == MODERATOR_USER_ID then
        table.insert(options, {
            id = "DEV",
            title = "👑 DEVELOPER",
            rankNum = 0,
            theme = DEV_SPECIAL_THEME
        })
    end

    if meta and meta.spamRank and meta.spamRank >= 1 and meta.spamRank <= 100 then
        local r = meta.spamRank
        local cfg = SPAM_TOP5_THEMES[r] or {
            title = string.format("⚡ SPAMMER #%d", r),
            speed = 1.08,
            border = Color3.fromRGB(0, 215, 255),
            tagBg = Color3.fromRGB(10, 24, 38),
            colors = UNRANKED_CHROMA_CFG.colors
        }
        table.insert(options, {
            id = "SPAM",
            title = cfg.title,
            rankNum = r,
            theme = cfg
        })
    end

    if meta and meta.grindRank and meta.grindRank >= 1 and meta.grindRank <= 100 then
        local r = meta.grindRank
        local cfg = GRIND_TOP5_THEMES[r] or {
            title = string.format("⏱️ GRINDER #%d", r),
            speed = 1.08,
            border = Color3.fromRGB(195, 95, 255),
            tagBg = Color3.fromRGB(24, 12, 38),
            colors = UNRANKED_CHROMA_CFG.colors
        }
        table.insert(options, {
            id = "GRIND",
            title = cfg.title,
            rankNum = r,
            theme = cfg
        })
    end

    return options
end

local function getBestNumericRankForPlayer(uidNum)
    local uidStr = tostring(uidNum or 0)
    local meta = globalPlayerMeta[uidStr]
    if not meta then return nil end
    local sR = meta.spamRank
    local gR = meta.grindRank
    if sR and gR then
        return math.min(sR, gR)
    end
    return sR or gR
end

local function resolveActiveBadgeForPlayer(uidNum, preferredSlot)
    local uidStr = tostring(uidNum or 0)
    local meta = globalPlayerMeta[uidStr]
    local slot = preferredSlot or (meta and meta.selectedSlot) or "AUTO"
    local tags = getPlayerAvailableTags(uidNum)

    if #tags == 0 then
        return nil
    end

    if slot ~= "AUTO" then
        for _, t in ipairs(tags) do
            if t.id == slot then
                return t
            end
        end
    end

    local best = tags[1]
    for _, t in ipairs(tags) do
        if t.id == "DEV" then
            return t
        end
        if t.rankNum > 0 and (best.rankNum == 0 or t.rankNum < best.rankNum) then
            best = t
        end
    end
    return best
end

