local function predictMessageTagged(candidateMsg)
    if #candidateMsg > 190 then return true end
    local willTag = false
    pcall(function()
        if lp and TextService and TextService.FilterStringAsync then
            local filterObj = TextService:FilterStringAsync(candidateMsg, lp.UserId)
            if filterObj then
                local broadcastStr = filterObj:GetNonChatStringForBroadcastAsync()
                if broadcastStr and broadcastStr:find("###", 1, true) then
                    willTag = true
                end
            end
        elseif lp and ChatService and ChatService.FilterStringForBroadcast then
            local broadcastStr = ChatService:FilterStringForBroadcast(candidateMsg, lp)
            if broadcastStr and broadcastStr:find("###", 1, true) then
                willTag = true
            end
        end
    end)
    return willTag
end

