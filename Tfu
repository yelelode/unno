function H.cleanup()
    if not S.alive then return end
    S.alive = false
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    table.clear(S.conns)
    table.clear(S.queue)
    if V.gui then V.gui:Destroy() end
    env.PhantomOS_Cleanup = nil
end

