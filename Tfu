        St.whitelist[arg] = true; St.custom[arg] = nil; St.learned[arg] = nil; St.remoteSet[arg] = nil
        if not St.builtin[c2(arg)] then St.exactSet[c2(arg)] = nil; St.exactSet[c1(arg)] = nil end
        markSave(); addBubble("sys", "'" .. arg .. "' is now ignored (whitelisted).")
    elseif cmd == "stats" then
        addBubble("sys", "Flagged: " .. St.flaggedCount .. " | Offenders: " .. countKeys(St.strikes) .. " | Roblox tags: " .. St.tagTotal .. " | Learned: " .. countKeys(St.learned) .. " | Custom: " .. countKeys(St.custom) .. " | Lists: " .. St.remoteStats.words .. " words / " .. St.remoteStats.phrases .. " phrases (" .. St.remoteStats.status .. ") | Providers: " .. providerNames() .. " | last: " .. St.aiLast)
    elseif cmd == "refresh" then
        addBubble("sys", "Re-downloading internet lists…")
        task.spawn(function() St.remoteSet, St.remotePhrases = {}, {}; pcall(loadRemote, true); if St.alive then addBubble("sys", "Lists: " .. St.remoteStats.words .. " words / " .. St.remoteStats.phrases .. " phrases (" .. St.remoteStats.status .. ")") end end)
    elseif cmd == "reset" then
        St.strikes, St.chatLog, St.flaggedCount, St.tagTotal, St.lastFlagged = {}, {}, 0, 0, nil
        refreshAll(); updateStatus(); addBubble("sys", "Strikes and logs cleared.")
    else addBubble("sys", "Commands: /add <word> • /white <word> • /stats • /refresh • /reset") end
end

local function sendChat(overrideText, shownText)
    if St.aiBusy or not St.alive then return end
    local text = overrideText or (aiInput.Text or ""):match("^%s*(.-)%s*$")
    if not text or text == "" then return end
    if not overrideText then aiInput.Text = ""; if text:sub(1, 1) == "/" then handleCommand(text); return end end
    addBubble("user", shownText or text)
    table.insert(St.convo, { role = "user", content = text })

    St.aiBusy = true; setBtn(sendBtn, "…")
    local thinking = addBubble("ai", "thinking…")

    task.spawn(function()
        local messages = { { role = "system", content = "You are a concise assistant inside a Roblox moderation tool that helps keep chats safe and kind. Keep answers short." } }
        for i = math.max(1, #St.convo - 9), #St.convo do table.insert(messages, St.convo[i]) end
        local reply, prov, err = callAI(messages, 300)
        if reply then
            table.insert(St.convo, { role = "assistant", content = reply })
            St.aiLast = prov or St.aiLast; reply = reply .. "\n(" .. tostring(prov) .. ")"
        else reply = "Error: " .. tostring(err) end
        if St.alive then
            if thinking and thinking.Parent then thinking.Text = "AI  " .. reply else addBubble("ai", reply) end
            setBtn(sendBtn, "Send"); updateStatus()
        end
        St.aiBusy = false
    end)
end

sendBtn.Activated:Connect(function() sendChat() end)
aiInput.FocusLost:Connect(function(enterPressed) if enterPressed then sendChat() end end)
