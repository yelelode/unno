local function isTopbarButton(obj)
    local curr = obj.Parent
    while curr do
        if curr.Name == "Topbar" or curr.Name == "Shadow" then
            return true
        end
        curr = curr.Parent
    end
    return false
end

local function isCustomDevCard(obj)
    local curr = obj
    while curr do
        if curr:GetAttribute("TXR_CustomCard") then
            return true
        end
        curr = curr.Parent
    end
    return false
end

local function attachSmoothClick(btn)
    if not btn or not btn:IsA("GuiButton") or btn:GetAttribute("TXR_ClickHooked") then
        return
    end
    btn:SetAttribute("TXR_ClickHooked", true)

    if isTopbarButton(btn) then
        return
    end

    local targetObj = btn
    if btn.BackgroundTransparency >= 0.95 and btn.Parent and btn.Parent:IsA("Frame") and btn.Parent.Size.Y.Offset <= 58 then
        targetObj = btn.Parent
    end

    local uiScale = targetObj:FindFirstChildOfClass("UIScale")
    if not uiScale then
        uiScale = Instance.new("UIScale")
        uiScale.Scale = 1
        uiScale.Parent = targetObj
    end

    local pressTween = TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local releaseTween = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(uiScale, pressTween, {Scale = 0.975}):Play()
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(uiScale, releaseTween, {Scale = 1}):Play()
        end
    end)
end

