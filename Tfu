                extraLine = "Note: an AI review doubted this: " .. res.reason; noteAI = "🤖 ❓ likely OK: " .. res.reason
            end
        end
        render(); if wasChecking and St.onlyFlagged then card.Visible = curSev > 0 end
    end
    table.insert(St.liveEntries, { frame = card, isFlagged = function() return curSev > 0 end })
    if #St.liveEntries > MAX_HISTORY then local old = table.remove(St.liveEntries, 1); if old and old.frame then old.frame:Destroy() end end
    return handle
end

-- ============================== AI CORE ==============================
local function getRequester() return (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request) end

local rate = {
    Groq = { gap = 2.2, min = 2.1, max = 30, nextAt = 0, coolUntil = 0, pen = 0 },
    Gemini = { gap = 6, min = 4, max = 40, nextAt = 0, coolUntil = 0, pen = 1 },
    OpenRouter = { gap = 3.3, min = 3, max = 30, nextAt = 0, coolUntil = 0, pen = 2 },
    Pollinations = { gap = 6, min = 4, max = 25, nextAt = 0, coolUntil = 0, pen = 4 },
}

local function getProviders()
    local list = {}
    if hasKey(Api.GROQ_KEY) then list[#list + 1] = { name = "Groq", url = Api.GROQ_URL, model = Api.GROQ_MODEL, key = Api.GROQ_KEY } end
    if hasKey(Api.GEMINI_KEY) then list[#list + 1] = { name = "Gemini", url = Api.GEMINI_URL, model = Api.GEMINI_MODEL, key = Api.GEMINI_KEY, extra = { reasoning_effort = "none" }, minTokens = 200 } end
    if hasKey(Api.AI_API_KEY) then list[#list + 1] = { name = "OpenRouter", url = Api.AI_URL, model = Api.AI_MODEL, key = Api.AI_API_KEY, openrouter = true } end
    if Api.USE_FREE_FALLBACK then list[#list + 1] = { name = "Pollinations", url = Api.POLLI_URL, model = Api.POLLI_MODEL } end
    return list
end

local function orderedProviders()
    local now = os.clock()
    local ready, cooling = {}, {}
    for _, p in ipairs(getProviders()) do
        if rate[p.name].coolUntil > now then cooling[#cooling + 1] = p else ready[#ready + 1] = p end
    end
    table.sort(ready, function(a, b) return math.max(rate[a.name].nextAt, now) + rate[a.name].pen < math.max(rate[b.name].nextAt, now) + rate[b.name].pen end)
    for _, p in ipairs(cooling) do ready[#ready + 1] = p end
    return ready
end

local function waitSlot(name)
    local r = rate[name]
    local now = os.clock()
    local at = math.max(now, r.nextAt)
    r.nextAt = at + r.gap
    if at > now then task.wait(at - now) end
end

local function tryProvider(p, requester, messages, maxTokens)
    local r = rate[p.name]
    local headers = { ["Content-Type"] = "application/json" }
    if p.key then headers["Authorization"] = "Bearer " .. p.key end
    if p.openrouter then headers["HTTP-Referer"] = "https://www.roblox.com"; headers["X-Title"] = "Phantom OS" end
    local lastErr, lastCode = p.name .. ": failed", 0
    for attempt = 1, (p.extra and 2 or 1) do
        local payload = { model = p.model, messages = messages, max_tokens = math.max(maxTokens or 300, p.minTokens or 0), temperature = 0 }
        if p.extra and attempt == 1 then for k, v in pairs(p.extra) do payload[k] = v end end
        local okEnc, body = pcall(HttpService.JSONEncode, HttpService, payload)
        if not okEnc then return nil, p.name .. ": encode error", 0 end
        waitSlot(p.name)
        local ok, res = pcall(requester, { Url = p.url, Method = "POST", Headers = headers, Body = body })
        if ok and type(res) == "table" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            local raw = res.Body or ""
            local okD, data = pcall(HttpService.JSONDecode, HttpService, raw)
            local content, err
            if okD and type(data) == "table" then
                local ch = data.choices and data.choices[1]
                if ch and ch.message and type(ch.message.content) == "string" then content = ch.message.content
                elseif data.error then err = type(data.error) == "table" and (data.error.message or "api error") or tostring(data.error) end
            end
            if not content and not err and code >= 200 and code < 300 and type(raw) == "string" and raw ~= "" then content = raw end
            if content and content ~= "" then r.gap = math.max(r.min, r.gap * 0.92); return content, nil, code end
            lastCode = code; lastErr = p.name .. ": " .. tostring(err or ("HTTP " .. tostring(code)))
            if code == 429 then r.gap = math.min(r.max, r.gap * 2); r.coolUntil = os.clock() + 30; return nil, p.name .. ": rate limited (429)", code
            elseif code == 401 or code == 403 then r.coolUntil = os.clock() + 300; return nil, p.name .. ": key rejected (" .. code .. ")", code end
            if not (code == 400 and p.extra and attempt == 1) then break end
        else
            r.coolUntil = os.clock() + 10; return nil, p.name .. ": request failed", 0
        end
    end
    return nil, lastErr, lastCode
end

local function callAI(messages, maxTokens)
    local requester = getRequester()
    if not requester then return nil, nil, "Executor has no HTTP request function.", 0 end
    local order = orderedProviders()
    if #order == 0 then return nil, nil, "No AI provider enabled.", 0 end
    local lastErr, lastCode = "unknown error", 0
    for _, p in ipairs(order) do
        local content, err, code = tryProvider(p, requester, messages, maxTokens)
        if content then return content, p.name, nil, code end
        lastErr, lastCode = err or lastErr, code or lastCode
    end
    return nil, nil, lastErr, lastCode
end

local JUDGE_SYSTEM = "Roblox chat moderator. Players write English/Hindi/Hinglish. Abbreviations or misspellings can hide Hindi abuse (tmc/tmkc=teri maa ki.., mc/bc/bkl/bsdk, chuda/cuda/chud=chudai abuse, lund, gand) but may be harmless (bc=because, mc=Minecraft, cud=cud, chod=leave). Also flag scam/spam scripts (free robux, loadstring, script ads, invite spam). Use recent chat for context. Friendly banter is not a violation. Reply ONLY JSON: {\"v\":0|1,\"c\":\"profanity|hindi|harass|hate|sexual|scam|threat|spam|offsite|none\",\"s\":0-5,\"r\":\"max 8 words\"}"

local function pushRecent(name, msg)
    table.insert(St.convo, name .. ": " .. msg:sub(1, 70))
    if #St.convo > 6 then table.remove(St.convo, 1) end
end
local function recentSnapshot()
    local n = #St.convo
    local t = {}
    for i = math.max(1, n - CFG.CONTEXT_LINES + 1), n do t[#t + 1] = St.convo[i] end
    return table.concat(t, "\n")
end

local function judge(item)
    local prompt = "Chat:\n" .. (item.ctx ~= "" and item.ctx or "(none)") .. "\nJudge " .. item.name .. ": \"" .. item.msg:sub(1, 160) .. "\"" .. (item.hint ~= "" and ("\nNotes: " .. item.hint:sub(1, 160)) or "")
    local text, prov = callAI({ { role = "system", content = JUDGE_SYSTEM }, { role = "user", content = prompt } }, 60)
    if not text then return nil end
    St.aiLast = prov or "-"

    local data
    local j = text:match("%b{}")
    if j then local ok, d = pcall(HttpService.JSONDecode, HttpService, j); if ok and type(d) == "table" then data = d end end

    local violation, category, severity, reason
    if data then
        local v = data.v if v == nil then v = data.violation end
        violation = (v == 1) or (v == true) or (v == "1") or (v == "true")
        category = tostring(data.c or data.category or "none"):lower()
        severity = tonumber(data.s or data.severity) or 0
        reason = tostring(data.r or data.reason or "")
    else
        local low = text:lower()
        violation = (low:find("violation%W+true") ~= nil) or (low:find("\"v\"%W+1") ~= nil)
        category, severity, reason = "none", violation and 3 or 0, text:sub(1, 60)
    end
    if violation then
        if not Dc.VALID_CAT[category] then category = "harass" end
        severity = math.clamp(math.floor(severity + 0.5), 1, 5)
    end
    if #reason > 80 then reason = reason:sub(1, 80) end
    if reason == "" then reason = violation and "violates chat rules" or "looks fine" end
    local res = { violation = violation, category = category, severity = severity, reason = reason }
    St.cacheN += 1
    if St.cacheN > 150 then St.verdictCache, St.cacheN = {}, 1 end
    St.verdictCache[item.key] = res
    return res
end

local function learnFromVerdict(item, res)
    if not res or not item.ctoks then return end
    for _, tok in ipairs(item.ctoks) do
        if not St.builtin[tok] and #tok >= 3 and #tok <= 14 then
            if res.violation then
                St.learnVotes[tok] = (St.learnVotes[tok] or 0) + 1
                if St.learnVotes[tok] >= CFG.LEARN_VOTES and not St.exactSet[tok] then
                    local cat = Dc.VALID_CAT[res.category] and res.category or "hindi"
                    local sev = math.clamp(res.severity, 2, 4)
                    addExact(tok, cat, sev, nil, false)
                    St.learned[tok] = { cat = cat, sev = sev }
                    markSave()
                    toast("🧠 Learned new word: " .. tok, Th.NEON)
                end
            else
                St.safeVotes[tok] = (St.safeVotes[tok] or 0) + 1
                if St.safeVotes[tok] >= 2 then St.whitelist[tok] = true; markSave() end
            end
        end
    end
end

local function enqueue(item)
    if #St.queue >= CFG.QUEUE_MAX then
        local worstPri, wi = 0, nil
        for i, q in ipairs(St.queue) do if q.pri > worstPri then worstPri, wi = q.pri, i end end
        if wi and worstPri >= item.pri then
            local dropped = table.remove(St.queue, wi); pcall(dropped.handle.applyAI, nil)
        else
            pcall(item.handle.applyAI, nil); return
        end
    end
    local pos = #St.queue + 1
    for i, q in ipairs(St.queue) do if q.pri > item.pri then pos = i; break end end
    table.insert(St.queue, pos, item); updateStatus()
end

for _ = 1, CFG.WORKERS do
    task.spawn(function()
        while St.alive do
            local item = table.remove(St.queue, 1)
            if item then
                if os.clock() - item.t > 40 then pcall(item.handle.applyAI, nil)
                else
                    local res = judge(item)
                    if St.alive then pcall(item.handle.applyAI, res); learnFromVerdict(item, res); updateStatus() end
                end
            else task.wait(0.25) end
        end
    end)
end

local function httpGet(url)
    local requester = getRequester()
    if requester then
        local ok, res = pcall(requester, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and res.Body ~= "" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            if code >= 200 and code < 300 then return res.Body end
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and body ~= "" then return body end
    return nil
end

local function loadRemote(force)
    if not CFG.REMOTE_ENABLED then St.remoteStats.status = "off"; return end
    St.remoteStats.status = "loading..."
    if not force and isfile and readfile then
        local ok, d = pcall(function() if isfile(CFG.REMOTE_CACHE) then return HttpService:JSONDecode(readfile(CFG.REMOTE_CACHE)) end end)
        if ok and type(d) == "table" and type(d.t) == "number" and type(d.words) == "table" and os.time() - d.t < CFG.REMOTE_REFRESH_HOURS * 3600 then
            for _, w in ipairs(d.words) do St.remoteSet[w] = true end
            for _, ph in ipairs(d.phrases or {}) do St.remotePhrases[#St.remotePhrases + 1] = ph end
            St.remoteStats.words, St.remoteStats.phrases, St.remoteStats.status = #d.words, #St.remotePhrases, "cached"
            return
        end
    end

    local words, phrases, n, okAny = {}, {}, 0, false
    for _, url in ipairs(CFG.REMOTE_WORD_URLS) do
        local body = httpGet(url)
        if body then
            okAny = true
            for line in body:gmatch("[^\r\n]+") do
                local w = line:lower():gsub("^%s+", ""):gsub("%s+$", "")
                if w:match("^%a+$") and #w >= 4 and #w <= 14 and not Dc.STOP[w] and not St.builtin[w] then
                    local k = c2(w)
                    if not St.remoteSet[k] and n < 3500 then St.remoteSet[k] = true; words[#words + 1] = k; n += 1 end
                end
            end
        end
    end
    for _, url in ipairs(CFG.REMOTE_PHRASE_URLS) do
        local body = httpGet(url)
        if body then
            okAny = true
            for line in body:gmatch("[^\r\n]+") do
                local ph = foldUnicode(line):lower():gsub("^%s+", ""):gsub("%s+$", "")
                if #ph >= 6 and #ph <= 60 and #phrases < 300 then phrases[#phrases + 1] = ph; St.remotePhrases[#St.remotePhrases + 1] = ph end
            end
        end
    end
    St.remoteStats.words, St.remoteStats.phrases = n, #St.remotePhrases
    St.remoteStats.status = okAny and "downloaded" or "offline (no list fetched)"
    if okAny and writefile then pcall(function() writefile(CFG.REMOTE_CACHE, HttpService:JSONEncode({ t = os.time(), words = words, phrases = phrases })) end) end
end

