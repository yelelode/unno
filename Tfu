                        local res = A.judge(item)
                        if S.alive then
                            pcall(item.handle.applyAI, res)
                            A.learn(item, res)
                            V.status()
                        end
                    end
                else
                    if S.storm and #S.queue > 0 then
                        local d = table.remove(S.queue, 1)
                        pcall(d.handle.applyAI, nil)
                    end
                    task.wait(0.25)
                end
            end
        end)
    end
end

-- ---------------- chat intake ----------------
function H.logMessage(player, msg, o)
    local k = U.key(player)
    local log = S.chatLog[k]
    if not log then log = {} S.chatLog[k] = log end
    local e = { t = os.clock(), time = os.date("%H:%M:%S"), text = msg, tagged = o.tagged or false, tagText = o.tagText, taggedOnly = o.taggedOnly or false }
    log[#log + 1] = e
    if #log > 15 then table.remove(log, 1) end
    return e
end
function H.findRaw(player, tagged)
    local log = S.chatLog[U.key(player)]
    if not log then return nil end
    local now = os.clock()
    for i = #log, 1, -1 do
        local e = log[i]
        if now - e.t > 6 then break end
        if not e.tagged and not e.taggedOnly and D.posMatch(tagged, e.text) then return e end
    end
    return nil
end
function H.takePending(player, raw)
    local list = S.pending[player]
    if not list then return nil end
    for _, p in ipairs(list) do
        if not p.done and D.posMatch(p.text, raw) then p.done = true return p.text end
    end
    return nil
end
function H.learnTag(raw, tt)
    local words, total = D.filteredWords(raw, tt)
    if #words == 0 or #words > 2 or #words >= total then return end
    for _, w in ipairs(words) do
        if #w >= 3 and #w <= 14 and not D.STOP[w] and not D.exact[w] and not S.whitelist[w] then
            S.tagV[w] = (S.tagV[w] or 0) + 1
            if S.tagV[w] >= CFG.tagVotes then
                D.add(w, "profanity", 2, nil, false)
                S.learned[w] = { cat = "profanity", sev = 2 }
                N.save()
                U.toast("🏷 Roblox keeps tagging '" .. w .. "' — learned", T.NEON)
            end
        end
    end
end
function H.recentPush(name, msg)
    local r = S.recent
    r[#r + 1] = name .. ": " .. msg:sub(1, 70)
    if #r > 6 then table.remove(r, 1) end
end
function H.snapshot()
    local n, t = #S.recent, {}
    for i = math.max(1, n - CFG.ctxLines + 1), n do t[#t + 1] = S.recent[i] end
    return table.concat(t, "\n")
end
function H.commit(player, msg, blocked, tagText, taggedOnly)
    local inst = typeof(player) == "Instance"
    local name = inst and player.Name or tostring(player)
    local now = os.clock()
    local pk = U.key(player)
    S.scanned += 1
    S.secMsgs += 1
    S.mtimes[#S.mtimes + 1] = now
    local ps = H.pstat(player)
    ps.msgs += 1
    ps.times[#ps.times + 1] = now
    local b10 = H.rate(player, 10)
    if b10 > (ps.peak or 0) then ps.peak = b10 end
    H.stormCheck(now)
    local tagged = (tagText ~= nil) or taggedOnly or false
    local nk = D.norm(msg)

    local q = S.quar[pk]
    if q and now < q and player ~= LP and not tagged and not blocked then
        if D.quick(msg) < 3 then
            S.quarCount += 1
            local rec = S.strikes[pk]
            if rec then rec.spam = (rec.spam or 0) + 1 end
            local l2 = S.lastMsg[pk]
            if l2 and l2.nk == nk then
                l2.n += 1
                l2.t = now
                ps.dupMax = math.max(ps.dupMax or 0, l2.n)
                ps.dupSecs = now - l2.first
                if l2.entry then l2.entry.dups = l2.n end
                l2.handle.bump(l2.n, 0, {}, false, nil)
            end
            return
        end
    end

    local last = S.lastMsg[pk]
    if last and last.nk == nk and now - last.t < 30 and last.handle and not blocked and not tagged then
        last.n += 1
        last.t = now
        S.dupSuppressed += 1
        local sev2, cats2, _, _, _, _, tg2, ev2, wv2 = D.analyze(player, msg)
        local rec = S.strikes[pk]
        if rec then rec.spam = (rec.spam or 0) + 1 end
        ps.dupMax = math.max(ps.dupMax or 0, last.n)
        ps.dupSecs = now - last.first
        ps.dupText = msg:sub(1, 80)
        if wv2 and wv2 >= 3 then ps.wave = math.max(ps.wave or 0, wv2) end
        if last.entry then last.entry.dups = last.n end
        last.handle.bump(last.n, sev2, cats2, tg2, ev2)
        H.spamFlag(player, cats2)
        return
    end

    local age = inst and player.AccountAge or 999
    local watched = inst and S.watch[tostring(player.UserId)] == true
    local trusted = H.trusted(player)
    local sev, cats, _, doubt, hint, ctoks, targeted, evasion, wv = D.analyze(player, msg)
    if wv and wv >= 3 then ps.wave = math.max(ps.wave or 0, wv) end
    if trusted and not tagged then sev, cats, doubt, evasion = 0, {}, false, {} end
    if tagged then
        if sev < 3 then sev = 3 end
        if #cats == 0 then cats = { "filtered" } end
        doubt = false
    end
    if blocked and sev == 0 then sev, cats = 3, { "profanity" } end
    H.spamFlag(player, cats)
    if watched and player ~= LP then U.toast("⭐ " .. name .. ": " .. msg:sub(1, 40), T.BLUE) end

    local entry = H.logMessage(player, msg, { tagged = tagged, tagText = tagText, taggedOnly = taggedOnly })
    local ge = { t = now, time = os.date("%H:%M:%S"), name = name, text = msg:sub(1, 160), sev = sev }
    S.allLog[#S.allLog + 1] = ge
    if #S.allLog > 120 then table.remove(S.allLog, 1) end
    H.recentPush(name, msg)

    if S.storm and sev == 0 and not doubt and not tagged then
        S.hiddenSafe += 1
        V.status()
        return
    end

    local inc
    if sev > 0 then inc = H.register(player, name, msg, cats, sev, blocked, tagged, targeted, evasion) end
    local rp = inst and S.rep[tostring(player.UserId)]
    local handle = V.addEntry(player, name, msg, sev, cats, blocked, doubt, inc, {
        tagged = tagged, taggedOnly = taggedOnly, tagText = tagText, targeted = targeted, trusted = trusted,
        watched = watched, newAcct = age < CFG.newAcct, age = age, known = rp and (rp.n or 0) >= 3 and rp.n or nil,
        evasion = evasion,
    }, ge)
    entry.handle = handle
    if handle then S.lastMsg[pk] = { nk = nk, t = now, first = now, n = 1, handle = handle, entry = entry } end
    local ctx = H.snapshot()
    V.status()
    if tagText then H.learnTag(msg, tagText) end

    if handle and not S.storm and S.aiMode ~= "OFF" and not blocked and not tagged and not trusted and player ~= LP then
        local pri
        if sev > 0 and doubt then pri = 1
        elseif sev == 0 and doubt then pri = 2
        elseif sev > 0 and CFG.confirmStrong and sev <= 3 then pri = 2
        elseif S.aiMode == "STRICT" and sev == 0 and #S.queue < 3 and #msg >= 4 then pri = 3 end
        if pri then
            local cached = S.verdict[nk]
            if cached then
                S.ai.cache += 1
                handle.applyAI(cached)
            else
                if sev > 0 then handle.setVerifying() end
                A.enqueue({ pri = pri, handle = handle, name = name, msg = msg, ctx = ctx, hint = hint, ctoks = ctoks, key = nk, t = os.clock() })
            end
        end
    end
end
function H.onChat(player, msg, blocked, source)
    if not S.alive or type(msg) ~= "string" or msg == "" then return end
    local name = (typeof(player) == "Instance" and player.Name) or tostring(player)
    local key = name .. "|" .. msg
    local now = os.clock()
    if S.seen[key] and now - S.seen[key] < 1.5 then return end
    S.seen[key] = now
    S.seenN += 1
    if S.seenN > 60 then
        for k, t in pairs(S.seen) do if now - t > 3 then S.seen[k] = nil end end
        S.seenN = 0
    end
    if D.isTagged(msg) then
        if source == "display" then
            local e = H.findRaw(player, msg)
            if e then
                e.tagged, e.tagText = true, msg
                if e.handle then e.handle.markTagged(msg) end
                H.learnTag(e.text, msg)
                return
            end
            local list = S.pending[player]
            if not list then list = {} S.pending[player] = list end
            local p = { text = msg, done = false }
            list[#list + 1] = p
            if #list > 6 then table.remove(list, 1) end
            task.delay(0.8, function()
                if S.alive and not p.done then p.done = true H.commit(player, msg, false, nil, true) end
            end)
        else
            H.commit(player, msg, false, nil, true)
        end
        return
    end
    local tt = H.takePending(player, msg)
    H.commit(player, msg, blocked, tt, false)
end
function H.hook(player)
    if S.hooked[player] then return end
    S.hooked[player] = true
    U.track(player.Chatted, function(msg) H.onChat(player, msg, false, "chatted") end)
    H.cacheFriend(player)
end
function H.start()
    S.hooked = {}
    for _, p in ipairs(Players:GetPlayers()) do H.hook(p) end
    U.track(Players.PlayerAdded, function(p) H.hook(p) H.joined(p) end)
    U.track(Players.PlayerRemoving, function(p)
        S.hooked[p], S.flood[p], S.pending[p] = nil, nil, nil
        S.lastMsg[U.key(p)], S.quar[U.key(p)] = nil, nil
        H.event("➖ " .. p.Name .. " left")
        if V.cur == "Players" then task.delay(0.2, function() V.refreshPlayers(false) end) end
    end)
    U.track(game:GetService("RunService").Heartbeat, function(dt)
        S.frames += 1
        V.runAnims(dt)
    end)
    U.track(UIS.InputBegan, function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.RightControl and V.main then
            if V.orb and V.orb.Visible then V.setOrb(false) elseif V.main.Visible then V.hideMain() else V.showMain() end
        end
    end)
    pcall(function()
        if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            U.track(TCS.MessageReceived, function(m)
                local src = m.TextSource
                if src then
                    local plr = Players:GetPlayerByUserId(src.UserId)
                    if plr then H.onChat(plr, m.Text, false, "display") end
                end
            end)
        end
    end)
    pcall(H.installShield)
    pcall(function()
        if not (hookmetamethod and getnamecallmethod) then return end
        local old
        local function handler(self, ...)
            local method = getnamecallmethod()
            if S.alive and (method == "FireServer" or method == "SendAsync") and typeof(self) == "Instance" then
                local legacy = method == "FireServer" and self.Name == "SayMessageRequest"
                local new = method == "SendAsync" and self.ClassName == "TextChannel"
                if (legacy or new) and not (checkcaller and checkcaller()) then
                    local msg = ...
                    if type(msg) == "string" then
                        if S.guard then
                            local okS, sev = pcall(D.quick, msg)
                            if okS and type(sev) == "number" and sev >= 3 then
                                task.defer(U.toast, "🛡 Message blocked — keep chat kind", T.AMBER)
                                task.defer(H.onChat, LP, msg, true, "hook")
                                return
                            end
                        end
                        task.defer(H.onChat, LP, msg, false, "hook")
                    end
                end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
    end)
end
function H.pulse(tick)
    S.fps = math.floor(S.frames / 2 + 0.5)
    S.frames = 0
    local now = os.clock()
    H.stormCheck(now)
    for k, t in pairs(S.quar) do if now > t then S.quar[k] = nil end end
    for k, t in pairs(S.spamUntil) do if now > t then S.spamUntil[k] = nil end end
    for k, l in pairs(S.lastMsg) do if now - l.t > 60 then S.lastMsg[k] = nil end end
    if V.cur == "Stats" then V.refreshStats(false) end
    if V.cur == "Players" and tick % 2 == 0 then V.refreshPlayers(false) end
end

