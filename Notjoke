end

local exactSet, builtin, substrList, suspectList, SKEL = {}, {}, {}, {}, {}
local remoteSet, remotePhrases = {}, {}
local remoteStats = { words = 0, phrases = 0, status = "not loaded" }

local function addExact(token, cat, sev, ambig, isBuiltin)
    local e = { cat = cat, sev = sev, ambig = ambig }
    local k2 = c2(token)
    exactSet[k2] = e
    local k1 = c1(token)
    if #k1 >= 4 then
        exactSet[k1] = e
    end
    if isBuiltin then
        builtin[k2] = true
        builtin[k1] = true
    end
end

for _, g in ipairs(GROUPS) do
    for _, w in ipairs(g.list) do
        if w:sub(1, 1) == "=" then
            addExact(w:sub(2), g.cat, g.sev, g.ambig, true)
        else
            local w2 = c2(w)
            local w1 = c1(w)
            table.insert(substrList, { w2, g.cat, g.sev, (w2:gsub("[^%a]", "")), (#w1 >= 4) and w1 or nil })
        end
    end
end
for _, p in ipairs(SUSPECT_PHRASES) do
    table.insert(suspectList, c2(p))
end
for _, root in ipairs({ "madarchod", "behenchod", "bhosdike" }) do
    SKEL[skeleton(root)] = root
end
for tok, v in pairs(learned) do
    if type(v) == "table" then
        addExact(tok, v.cat or "profanity", v.sev or 2, nil, false)
    end
end
for tok, v in pairs(custom) do
    if type(v) == "table" then
        addExact(tok, v.cat or "profanity", v.sev or 3, nil, false)
    end
end

