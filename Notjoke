    end
    if info.count and info.count > 1 then
        lines[#lines + 1] = "- This is not an isolated incident: " .. info.count .. " flagged messages from this user were captured in this session."
    end
    if info.tagged then
        lines[#lines + 1] = "- Roblox's automated chat filter also tagged at least one of this user's messages (" .. tostring(info.tags or 1) .. " tag(s))."
    end
    if info.extra and info.extra ~= "" then
        lines[#lines + 1] = "- " .. info.extra
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "Why this violates the rules: " .. p.rule
    lines[#lines + 1] = ""
    lines[#lines + 1] = "A timestamped chat log captured live is included below as evidence."
    lines[#lines + 1] = "Please review this report and take action consistent with your policies. Thank you."
    return table.concat(lines, "\n")
end

local function buildReportPack(info)
    return table.concat({
        "=== SHORT REPORT (paste in the report comment box) ===",
        buildShortReport(info),
        "",
        "=== FULL REPORT (support form / email) ===",
        buildFullReport(info),
        "",
        "=== EVIDENCE ===",
        "Severity: " .. tostring(info.sev) .. "/5 | Categories: " .. table.concat(info.cats, ", "),
        "Rule: " .. reasonText(info.cats),
        gameInfo(),
        "",
        buildLogTextFor(info.key, info.name, info.userId),
    }, "\n")
end

local function makeInfo(player, name, msg, sev, cats, opts)
    opts = opts or {}
    local isInst = typeof(player) == "Instance"
    local rec = strikes[keyOf(player)]
    return {
        name = name, display = isInst and player.DisplayName or name,
        userId = isInst and player.UserId or 0, age = isInst and player.AccountAge or 0,
        key = keyOf(player), msg = msg, sev = sev, cats = cats, cat = cats[1] or "profanity",
        time = opts.time or os.date("%H:%M:%S"), tagged = opts.tagged, tagText = opts.tagText,
        targeted = opts.targeted, extra = opts.extra,
        count = rec and rec.count or 1, tags = rec and rec.tags or 0,
    }
end

local function infoFromRec(rec)
    local best
    for _, x in ipairs(rec.incidents) do
        if not best or x.sev >= best.sev then
            best = x
        end
    end
    best = best or { msg = "(see chat log)", sev = rec.maxSev, cat = "profanity", time = os.date("%H:%M:%S") }
    return {
        name = rec.name, display = rec.display, userId = rec.userId, age = rec.age, key = rec.key,
        msg = best.msg, sev = best.sev, cats = { best.cat }, cat = best.cat, time = best.time,
        tagged = rec.tags > 0, targeted = best.targeted, count = rec.count, tags = rec.tags,
    }
end

local function buildEvidence(rec)
    local lines = {
        "PHANTOM OS EVIDENCE REPORT", gameInfo(),
        "Reported user: " .. rec.name .. " (Display: " .. rec.display .. ", UserId: " .. tostring(rec.userId)
            .. ", Account age: " .. tostring(rec.age) .. " days)",
        "Total strikes: " .. rec.count .. " | Roblox-filter tags: " .. rec.tags .. " | Highest severity: " .. rec.maxSev .. "/5",
        "Incidents (latest 10):",
    }
    local catSeen, catList = {}, {}
    for i = math.max(1, #rec.incidents - 9), #rec.incidents do
        local x = rec.incidents[i]
        lines[#lines + 1] = string.format("[%s] (%s, SEV %d) \"%s\"", x.time, x.cat, x.sev, x.msg)
    end
    for _, x in ipairs(rec.incidents) do
        if not catSeen[x.cat] then
            catSeen[x.cat] = true
            catList[#catList + 1] = x.cat
        end
    end
    lines[#lines + 1] = "Applicable rules: " .. reasonText(catList)
    lines[#lines + 1] = ""
    lines[#lines + 1] = buildLogTextFor(rec.key, rec.name, rec.userId)
    return table.concat(lines, "\n")
end

-- ---------- Direct report (one tap + confirm) ----------
-- returns status: "sent" | "noreason" | "gone" | "self" | "failed"
local function submitReport(info, player)
    local reason = CFG.REPORT_REASON[info.cat]
    if not reason then
        return "noreason"
    end
    if typeof(player) ~= "Instance" or not player.Parent then
        return "gone"
    end
    if player == LocalPlayer then
        return "self"
    end
    local ok = pcall(function()
        Players:ReportAbuse(player, reason, buildTinyReport(info))
    end)
    return ok and "sent" or "failed"
end

local REPORT_MSG = {
    noreason = "No matching Roblox reason for this category — pack copied, report manually.",
    gone = "Player left the server — pack copied.",
    self = "You can't report yourself.",
    failed = "Direct report blocked on this executor — pack copied. Paste it in Roblox's report menu.",
}

-- Binds the two-step (arm → confirm) report logic to a button
local function bindReport(btn, getInfo, getPlayer, onDone)
    local armed, token, done = false, 0, false
    btn.Activated:Connect(function()
        if done then
            return
        end
        if not armed then
            armed = true
            token += 1
            local my = token
            setBtn(btn, "⚠ Confirm?", AMBER)
            task.delay(3, function()
                if alive and armed and my == token and btn.Parent then
                    armed = false
                    setBtn(btn, "⚡ Report", RED)
                end
            end)
            return
        end
        armed = false
        token += 1
        local wait = CFG.REPORT_COOLDOWN - (os.clock() - lastReportAt)
        if wait > 0 then
            toast("Cooldown: " .. math.ceil(wait) .. "s", AMBER)
            setBtn(btn, "⚡ Report", RED)
            return
        end
        local info = getInfo()
        local status = submitReport(info, getPlayer())
        if status == "sent" then
            lastReportAt = os.clock()
            done = true
            setBtn(btn, "✅ Reported", GREEN)
            toast("✅ Report sent: " .. info.name, GREEN)
            if onDone then
                onDone()
            end
        else
            if status ~= "self" then
                copyToClipboard(buildReportPack(info))
            end
            setBtn(btn, "📋 Pack copied", BLUE)
            toast(REPORT_MSG[status] or "Report failed.", AMBER)
            task.delay(2.5, function()
                if alive and btn.Parent and not done then
                    setBtn(btn, "⚡ Report", RED)
                end
            end)
        end
    end)
end

