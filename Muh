                local cleanPct = totalChecked > 0 and ((filterStats.passed + filterStats.fallbackUsed) / totalChecked) * 100 or 100.0
                heroDelta.Text = string.format("▲ +%.2f%% CLEAN", cleanPct)

                ohlcLine.Text = string.format("O:%.2f  H:%.2f  L:%.2f  C:%.2f", openVal, highVal, lowVal, closeVal)
                ohlcLine.TextColor3 = lastBullish and Color3.fromRGB(0, 200, 118) or Color3.fromRGB(246, 70, 93)

                local srvClock = math.floor(workspace.DistributedGameTime)
                local sH = math.floor(srvClock / 3600) % 24
                local sM = math.floor((srvClock % 3600) / 60)
                timeLeft.Text = string.format("%02d:%02d", sH, math.max(0, sM - 10))
                timeMid.Text = string.format("%02d:%02d", sH, math.max(0, sM - 5))
                timeRight.Text = string.format("%02d:%02d", sH, sM)

                tilePlayers.Text = string.format("%d / %d PLR", plrCount, maxPlrs)
