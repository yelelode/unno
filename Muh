        local function ingestServerMessages(dataList)
            if type(dataList) ~= "table" then return end

            local freshLikers = {}
            local freshLikeCount = 0
            local myIdStr = tostring(lp and lp.UserId or 0)
            local foundMyVoteOnServer = false
            local addedNewChat = false
            local addedNewReport = false
            local nowSec = os.time()

            for _, item in ipairs(dataList) do
                local mText = tostring(item.msg or "")
                if mText == "" or mText == "Joined" or mText == "[TYPING]" then
                    continue
                end

                local rawU = tostring(item.user or "")
                local uName, uIdStr = rawU:match("^(.-)::(.-)$")
                uName = uName or rawU
                local uId = tonumber(uIdStr) or 0

                local typUid, typUser = mText:match("^%[EMP_HUBTYPE_V206:(.-):(.-)%]$")
                if typUid and typUid ~= "" then
                    if tostring(typUid) ~= myIdStr then
                        local msgTimeSec = item.time and math.floor(tonumber(item.time) / 1000) or nowSec
                        if (nowSec - msgTimeSec) <= 6 then
                            pollState.liveTypers[(typUser ~= "" and typUser) or uName] = tick()
                        end
                    end
                    continue
                end

                if mText:sub(1, #VOTE_TAG_PREFIX) == VOTE_TAG_PREFIX then
                    local inner = mText:sub(#VOTE_TAG_PREFIX + 1, -2)
                    local vUid, vUser = inner:match("^(.-):(.-)$")
                    if vUid and vUid ~= "" then
                        local uidKey = tostring(vUid)
                        if not freshLikers[uidKey] then
                            freshLikers[uidKey] = (vUser ~= "" and vUser) or uName
                            freshLikeCount += 1
                        end
                        if uidKey == myIdStr then
                            foundMyVoteOnServer = true
                        end
                    end
                    continue
                end

                local rUid, rUser, rMsg = mText:match("^%[EMP_REPORT_V206:(.-):(.-)%]%s*(.*)$")
                if rUid and rMsg then
                    local actualReportUser = (rUser ~= "" and rUser) or uName
                    pollState.liveTypers[actualReportUser] = nil
                    local rKey = tostring(item.id or (rUid .. "_" .. rMsg))
                    if not pollState.renderedReportKeys[rKey] then
                        pollState.renderedReportKeys[rKey] = true
                        pollState.reportOrderCounter += 1
                        addedNewReport = true
                        local tStr = item.time and os.date("%H:%M", math.floor(tonumber(item.time) / 1000)) or os.date("%H:%M")
                        createFeedBubble(reportScroll, pollState.reportOrderCounter, actualReportUser, rUid, rMsg, tStr, true)
                    end
                    continue
                end

                local cUid, cUser, cMsg = mText:match("^%[EMP_HUBCHAT_V206:(.-):(.-)%]%s*(.*)$")
                if cUid and cMsg then
                    local actualChatUser = (cUser ~= "" and cUser) or uName
                    pollState.liveTypers[actualChatUser] = nil
                    local cKey = tostring(item.id or (cUid .. "_" .. cMsg))
                    if not pollState.renderedChatKeys[cKey] then
                        pollState.renderedChatKeys[cKey] = true
                        pollState.chatOrderCounter += 1
                        addedNewChat = true
                        local tStr = item.time and os.date("%H:%M", math.floor(tonumber(item.time) / 1000)) or os.date("%H:%M")
                        createFeedBubble(chatScroll, pollState.chatOrderCounter, actualChatUser, cUid, cMsg, tStr, false)
                    end
                end
            end

            if freshLikeCount == 0 and not foundMyVoteOnServer and pollState.totalLikes == 0 then
                pollState.hasLiked = false
                setLocalLikeLock(false)
            elseif foundMyVoteOnServer then
                pollState.hasLiked = true
                setLocalLikeLock(true)
            end

            pollState.likersMap = freshLikers
            pollState.totalLikes = math.max(pollState.totalLikes, freshLikeCount)
            updateLikeUI()

            if pollState.activePanel == "CHAT" then
                logCounterLbl.Text = string.format("%d LIVE", pollState.chatOrderCounter)
                if addedNewChat then smoothScrollDown(chatScroll) end
            else
                logCounterLbl.Text = string.format("%d LIVE", pollState.reportOrderCounter)
                if addedNewReport then smoothScrollDown(reportScroll) end
            end
        end

