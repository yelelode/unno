    local s = "Reporting " .. info.name .. " (UserId " .. tostring(info.userId) .. ") who " .. p.desc .. ". Message: \"" .. m .. "\" at " .. info.time .. ". "
    if info.targeted then s = s .. "It was aimed at another player. " end
    if info.count and info.count > 1 then s = s .. "This is flagged message #" .. info.count .. " from this user this session. " end
    if info.tagged then s = s .. "Roblox's own filter also tagged it. " end
    return s .. "Violates the Community Standards (" .. p.title .. ")."
end

