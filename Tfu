function U.applyGlass(name)
    local g = T.GLASS[name] or T.GLASS.Glass
    T.GW, T.GC, T.GP = g[1], g[2], g[3]
    S.glass = name
end
function U.track(sig, fn)
    local c = sig:Connect(fn)
    S.conns[#S.conns + 1] = c
    return c
end
function U.trackUI(sig, fn)
    local c = sig:Connect(fn)
    S.uiConns[#S.uiConns + 1] = c
    return c
end
function U.new(class, props, parent)
    local i = Instance.new(class)
    local c = props.BackgroundColor3
    if c and props.BackgroundTransparency == nil then
        if c == T.CARD then i.BackgroundTransparency = T.GC
        elseif c == T.PANEL then i.BackgroundTransparency = T.GP end
    end
    for k, v in pairs(props) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end
function U.round(i, r)
    local c = U.new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, i)
    local cls = i.ClassName
    if cls == "Frame" or cls == "TextButton" or cls == "TextLabel" or cls == "TextBox" or cls == "CanvasGroup" then
        local bc = i.BackgroundColor3
        if (bc == T.CARD or bc == T.PANEL) and not i:FindFirstChildOfClass("UIStroke") then
            U.new("UIStroke", { Color = T.WHITE, Thickness = 1, Transparency = 0.88, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, i)
        end
    end
    return c
end
function U.outline(i, c, t, tr)
    local s = i:FindFirstChildOfClass("UIStroke")
    if s then
        s.Color, s.Thickness, s.Transparency = c or T.LINE, t or 1, tr or 0
        return s
    end
    return U.new("UIStroke", { Color = c or T.LINE, Thickness = t or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, i)
end
function U.pad(i, l, t, r, b)
    return U.new("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0) }, i)
end
-- one easing language: Quint-out for movement, Back for "arrive", Quad for fades
function U.tw(i, p, t, st, dir)
    if S.perfNow then
        pcall(function() for k, v in pairs(p) do i[k] = v end end)
        return
    end
    pcall(function()
        TS:Create(i, TweenInfo.new(t or 0.2, st or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), p):Play()
    end)
end
