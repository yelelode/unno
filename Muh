RunService.RenderStepped:Connect(function(dt)
    if not rgbEnabled then return end
    local safeDt = math.min(dt, 0.033)

    filteredSpeed = filteredSpeed + (rgbSpeed - filteredSpeed) * (1 - math.exp(-safeDt * 12))
    smoothPhase = smoothPhase + (safeDt * filteredSpeed)

    local targetNameCol = computeThemeColor(nameColorMode, smoothPhase, 0, rgbSmoothMode)
    local targetBioCol = computeThemeColor(bioColorMode, smoothPhase, 1.35, rgbSmoothMode)

    if rgbSmoothMode == "Hyper-Smooth 10x (240Hz Quantum)" then
        local alpha1 = 1 - math.exp(-safeDt * 14)
        local alpha2 = 1 - math.exp(-safeDt * 11)
        stage1NameColor = stage1NameColor:Lerp(targetNameCol, alpha1)
        stage1BioColor = stage1BioColor:Lerp(targetBioCol, alpha1)
        currentNameColor = currentNameColor:Lerp(stage1NameColor, alpha2)
        currentBioColor = currentBioColor:Lerp(stage1BioColor, alpha2)
    elseif rgbSmoothMode == "Ultra-Smooth (144Hz Cine-Blend)" then
        local blend = 1 - math.exp(-safeDt * 18)
        stage1NameColor = targetNameCol
        stage1BioColor = targetBioCol
        currentNameColor = currentNameColor:Lerp(targetNameCol, blend)
        currentBioColor = currentBioColor:Lerp(targetBioCol, blend)
    else
        stage1NameColor = targetNameCol
        stage1BioColor = targetBioCol
        currentNameColor = targetNameCol
        currentBioColor = targetBioCol
    end

    pcall(function()
        NameLivePreview:Set(currentNameColor)
        BioLivePreview:Set(currentBioColor)
    end)
end)

