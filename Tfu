    end)
    local lock = U.button(L.ctrl, "📌", S.lockScroll and T.NEOND or T.PANEL, UDim2.new(0.14, -3, 1, 0), UDim2.new(0.72, 3, 0, 0), nil, 12)
    lock.Activated:Connect(function()
        S.lockScroll = not S.lockScroll
        U.setBtn(lock, nil, S.lockScroll and T.NEOND or T.PANEL)
