-- smart follow: sticks to the bottom only if you are at the bottom
function U.follow(sf, st, noLock)
    st.atBottom, st.guard = true, 0
    local function check()
        return (sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y - sf.CanvasPosition.Y) < 36
    end
    sf:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        if os.clock() < st.guard then return end
        local nb = check()
        if nb ~= st.atBottom then
            st.atBottom = nb
            if st.onChange then st.onChange(nb) end
        end
    end)
    sf:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
        if st.atBottom and (noLock or not S.lockScroll) then
            local target = math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y)
            st.guard = os.clock() + 0.35
            if S.perfNow then sf.CanvasPosition = Vector2.new(0, target)
            else U.tw(sf, { CanvasPosition = Vector2.new(0, target) }, 0.28) end
        end
    end)
    st.recheck = function()
        local nb = check()
        if nb ~= st.atBottom then st.atBottom = nb if st.onChange then st.onChange(nb) end end
    end
end
function U.toBottom(sf, st)
    st.guard = os.clock() + 0.5
    U.tw(sf, { CanvasPosition = Vector2.new(0, math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y)) }, 0.35)
    st.atBottom = true
    if st.onChange then st.onChange(true) end
end
function U.num(lbl, target, fmt)
    fmt = fmt or tostring
    local cur = lbl:GetAttribute("n") or 0
    if cur == target then
        if lbl.Text == "" or lbl.Text == "0" then lbl.Text = fmt(target) end
        return
    end
    lbl:SetAttribute("n", target)
    if S.perfNow then lbl.Text = fmt(target) return end
    local id = (lbl:GetAttribute("id") or 0) + 1
    lbl:SetAttribute("id", id)
    local up = target > cur
    task.spawn(function()
        for s = 1, 14 do
            if not S.alive or not lbl.Parent or lbl:GetAttribute("id") ~= id then return end
            local f = 1 - (1 - s / 14) ^ 3
            lbl.Text = fmt(math.floor(cur + (target - cur) * f + 0.5))
            task.wait(0.02)
        end
        lbl.Text = fmt(target)
    end)
    if up then
        local base = lbl:GetAttribute("col") or lbl.TextColor3
        lbl:SetAttribute("col", base)
        lbl.TextColor3 = T.WHITE
        U.tw(lbl, { TextColor3 = base }, 0.7)
    end
end
function U.shimmer(parent, period, phase, strength)
    local f = U.new("Frame", { Size = UDim2.new(0.28, 0, 1.6, 0), Position = UDim2.new(-0.4, 0, -0.3, 0), BackgroundColor3 = T.WHITE, BackgroundTransparency = 0, BorderSizePixel = 0, Rotation = 18, ZIndex = 5 }, parent)
    U.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, strength or 0.9), NumberSequenceKeypoint.new(1, 1) }) }, f)
    U.anim(function(t)
        if not f.Parent then return true end
        f.Position = UDim2.new(((t / period) + (phase or 0)) % 1.8 - 0.4, 0, -0.3, 0)
    end)
    return f
end
function U.rescue(target)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local ap, as = target.AbsolutePosition, target.AbsoluteSize
    if ap.X + as.X < 70 or ap.X > vp.X - 70 or ap.Y + 40 < 0 or ap.Y > vp.Y - 50 then
        U.tw(target, { Position = UDim2.new(0, 8, 0.5, -math.floor(as.Y / 2 / math.max(S.scale, 0.1))) }, 0.6, Enum.EasingStyle.Back)
    end
end
function U.draggable(handle, target, onTap)
    local dragging, dInput, dStart, sPos, moved = false, nil, nil, nil, false
    U.trackUI(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dStart, sPos, moved = true, input.Position, target.Position, false
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if c then c:Disconnect() end
                    if onTap and not moved then onTap() elseif moved then U.rescue(target) end
                end
            end)
        end
    end)
    U.trackUI(handle.InputChanged, function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dInput = input end
    end)
    U.trackUI(UIS.InputChanged, function(input)
        if dragging and input == dInput and dStart and sPos then
            local d = input.Position - dStart
            if d.Magnitude > 8 then moved = true end
            if moved or not onTap then
                U.tw(target, { Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y) }, 0.09, Enum.EasingStyle.Quad)
            end
        end
    end)
end
-- segmented control with a sliding pill
function U.segmented(parent, options, initial, onChange, pos, size)
    local f = U.new("Frame", { Position = pos, Size = size, BackgroundColor3 = T.PANEL, BorderSizePixel = 0 }, parent)
    U.round(f, 9)
    local n = #options
    local pill = U.new("Frame", { Size = UDim2.new(1 / n, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = T.NEOND, BorderSizePixel = 0 }, f)
    U.round(pill, 7)
    U.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.3) }), Rotation = 90 }, pill)
    local btns, obj = {}, {}
    local function paint(v, anim)
        for i, o in ipairs(options) do
            U.tw(btns[o], { TextColor3 = (o == v) and T.WHITE or T.MUTED }, 0.2)
            if o == v then
                local p = UDim2.new((i - 1) / n, 2, 0, 2)
                if anim then U.tw(pill, { Position = p }, 0.42, Enum.EasingStyle.Quint) else pill.Position = p end
            end
        end
    end
    for i, o in ipairs(options) do
        local b = U.new("TextButton", {
            Position = UDim2.new((i - 1) / n, 0, 0, 0), Size = UDim2.new(1 / n, 0, 1, 0), BackgroundTransparency = 1,
            Text = o, TextSize = 10, Font = Enum.Font.GothamBold, TextColor3 = T.MUTED, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 2,
        }, f)
        btns[o] = b
        b.Activated:Connect(function()
            paint(o, true)
            if onChange then onChange(o) end
        end)
    end
    function obj.set(v) paint(v, true) end
    obj.frame = f
    paint(initial, false)
    return obj
end
