-- Central 144Hz Critically-Damped Spring Pool (Zero Tween Cut-off, True Physics Inertia)
local activeSprings = {}

local function setSpringTarget(instance, targetScale, stiffness, damping)
    if not instance or not instance.Parent then return end
    local uiScale = instance:FindFirstChildOfClass("UIScale")
    if not uiScale then
        uiScale = Instance.new("UIScale")
        uiScale.Scale = 1
        uiScale.Parent = instance
    end

    local entry = activeSprings[uiScale]
    if not entry then
        entry = {
            scale = uiScale,
            current = uiScale.Scale,
            velocity = 0,
            target = targetScale,
            stiffness = stiffness or 380,
            damping = damping or 26
        }
        activeSprings[uiScale] = entry
    else
        entry.target = targetScale
        if stiffness then entry.stiffness = stiffness end
        if damping then entry.damping = damping end
    end
end

RunService.RenderStepped:Connect(function(dt)
    local h = math.min(dt, 0.033)
    for uiScale, s in pairs(activeSprings) do
        if not uiScale or not uiScale.Parent then
            activeSprings[uiScale] = nil
        else
            local displacement = s.current - s.target
            local accel = (-s.stiffness * displacement) - (s.damping * s.velocity)
            s.velocity = s.velocity + accel * h
            s.current = s.current + s.velocity * h

            if math.abs(displacement) < 0.0004 and math.abs(s.velocity) < 0.002 then
                s.current = s.target
                s.velocity = 0
                uiScale.Scale = s.target
                activeSprings[uiScale] = nil
            else
                uiScale.Scale = s.current
            end
        end
    end
end)

