    U.segmented(page, { "Players", "Events" }, "Players", function(v)
        V.playerScroll.Visible = (v == "Players")
        V.eventScroll.Visible = (v == "Events")
    end, UDim2.new(), UDim2.new(1, -6, 0, 26))
    V.playerRows, V.eventRows = {}, {}
end
function V.refreshPlayers(pop)
    if not V.playerRows or not V.playerScroll then return end
    for _, r in ipairs(V.playerRows) do r:Destroy() end
    table.clear(V.playerRows)
    local list = Players:GetPlayers()
    table.sort(list, function(a, b)
        local ra, rb = S.strikes[U.key(a)], S.strikes[U.key(b)]
        local sa, sb = ra and R.risk(ra) or 0, rb and R.risk(rb) or 0
        if sa ~= sb then return sa > sb end
        return a.Name < b.Name
    end)
    for i, p in ipairs(list) do
        if i > 40 then break end
        local rec = S.strikes[U.key(p)]
        local ps = S.pstats[U.key(p)]
        local uid = tostring(p.UserId)
        local rp = S.rep[uid]
        local q = S.quar[U.key(p)]
        local card = U.new("TextButton", { Size = UDim2.new(1, -6, 0, 46), BackgroundColor3 = T.CARD, Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i }, V.playerScroll)
        U.round(card, 11)
        U.fx(card)
        if not S.perfNow then U.avatar(card, p.UserId, 30, UDim2.new(0, 8, 0, 8)) end
        local badges = (p == LP and "👤 " or "") .. (S.watch[uid] and "⭐ " or "") .. (S.ignored[uid] and "🔇 " or "") .. (S.hidden[uid] and "🙈 " or "")
            .. (S.friends[p.UserId] and "👥 " or "") .. (p.AccountAge < CFG.newAcct and "🆕 " or "")
            .. ((rp and (rp.n or 0) >= 3) and "🔁 " or "") .. ((q and os.clock() < q) and "🤐 " or "")
        U.label(card, badges .. p.Name, 12, T.TXT, Enum.Font.GothamBold, { Position = UDim2.new(0, 46, 0, 6), Size = UDim2.new(1, -118, 0, 16), TextWrapped = false })
        U.label(card, p.AccountAge .. "d old · " .. (ps and ps.msgs or 0) .. " msgs" .. (rec and (" · " .. rec.count .. " strikes") or ""), 10, T.MUTED, Enum.Font.Gotham, { Position = UDim2.new(0, 46, 0, 24), Size = UDim2.new(1, -60, 0, 14), TextWrapped = false })
        local risk = rec and R.risk(rec) or 0
        local pill = U.label(card, rec and (risk .. "% risk") or "clean", 9, T.WHITE, Enum.Font.GothamBold, {
            Position = UDim2.new(1, -66, 0, 14), Size = UDim2.new(0, 58, 0, 16), BackgroundTransparency = 0,
            BackgroundColor3 = rec and T.GREEN:Lerp(T.RED, risk / 100) or T.NEOND, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
        })
        U.round(pill, 8)
        card.Activated:Connect(function() V.inspect(p) end)
        if pop then U.pop(card, i * 0.03) end
        V.playerRows[#V.playerRows + 1] = card
    end
end
function V.refreshEvents(pop)
    if not V.eventRows or not V.eventScroll then return end
    for _, r in ipairs(V.eventRows) do r:Destroy() end
    table.clear(V.eventRows)
    if #S.events == 0 then V.eventRows[1] = U.empty(V.eventScroll, "📡", "No join/leave events yet.") return end
    for i, e in ipairs(S.events) do
        if i > 30 then break end
        local hot = e.text:find("🚨") or e.text:find("🌪") or e.text:find("🔁")
        local l = U.label(V.eventScroll, "[" .. e.time .. "] " .. e.text, 11, hot and T.REDT or T.TXT, Enum.Font.Gotham, { Size = UDim2.new(1, -6, 0, 16), LayoutOrder = i, TextWrapped = false })
        if pop and not S.perfNow then
            l.TextTransparency = 1
            task.delay(math.min(i * 0.03, 0.4), function() if l.Parent then U.tw(l, { TextTransparency = 0 }, 0.3) end end)
        end
        V.eventRows[#V.eventRows + 1] = l
    end
end

