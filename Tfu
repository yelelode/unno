        "Duration: " .. math.floor((os.time() - S.started) / 60) .. " min | Scanned: " .. S.scanned .. " | Flagged: " .. S.flagged
            .. " | Roblox tags: " .. S.tags .. " | Reports sent: " .. S.reportsSent
            .. " | Duplicates merged: " .. S.dupSuppressed .. " | Quarantined msgs: " .. S.quarCount, "", "By category:",
    }
    for c, n in pairs(S.catCount) do L[#L + 1] = "  - " .. c .. ": " .. n end
    L[#L + 1] = ""
    L[#L + 1] = "Offenders:"
    for _, d in ipairs(H.sorted()) do
        L[#L + 1] = string.format("  - %s (UserId %s): %d strikes, %d tags, max SEV %d, risk %d%%", d.name, tostring(d.userId), d.count, d.tags, d.maxSev, R.risk(d))
    end
    return table.concat(L, "\n")
end
function R.dump()
    local parts = { R.summary(), "" }
