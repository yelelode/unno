local function buildFullReport(info)
    local p = POLICY[info.cat] or POLICY.profanity
    local m = #info.msg > 300 and (info.msg:sub(1, 300) .. "...") or info.msg
    local lines = {
        "Subject: Chat report — " .. info.name .. " (UserId " .. tostring(info.userId) .. ")", "", "Hello Roblox Trust & Safety,", "",
        "I am reporting the user " .. info.name .. " (display name: " .. tostring(info.display) .. ", UserId: " .. tostring(info.userId) .. ", account age: " .. tostring(info.age or 0) .. " days) for violating the Roblox Community Standards (" .. p.title .. ").", "",
