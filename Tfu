    local sw = U.new("TextButton", {
        Text = "", Size = UDim2.new(0, 42, 0, 22), Position = UDim2.new(1, -54, 0.5, -11),
        BackgroundColor3 = T.LINE, AutoButtonColor = false, BorderSizePixel = 0,
    }, row)
