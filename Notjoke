local function sortedOffenders()
    local list = {}
    for _, d in pairs(strikes) do
        table.insert(list, d)
    end
    table.sort(list, function(a, b)
        if a.count ~= b.count then
            return a.count > b.count
        end
        if a.tags ~= b.tags then
            return a.tags > b.tags
        end
        return a.name < b.name
    end)
    return list
end

