            end
        end
    end
    if name == "Stats" then V.refreshStats(true)
    elseif name == "Players" then V.refreshPlayers(true) V.refreshEvents(true)
    elseif name == "Words" then V.refreshWords(true)
    elseif name == "Strikes" then V.refreshStrikes(true)
