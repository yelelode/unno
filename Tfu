    end)
    U.button(L.ctrl, "🗑", T.PANEL, UDim2.new(0.14, -3, 1, 0), UDim2.new(0.86, 3, 0, 0), function()
        for _, e in ipairs(S.liveEntries) do if e.frame then e.frame:Destroy() end end
        S.liveEntries = {}
        S.lastMsg = {}
        U.toast("🗑 Feed cleared", T.AMBER)
    end, 12)

    L.search = U.textbox(page, "🔍 filter by name or text", UDim2.new(0, 0, 0, L.heroH + 79), UDim2.new(1, -6, 0, 24))
    L.search:GetPropertyChangedSignal("Text"):Connect(function()
        S.search = L.search.Text:lower()
        H.applyFilter()
    end)
