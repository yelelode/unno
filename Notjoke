local function reasonText(cats)
    local parts = {}
    for _, c in ipairs(cats) do
        parts[#parts + 1] = REASONS[c] or c
    end
    return table.concat(parts, " ")
end

local function gameInfo()
    return "Game PlaceId: " .. tostring(game.PlaceId) .. " | JobId: " .. tostring(game.JobId)
end

local function buildLogTextFor(key, name, userId)
    local log = chatLog[key] or {}
    local lines = { "CHAT LOG — " .. tostring(name) .. " (UserId " .. tostring(userId) .. ") | " .. gameInfo() }
    if #log == 0 then
        lines[#lines + 1] = "(no messages captured)"
    end
    for _, e in ipairs(log) do
        local line = "[" .. e.time .. "] " .. e.text
        if e.taggedOnly then
            line = line .. "   ← TAGGED by Roblox (original hidden)"
        elseif e.tagged then
            line = line .. "   ← TAGGED by Roblox as: " .. tostring(e.tagText)
        end
        lines[#lines + 1] = line
    end
    return table.concat(lines, "\n")
end

local function buildLogText(rec)
    return buildLogTextFor(rec.key, rec.name, rec.userId)
end

