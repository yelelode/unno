    if alert and not S.perfNow then
        U.anim(function(t)
            if not card.Parent then return true end
            st.Transparency = 0.35 + math.sin(t * 3 + order) * 0.2
        end)
    end
    if d.userId ~= 0 and not S.perfNow then U.avatar(card, d.userId, 34, UDim2.new(0, 8, 0, 8)) end
    local uid = tostring(d.userId)
    local rp = S.rep[uid]
    local q = S.quar[d.key]
    local tagsStr = (S.watch[uid] and " ⭐" or "") .. (S.ignored[uid] and " 🔇" or "") .. (S.hidden[uid] and " 🙈" or "") .. ((d.age or 99) < CFG.newAcct and " 🆕" or "")
        .. ((rp and (rp.n or 0) - d.count >= 3) and " 🔁" or "") .. ((q and os.clock() < q) and " 🤐" or "")
    U.label(card, (alert and "🚨 " or "") .. d.name .. tagsStr, 13, T.TXT, Enum.Font.GothamBold, { Position = UDim2.new(0, 50, 0, 8), Size = UDim2.new(1, -118, 0, 16), TextWrapped = false })
    U.label(card, d.count .. " strikes · 🏷 " .. d.tags .. " · 🔁 " .. (d.spam or 0) .. " spam · 📨 " .. (d.reports or 0), 10, T.MUTED, Enum.Font.Gotham, { Position = UDim2.new(0, 50, 0, 25), Size = UDim2.new(1, -60, 0, 14), TextWrapped = false })
    local risk = R.risk(d)
    local barBg = U.new("Frame", { Position = UDim2.new(0, 50, 0, 43), Size = UDim2.new(1, -112, 0, 5), BackgroundColor3 = T.LINE, BorderSizePixel = 0 }, card)
    U.round(barBg, 3)
    local fill = U.new("Frame", { Size = UDim2.new(0.02, 0, 1, 0), BackgroundColor3 = T.GREEN:Lerp(T.RED, risk / 100), BorderSizePixel = 0 }, barBg)
    U.round(fill, 3)
    U.tw(fill, { Size = UDim2.new(math.max(0.03, risk / 100), 0, 1, 0) }, 0.7, Enum.EasingStyle.Quint)
    U.label(card, risk .. "% risk", 9, T.MUTED, Enum.Font.Gotham, { Position = UDim2.new(1, -58, 0, 39), Size = UDim2.new(0, 50, 0, 12), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
