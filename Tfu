function D.fold(s)
    if not s:find("[\128-\255]") then return s end
    if not utf8.len(s) then return (s:gsub("[\128-\255]", " ")) end
    local out = {}
    for _, cp in utf8.codes(s) do
        if not D.ZERO[cp] then
            if cp < 128 then out[#out + 1] = string.char(cp)
            elseif cp >= 0xFF01 and cp <= 0xFF5E then out[#out + 1] = string.char(cp - 0xFEE0)
            elseif D.HOMO[cp] then out[#out + 1] = D.HOMO[cp]
            else out[#out + 1] = " " end
        end
    end
    return table.concat(out)
end
function D.hasLookalike(s)
    if not s:find("[\128-\255]") or not utf8.len(s) then return false end
    for _, cp in utf8.codes(s) do
        if D.HOMO[cp] or D.ZERO[cp] or (cp >= 0xFF01 and cp <= 0xFF5E) then return true end
    end
    return false
end
function D.c2(s) return (s:gsub("(%a)%1%1+", "%1%1")) end
function D.c1(s) return (s:gsub("(%a)%1+", "%1")) end
function D.norm(msg)
    local s = D.fold(msg):lower():gsub("[01345@%$]", function(ch) return D.LEET[ch] or ch end)
    return D.c2(s)
end
function D.skeleton(t)
    local s = t:gsub("[aeiouyh]", "")
    s = s:gsub("(.)%1+", "%1")
    return s
end
function D.tokenize(norm)
    local raw = {}
    for t in norm:gmatch("%a+") do raw[#raw + 1] = t end
    local out, run = {}, {}
    local function flush()
        if #run >= 3 then out[#out + 1] = table.concat(run)
        else for _, r in ipairs(run) do out[#out + 1] = r end end
        run = {}
    end
    for _, t in ipairs(raw) do
        if #t == 1 then run[#run + 1] = t else flush() out[#out + 1] = t end
    end
    flush()
    return out
end

