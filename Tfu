    local alert = d.count >= CFG.strikeAlert
    local card = U.new("Frame", { Size = UDim2.new(1, -6, 0, 90), BackgroundColor3 = T.CARD, BorderSizePixel = 0, LayoutOrder = order }, parent)
    U.round(card, 11)
