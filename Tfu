        Position = UDim2.new(1, -54, 0, 9), Size = UDim2.new(0, 46, 0, 16), BackgroundTransparency = 0,
        BackgroundColor3 = V.sevColor(d.maxSev), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
    })
    U.round(pill, 8)
    local n = #specs
    for k, s in ipairs(specs) do
        local b = U.button(card, s.text, s.color or T.PANEL, UDim2.new(1 / n, -6, 0, 26), UDim2.new((k - 1) / n, 4, 0, 57), s.fn, 10)
        if s.setup then s.setup(b) end
    end
    if pop then U.pop(card, order * 0.04) end
    return card
end

-- ---------- Inspector ----------
function V.inspect(p)
    local inst = typeof(p) == "Instance"
    local rec = S.strikes[U.key(p)]
    local name = inst and p.Name or tostring(p)
    local uid = inst and p.UserId or 0
    local ps = S.pstats[U.key(p)]
    local rp = S.rep[tostring(uid)]
    local q = S.quar[U.key(p)]
    local L = {
        name .. (inst and (" (@" .. p.DisplayName .. ")") or ""),
        "UserId: " .. tostring(uid) .. " | Account age: " .. tostring(inst and p.AccountAge or "?") .. " days" .. ((inst and p.AccountAge < CFG.newAcct) and "  🆕 NEW" or ""),
        "In server: " .. tostring(inst and p.Parent ~= nil) .. " | Friend: " .. tostring(S.friends[uid] == true),
        "Messages: " .. (ps and ps.msgs or 0) .. " (" .. (inst and H.rate(p) or 0) .. " in last 60s) | peak " .. (ps and ps.peak or 0) .. "/10s | max repeats " .. (ps and ps.dupMax or 0),
        "Watchlist: " .. tostring(S.watch[tostring(uid)] == true) .. " | Ignored: " .. tostring(S.ignored[tostring(uid)] == true)
            .. " | Hidden in my chat: " .. tostring(S.hidden[tostring(uid)] == true) .. " | Quarantined: " .. tostring(q ~= nil and os.clock() < q),
        "All-time strikes (all servers): " .. (rp and rp.n or 0),
    }
    if rec then
        L[#L + 1] = "This session: " .. rec.count .. " strikes | " .. rec.tags .. " tags | " .. (rec.spam or 0) .. " spam repeats | " .. (rec.reports or 0) .. " reports sent"
        L[#L + 1] = "Max SEV: " .. rec.maxSev .. " | Risk: " .. R.risk(rec) .. "%"
    else
        L[#L + 1] = "No strikes this session — clean so far."
    end
    L[#L + 1] = ""
    L[#L + 1] = "Last messages:"
    local log = S.chatLog[U.key(p)] or {}
    for i = math.max(1, #log - 5), #log do L[#L + 1] = "  [" .. log[i].time .. "] " .. log[i].text .. ((log[i].dups and log[i].dups > 1) and ("  (×" .. log[i].dups .. ")") or "") end
    if #log == 0 then L[#L + 1] = "  (none captured)" end

    local acts = {}
    if rec then
        acts[#acts + 1] = { text = "⚡ Report", color = T.RED, setup = function(b)
            R.bind(b, function() return R.infoRec(rec) end, function() return inst and p or nil end, function() R.mark(p) end)
        end }
        acts[#acts + 1] = { text = "📝 Preview", color = T.NEOND, fn = function() V.preview(R.infoRec(rec), inst and p or nil) end }
        acts[#acts + 1] = { text = "📋 Evidence", fn = function() U.toast(U.copy(R.evidence(rec)) and "📋 Evidence copied" or "⚠ No clipboard", T.NEON) end }
    end
    acts[#acts + 1] = { text = "📜 Log", fn = function() U.toast(U.copy(R.logFor(U.key(p), name, uid)) and "📜 Log copied" or "⚠ No clipboard", T.NEON) end }
    acts[#acts + 1] = { text = "🚫 Block", fn = function()
        if inst and p.Parent and p ~= LP then
            if not pcall(function() SG:SetCore("PromptBlockPlayer", p) end) then U.toast("Block prompt unavailable here", T.AMBER) end
        else U.toast("Player not available", T.AMBER) end
    end }
    acts[#acts + 1] = { text = S.hidden[tostring(uid)] and "👁 Show" or "🙈 Hide", fn = function()
        local k = tostring(uid)
        S.hidden[k] = (not S.hidden[k]) or nil
        N.save()
        U.toast(S.hidden[k] and ("🙈 " .. name .. " hidden in your chat") or ("👁 " .. name .. " visible again"), T.NEON)
        if S.hidden[k] and not H.shieldSet then U.toast("Needs the new Roblox chat to hide messages", T.AMBER) end
        H.schedule()
    end }
    acts[#acts + 1] = { text = S.watch[tostring(uid)] and "⭐ Unwatch" or "⭐ Watch", fn = function()
        local k = tostring(uid)
        S.watch[k] = (not S.watch[k]) or nil
        N.save()
        U.toast(S.watch[k] and "⭐ Watching " .. name or "Unwatched " .. name, T.NEON)
        H.schedule()
    end }
    acts[#acts + 1] = { text = S.ignored[tostring(uid)] and "🔊 Unmute" or "🔇 Ignore", fn = function()
        local k = tostring(uid)
        S.ignored[k] = (not S.ignored[k]) or nil
        N.save()
        U.toast(S.ignored[k] and "🔇 Ignoring " .. name or "🔊 Scanning " .. name, T.NEON)
        H.schedule()
    end }
    if q and os.clock() < q then
        acts[#acts + 1] = { text = "🤐 Release", fn = function() S.quar[U.key(p)] = nil U.toast("Released " .. name, T.NEON) H.schedule() end }
    end
    U.sheet("🔎 " .. name, table.concat(L, "\n"), acts)
end

-- ---------- Strikes tab ----------
function V.buildStrikes()
    V.strikeScroll = U.scroll(V.pages.Strikes, UDim2.new(), UDim2.new(1, 0, 1, 0))
    V.strikeRows = {}
end
function V.refreshStrikes(pop)
    if not V.strikeRows then return end
    for _, r in ipairs(V.strikeRows) do r:Destroy() end
    table.clear(V.strikeRows)
    local list = H.sorted()
    if #list == 0 then V.strikeRows[1] = U.empty(V.strikeScroll, "🎉", "No strikes yet. Chat is clean.") return end
    for i = 1, math.min(#list, 25) do
        local d = list[i]
        V.strikeRows[#V.strikeRows + 1] = V.offenderCard(V.strikeScroll, d, i, {
            { text = "🔎 Inspect", fn = function() V.inspect(d.player or d.name) end },
            { text = "📋 Evidence", fn = function() U.toast(U.copy(R.evidence(d)) and "📋 Evidence copied" or "⚠ No clipboard", T.NEON) end },
            { text = "📜 Log", fn = function() U.toast(U.copy(R.logFor(d.key, d.name, d.userId)) and "📜 Chat log copied" or "⚠ No clipboard", T.NEON) end },
        }, pop)
    end
end

