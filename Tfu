    local function paint(v)
        for _, o in ipairs(options) do
            local act = (o == v)
            btns[o].BackgroundColor3 = act and T.NEOND or T.PANEL
            btns[o].TextColor3 = act and T.WHITE or T.MUTED
        end
    end
    for i, o in ipairs(options) do
        local b = U.new("TextButton", {
            Position = UDim2.new((i - 1) / #options, 2, 0, 2), Size = UDim2.new(1 / #options, -4, 1, -4),
            BackgroundColor3 = T.PANEL, Text = o, TextSize = 10, Font = Enum.Font.GothamBold, TextColor3 = T.MUTED,
            AutoButtonColor = false, BorderSizePixel = 0,
