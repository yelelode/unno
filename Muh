            dotHalo.BackgroundTransparency = 0.30 + (haloEase * 0.70)
            enginePillStroke.Color = lerpedDot
            enginePillStroke.Transparency = 0.35 + ((1 - smoothWave) * 0.45)

            local scanX = ((animClock * 0.22) % 1) * 0.86
