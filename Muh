        local function syncRankingsWithServer(shouldPushLocal)
            local myIdStr = tostring(lp and lp.UserId or 0)
            local myName = lp and lp.Name or "Player"
            local myMins = math.max(1, math.floor((tick() - sessionStartTime) / 60))

            if shouldPushLocal and myIdStr ~= "0" then
                local curEntry = rankState.playersData[myIdStr]
                local bestSpam = math.max(totalSentCount, curEntry and curEntry.spam or 0)
                local bestGrind = math.max(myMins, curEntry and curEntry.grind or 0)
                postToGlobalServer(string.format("%s%s:%s:%d:%d]", RANK_TAG_PREFIX, myIdStr, myName, bestSpam, bestGrind), true)
            end

            local raw, ok = rawHttp("GET", GLOBAL_CHAT_SERVER .. "/messages?since=0")
            if ok and raw and raw ~= "" then
                local decOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
                if decOk and type(decoded) == "table" then
                    local aggregated = {}
                    local tagSelPrefix = "[EMP_TAGSEL_" .. RANKING_SEASON_ID .. ":"
                    for _, item in ipairs(decoded) do
                        local mText = tostring(item.msg or "")
                        if mText:sub(1, #RANK_TAG_PREFIX) == RANK_TAG_PREFIX then
                            local inner = mText:sub(#RANK_TAG_PREFIX + 1, -2)
                            local rUid, rName, rSpamStr, rGrindStr = inner:match("^(.-):(.-):(.-):(.-)$")
                            if rUid and rUid ~= "" then
                                local sNum = tonumber(rSpamStr) or 0
                                local gNum = tonumber(rGrindStr) or 0
                                local prev = aggregated[rUid]
                                if not prev then
                                    aggregated[rUid] = {
                                        uid = tonumber(rUid) or 0,
                                        name = (rName ~= "" and rName) or "Player",
                                        spam = sNum,
                                        grind = gNum
                                    }
                                else
                                    prev.spam = math.max(prev.spam, sNum)
                                    prev.grind = math.max(prev.grind, gNum)
                                    if rName and rName ~= "" then prev.name = rName end
                                end
                            end
                        elseif mText:sub(1, #tagSelPrefix) == tagSelPrefix then
                            local inner = mText:sub(#tagSelPrefix + 1, -2)
                            local tUid, tSlot = inner:match("^(.-):(.-)$")
                            if tUid and tUid ~= "" and tSlot and tSlot ~= "" then
                                if not globalPlayerMeta[tUid] then globalPlayerMeta[tUid] = {} end
                                globalPlayerMeta[tUid].selectedSlot = tSlot
                            end
                        end
                    end
                    rankState.playersData = aggregated
                end
            end
            renderLeaderboard()
        end

