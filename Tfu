        "- Exact message: \"" .. m .. "\""
    }
    lines[#lines + 1] = info.targeted and "- The message was directed at another player." or "- The message was posted in public chat, visible to other players in the server."
    if info.count and info.count > 1 then lines[#lines + 1] = "- This is not an isolated incident: " .. info.count .. " flagged messages from this user were captured in this session." end
    if info.tagged then lines[#lines + 1] = "- Roblox's automated chat filter also tagged at least one of this user's messages (" .. tostring(info.tags or 1) .. " tag(s))." end
    if info.extra and info.extra ~= "" then lines[#lines + 1] = "- " .. info.extra end
    lines[#lines + 1] = ""
