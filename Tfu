    local knob = U.new("Frame", { Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = T.WHITE, BorderSizePixel = 0 }, sw)
    U.round(knob, 9)
    local state = initial
    local function paint(anim)
        local pos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        if anim then
            U.tw(knob, { Size = UDim2.new(0, 24, 0, 18) }, 0.09, Enum.EasingStyle.Quad)
            task.delay(0.09, function()
                if knob.Parent then U.tw(knob, { Size = UDim2.new(0, 18, 0, 18), Position = pos }, 0.34, Enum.EasingStyle.Back) end
            end)
        else
            knob.Position = pos
        end
        U.tw(sw, { BackgroundColor3 = state and T.NEOND or T.LINE }, 0.25)
    end
    paint(false)
    sw.Activated:Connect(function()
        state = not state
        paint(true)
        onChange(state)
    end)
    return { set = function(v) state = v paint(true) end }
end
