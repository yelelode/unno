-- returns sev, cats, hits, doubt, hint, ctoks, targeted, evasion(list), waveCount
function D.analyze(player, msg, stateless)
    local norm = D.norm(msg)
    local glued = (norm:gsub(D.SYMS, ""))
    local variants = { norm }
    if glued ~= norm then variants[2] = glued end
    local sev, catSet, cats, hits = 0, {}, {}, {}
    local doubt, hints, ctoks, seenTok, targeted = false, {}, {}, {}, false
    local abuseWords, ambigTok, fuzzyTok, waveCount = {}, nil, nil, 0
    local function hit(cat, s, word)
        if not catSet[cat] then catSet[cat] = true cats[#cats + 1] = cat end
        hits[#hits + 1] = word
        if D.ABUSE[cat] and word ~= "flood" and word ~= "wave" then abuseWords[#abuseWords + 1] = word end
        if s > sev then sev = s end
    end
    local function addDoubt(tok, h)
        doubt = true
        hints[#hints + 1] = h
        if tok and not seenTok[tok] then seenTok[tok] = true ctoks[#ctoks + 1] = tok end
    end

    for _, vs in ipairs(variants) do
        local tokens = D.tokenize(vs)
        local joined = table.concat(tokens, " ")
        local joinedSq, compact = D.c1(joined), (joined:gsub("[^%a]", ""))
        for _, tok in ipairs(tokens) do
            local e = D.exact[tok]
            if not e and #tok >= 4 then e = D.exact[D.c1(tok)] end
            if e and S.whitelist[tok] then e = nil end
            if e then
                hit(e.cat, e.sev, tok)
                if not stateless then S.wordCount[tok] = (S.wordCount[tok] or 0) + 1 end
                if e.ambig then
                    ambigTok = ambigTok or tok
                    addDoubt(tok, "'" .. tok .. "' may be a Hindi abuse abbreviation/evasion spelling or harmless")
                end
            elseif not S.whitelist[tok] then
                if #tok >= 4 and (D.remote[tok] or D.remote[D.c1(tok)]) and not D.STOP[tok] then
                    addDoubt(tok, "'" .. tok .. "' is on public bad-word lists (may be harmless)")
                elseif #tok >= 5 and D.skel[D.skeleton(tok)] then
                    fuzzyTok = fuzzyTok or tok
                    hit("hindi", 3, tok)
                    addDoubt(tok, "'" .. tok .. "' sounds like Hindi abuse '" .. D.skel[D.skeleton(tok)] .. "'")
                elseif #tok >= 3 and #tok <= 6 and not tok:find("[aeiouy]") and not D.COK[tok] then
                    addDoubt(tok, "unknown abbreviation '" .. tok .. "'")
                end
            end
            if D.TARGET[tok] then targeted = true end
        end
        for _, e in ipairs(D.substr) do
            local w, cat, s, wc, w1 = e[1], e[2], e[3], e[4], e[5]
            if joined:find(w, 1, true) or (w1 and joinedSq:find(w1, 1, true)) or (#wc >= 7 and compact:find(wc, 1, true)) then hit(cat, s, w) end
        end
        for ph, v in pairs(S.cphrases) do
            if joined:find(ph, 1, true) then hit(v.cat or "profanity", v.sev or 3, ph) end
        end
        for _, p in ipairs(D.suspect) do
            if joined:find(p, 1, true) then addDoubt(nil, "phrase '" .. p .. "' may hide an insult or unsafe request") break end
        end
    end

    local rawLow = D.fold(msg):lower()
    for _, p in ipairs(D.SCAM) do
        if rawLow:find(p[1], 1, true) then
            hit(p[2], p[3], p[1])
            if p[3] >= 3 then addDoubt(nil, "contains '" .. p[1] .. "' (possible spam/scam script)") end
        end
    end
    if anyIn(rawLow, D.SCRIPTW) and anyIn(rawLow, D.PUSHW) then hit("scam", 3, "script-ad") addDoubt(nil, "looks like a script/exploit advertisement") end
    if anyIn(rawLow, D.ROBUXW) and anyIn(rawLow, D.GIFTW) then hit("scam", 4, "robux-scam") addDoubt(nil, "possible free-Robux scam") end
    for _, ph in ipairs(D.rphr) do
        if rawLow:find(ph, 1, true) then hit("scam", 3, ph) addDoubt(nil, "matches known spam phrase '" .. ph .. "'") break end
    end
    if #msg >= 60 then
        local _, letters = msg:gsub("%a", "")
        if letters / #msg < 0.35 then hit("spam", 2, "symbol-flood") end
    end
    if sev >= 2 and targeted then sev = math.min(5, sev + 1) end

    if not stateless and typeof(player) == "Instance" then
        local now = os.clock()
        local f = S.flood[player]
        if not f then f = { times = {}, last = "", lastT = 0, dup = 0 } S.flood[player] = f end
        table.insert(f.times, now)
        while #f.times > 0 and now - f.times[1] > 6 do table.remove(f.times, 1) end
        local low = msg:lower()
        if low == f.last and now - f.lastT < 20 then f.dup += 1 else f.dup = 1 end
        f.last, f.lastT = low, now
        if #f.times >= 5 or f.dup >= 3 then hit("spam", 2, "flood") end
        if #msg >= 12 then
            local w = S.wave[norm]
            if not w or now - w.t > 20 then
                if not w then S.waveN += 1 end
                w = { t = now, players = {}, n = 0 }
                S.wave[norm] = w
            end
            if not w.players[player] then w.players[player] = true w.n += 1 end
            waveCount = w.n
            if w.n >= 3 then hit("spam", 3, "wave") addDoubt(nil, "same text posted by " .. w.n .. " different players (spam wave)") end
            if S.waveN > 80 then
                for k, v in pairs(S.wave) do if now - v.t > 30 then S.wave[k] = nil end end
                S.waveN = U.count(S.wave)
            end
        end
        local rec = S.strikes[U.key(player)]
        if rec and rec.count >= 3 and sev > 0 then sev = math.min(5, sev + 1) end
    end

    local ev = {}
    if not stateless and #abuseWords > 0 then
        local plain = D.c2(D.fold(msg):lower())
        local compactP = (plain:gsub("[^%a]", ""))
        local fl = {}
        for _, w in ipairs(abuseWords) do
            if not plain:find(w, 1, true) then
                local wc = (w:gsub("[^%a]", ""))
                if D.c1(plain):find(D.c1(w), 1, true) then fl.stretch = true
                elseif #wc >= 3 and compactP:find(wc, 1, true) then fl.split = true
                elseif #wc >= 3 and D.c1(compactP):find(D.c1(wc), 1, true) then fl.split, fl.stretch = true, true
                elseif msg:find("[01345@%$]") then fl.leet = true
                else fl.alter = true end
            end
        end
        if D.hasLookalike(msg) then fl.uni = true end
        if fuzzyTok then fl.alter = true end
        if fl.split then ev[#ev + 1] = "letters split by spaces/symbols (e.g. f*ck, f u c k)" end
        if fl.leet then ev[#ev + 1] = "number/symbol substitution (e.g. sh1t, @ss)" end
        if fl.stretch then ev[#ev + 1] = "stretched letters (e.g. fuuuck)" end
        if fl.uni then ev[#ev + 1] = "look-alike or hidden unicode characters" end
        if fl.alter then ev[#ev + 1] = "deliberately altered spelling" end
        if ambigTok then ev[#ev + 1] = "coded abbreviation ('" .. ambigTok .. "')" end
    end
    return sev, cats, hits, doubt, table.concat(hints, "; "), ctoks, targeted, ev, waveCount
end
function D.quick(msg) local s = D.analyze(nil, msg, true) return s end

function D.isTagged(t) return t:find("###", 1, true) ~= nil end
function D.posMatch(tagged, raw)
    if #tagged ~= #raw then return false end
    local any = false
    for i = 1, #tagged do
        local a = tagged:sub(i, i)
        if a == "#" then any = true elseif a ~= raw:sub(i, i) then return false end
    end
    return any
end
function D.filteredWords(raw, tagged)
    local out, total = {}, 0
    for s, w, e in raw:gmatch("()(%a+)()") do
        total += 1
        if tagged:sub(s, e - 1):find("#", 1, true) then out[#out + 1] = w:lower() end
    end
    return out, total
end

