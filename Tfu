function R.reasonText(cats)
    local p = {}
    for _, c in ipairs(cats) do p[#p + 1] = R.REASONS[c] or c end
    return table.concat(p, " ")
end
function R.game() return "Game PlaceId: " .. tostring(game.PlaceId) .. " | JobId: " .. tostring(game.JobId) end
function R.logFor(key, name, uid)
    local log = S.chatLog[key] or {}
    local lines = { "CHAT LOG — " .. tostring(name) .. " (UserId " .. tostring(uid) .. ") | " .. R.game() }
    if #log == 0 then lines[#lines + 1] = "(no messages captured)" end
    for _, e in ipairs(log) do
        local line = "[" .. e.time .. "] " .. e.text
        if e.taggedOnly then line = line .. "   ← TAGGED by Roblox (original hidden)"
        elseif e.tagged then line = line .. "   ← TAGGED by Roblox as: " .. tostring(e.tagText) end
        lines[#lines + 1] = line
    end
    return table.concat(lines, "\n")
end
function R.short(i)
    local p = R.POLICY[i.cat] or R.POLICY.profanity
    local m = #i.msg > 90 and (i.msg:sub(1, 90) .. "...") or i.msg
    local s = "Reporting " .. i.name .. " (UserId " .. tostring(i.userId) .. ") who " .. p[2] .. ". Message: \"" .. m .. "\" at " .. i.time .. ". "
    if i.targeted then s = s .. "It was aimed at another player. " end
    if i.count and i.count > 1 then s = s .. "This is flagged message #" .. i.count .. " from this user this session. " end
    if i.tagged then s = s .. "Roblox's own filter also tagged it. " end
    return s .. "Violates the Community Standards (" .. p[1] .. ")."
end
function R.tiny(i)
    local m = #i.msg > 80 and (i.msg:sub(1, 80) .. "...") or i.msg
    local s = "\"" .. m .. "\" at " .. i.time .. "."
    if i.targeted then s = s .. " Aimed at a player." end
    if i.count and i.count > 1 then s = s .. " Flagged x" .. i.count .. " this session." end
    if i.tagged then s = s .. " Roblox filter tagged it." end
    return s:sub(1, 190)
end
function R.full(i)
    local p = R.POLICY[i.cat] or R.POLICY.profanity
    local m = #i.msg > 300 and (i.msg:sub(1, 300) .. "...") or i.msg
    local L = {
        "Subject: Chat report — " .. i.name .. " (UserId " .. tostring(i.userId) .. ")", "", "Hello Roblox Trust & Safety,", "",
        "I am reporting the user " .. i.name .. " (display name: " .. tostring(i.display) .. ", UserId: " .. tostring(i.userId)
            .. ", account age: " .. tostring(i.age or 0) .. " days) for violating the Roblox Community Standards (" .. p[1] .. ").", "",
        "What happened:",
