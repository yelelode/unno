    Pollinations = { gap = 6, min = 4, max = 25, nextAt = 0, coolUntil = 0, pen = 4 },
}

local function getProviders()
    local list = {}
    if hasKey(GROQ_KEY) then
        list[#list + 1] = { name = "Groq", url = GROQ_URL, model = GROQ_MODEL, key = GROQ_KEY }
    end
    if hasKey(GEMINI_KEY) then
        list[#list + 1] = { name = "Gemini", url = GEMINI_URL, model = GEMINI_MODEL, key = GEMINI_KEY, extra = { reasoning_effort = "none" }, minTokens = 200 }
    end
    if hasKey(AI_API_KEY) then
        list[#list + 1] = { name = "OpenRouter", url = AI_URL, model = AI_MODEL, key = AI_API_KEY, openrouter = true }
    end
    if USE_FREE_FALLBACK then
        list[#list + 1] = { name = "Pollinations", url = POLLI_URL, model = POLLI_MODEL }
    end
    return list
end

local function orderedProviders()
    local now = os.clock()
    local ready, cooling = {}, {}
    for _, p in ipairs(getProviders()) do
        if rate[p.name].coolUntil > now then
            cooling[#cooling + 1] = p
        else
            ready[#ready + 1] = p
        end
    end
    table.sort(ready, function(a, b)
        local ra, rb = rate[a.name], rate[b.name]
        return math.max(ra.nextAt, now) + ra.pen < math.max(rb.nextAt, now) + rb.pen
    end)
    for _, p in ipairs(cooling) do
        ready[#ready + 1] = p
    end
    return ready
end

local function waitSlot(name)
    local r = rate[name]
    local now = os.clock()
    local at = math.max(now, r.nextAt)
    r.nextAt = at + r.gap
    if at > now then
        task.wait(at - now)
    end
end

local function tryProvider(p, requester, messages, maxTokens)
    local r = rate[p.name]
    local headers = { ["Content-Type"] = "application/json" }
    if p.key then
        headers["Authorization"] = "Bearer " .. p.key
    end
    if p.openrouter then
        headers["HTTP-Referer"] = "https://www.roblox.com"
        headers["X-Title"] = "Phantom OS"
    end
    local lastErr, lastCode = p.name .. ": failed", 0
    for attempt = 1, (p.extra and 2 or 1) do
        local payload = { model = p.model, messages = messages, max_tokens = math.max(maxTokens or 300, p.minTokens or 0), temperature = 0 }
        if p.extra and attempt == 1 then
            for k, v in pairs(p.extra) do
                payload[k] = v
            end
        end
        local okEnc, body = pcall(HttpService.JSONEncode, HttpService, payload)
        if not okEnc then
            return nil, p.name .. ": encode error", 0
        end
        waitSlot(p.name)
        local ok, res = pcall(requester, { Url = p.url, Method = "POST", Headers = headers, Body = body })
        if ok and type(res) == "table" then
            local code = res.StatusCode or res.status_code or (res.Success and 200) or 0
            local raw = res.Body or ""
            local okD, data = pcall(HttpService.JSONDecode, HttpService, raw)
            local content, err
            if okD and type(data) == "table" then
                local ch = data.choices and data.choices[1]
                if ch and ch.message and type(ch.message.content) == "string" then
                    content = ch.message.content
                elseif data.error then
                    err = type(data.error) == "table" and (data.error.message or "api error") or tostring(data.error)
                end
            end
            if not content and not err and code >= 200 and code < 300 and type(raw) == "string" and raw ~= "" then
                content = raw
            end
            if content and content ~= "" then
                r.gap = math.max(r.min, r.gap * 0.92)
                return content, nil, code
            end
            lastCode = code
            lastErr = p.name .. ": " .. tostring(err or ("HTTP " .. tostring(code)))
            if code == 429 then
                r.gap = math.min(r.max, r.gap * 2)
                r.coolUntil = os.clock() + 30
                return nil, p.name .. ": rate limited (429)", code
            elseif code == 401 or code == 403 then
                r.coolUntil = os.clock() + 300
                return nil, p.name .. ": key rejected (" .. code .. ")", code
            end
            if not (code == 400 and p.extra and attempt == 1) then
                break
            end
        else
            r.coolUntil = os.clock() + 10
            return nil, p.name .. ": request failed", 0
        end
    end
    return nil, lastErr, lastCode
end

local function callAI(messages, maxTokens)
    local requester = getRequester()
    if not requester then
        return nil, nil, "Executor has no HTTP request function.", 0
    end
    local order = orderedProviders()
    if #order == 0 then
        return nil, nil, "No AI provider enabled.", 0
    end
    local lastErr, lastCode = "unknown error", 0
    for _, p in ipairs(order) do
        local content, err, code = tryProvider(p, requester, messages, maxTokens)
        if content then
            return content, p.name, nil, code
        end
        lastErr, lastCode = err or lastErr, code or lastCode
    end
    return nil, nil, lastErr, lastCode
end

