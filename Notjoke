-- __namecall hook: legacy SayMessageRequest + TextChannel:SendAsync, with Self-Guard
pcall(function()
    if not (hookmetamethod and getnamecallmethod) then
        return
    end
    local oldNamecall
    local function handler(self, ...)
        local method = getnamecallmethod()
        if alive and (method == "FireServer" or method == "SendAsync") and typeof(self) == "Instance" then
            local isLegacy = method == "FireServer" and self.Name == "SayMessageRequest"
            local isNew = method == "SendAsync" and self.ClassName == "TextChannel"
            if (isLegacy or isNew) and not (checkcaller and checkcaller()) then
                local msg = ...
                if type(msg) == "string" then
                    if selfGuard then
                        local okS, sev = pcall(quickSeverity, msg)
                        if okS and type(sev) == "number" and sev >= 3 then
                            task.defer(notify, "Message blocked — keep chat kind 💚")
                            task.defer(onChat, LocalPlayer, msg, true, "hook")
                            return
                        end
                    end
                    task.defer(onChat, LocalPlayer, msg, false, "hook")
                end
            end
        end
        return oldNamecall(self, ...)
    end
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
end)

