local verdictCache, cacheN = {}, 0
local learnVotes, safeVotes, tagVotes = {}, {}, {}

local function judge(item)
    local prompt = "Chat:\n" .. (item.ctx ~= "" and item.ctx or "(none)")
        .. "\nJudge " .. item.name .. ": \"" .. item.msg:sub(1, 160) .. "\""
        .. (item.hint ~= "" and ("\nNotes: " .. item.hint:sub(1, 160)) or "")
    local text, prov = callAI({
        { role = "system", content = JUDGE_SYSTEM },
        { role = "user", content = prompt },
    }, 60)
    if not text then
        return nil
    end
    aiLast = prov or "-"

    local data
    local j = text:match("%b{}")
    if j then
        local ok, d = pcall(HttpService.JSONDecode, HttpService, j)
        if ok and type(d) == "table" then
            data = d
        end
    end

    local violation, category, severity, reason
    if data then
        local v = data.v
        if v == nil then
            v = data.violation
        end
        violation = (v == 1) or (v == true) or (v == "1") or (v == "true")
        category = tostring(data.c or data.category or "none"):lower()
        severity = tonumber(data.s or data.severity) or 0
        reason = tostring(data.r or data.reason or "")
    else
        local low = text:lower()
        violation = (low:find("violation%W+true") ~= nil) or (low:find("\"v\"%W+1") ~= nil)
        category, severity, reason = "none", violation and 3 or 0, text:sub(1, 60)
    end
    if violation then
        if not VALID_CAT[category] then
            category = "harass"
        end
        severity = math.clamp(math.floor(severity + 0.5), 1, 5)
    end
    if #reason > 80 then
        reason = reason:sub(1, 80)
    end
    if reason == "" then
        reason = violation and "violates chat rules" or "looks fine"
    end
    local res = { violation = violation, category = category, severity = severity, reason = reason }
    cacheN += 1
    if cacheN > 150 then
        verdictCache, cacheN = {}, 1
    end
    verdictCache[item.key] = res
    return res
end

local function learnFromVerdict(item, res)
    if not res or not item.ctoks then
        return
    end
    for _, tok in ipairs(item.ctoks) do
        if not builtin[tok] and #tok >= 3 and #tok <= 14 then
            if res.violation then
                learnVotes[tok] = (learnVotes[tok] or 0) + 1
                if learnVotes[tok] >= CFG.LEARN_VOTES and not exactSet[tok] then
                    local cat = VALID_CAT[res.category] and res.category or "hindi"
                    local sev = math.clamp(res.severity, 2, 4)
                    addExact(tok, cat, sev, nil, false)
                    learned[tok] = { cat = cat, sev = sev }
                    markSave()
                    toast("🧠 Learned new word: " .. tok, NEON)
                end
            else
                safeVotes[tok] = (safeVotes[tok] or 0) + 1
                if safeVotes[tok] >= 2 then
                    whitelist[tok] = true
                    markSave()
                end
            end
        end
    end
end

local function enqueue(item)
    if #queue >= CFG.QUEUE_MAX then
        local worstPri, wi = 0, nil
        for i, q in ipairs(queue) do
            if q.pri > worstPri then
                worstPri, wi = q.pri, i
            end
        end
        if wi and worstPri >= item.pri then
            local dropped = table.remove(queue, wi)
            pcall(dropped.handle.applyAI, nil)
        else
            pcall(item.handle.applyAI, nil)
            return
        end
    end
    local pos = #queue + 1
    for i, q in ipairs(queue) do
        if q.pri > item.pri then
            pos = i
            break
        end
    end
    table.insert(queue, pos, item)
    updateStatus()
end

for _ = 1, CFG.WORKERS do
    task.spawn(function()
        while alive do
            local item = table.remove(queue, 1)
            if item then
                if os.clock() - item.t > 40 then
                    pcall(item.handle.applyAI, nil)
                else
                    local res = judge(item)
                    if alive then
                        pcall(item.handle.applyAI, res)
                        learnFromVerdict(item, res)
                        updateStatus()
                    end
                end
            else
                task.wait(0.25)
            end
        end
    end)
end

