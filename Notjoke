    alive = false
    for _, c in ipairs(conns) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(conns)
    table.clear(queue)
    if gui then
        gui:Destroy()
    end
    env.PhantomOS_Cleanup = nil
end

env.PhantomOS_Cleanup = cleanup
closeBtn.Activated:Connect(cleanup)

updateStatus()
selectTab("Live Mod")
