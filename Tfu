local function refreshProviders()
    local enabled = { Groq = hasKey(Api.GROQ_KEY), Gemini = hasKey(Api.GEMINI_KEY), OpenRouter = hasKey(Api.AI_API_KEY), Pollinations = Api.USE_FREE_FALLBACK }
    local now = os.clock()
    local anyReady, anyCool = false, false
    for name, lbl in pairs(provLabels) do
        if not enabled[name] then lbl.Text, lbl.TextColor3 = "○ off (no key)", Th.MUTED
        elseif rate[name].coolUntil > now then anyCool = true; lbl.Text, lbl.TextColor3 = "● cooling " .. math.ceil(rate[name].coolUntil - now) .. "s", Th.AMBER
        else anyReady = true; lbl.Text, lbl.TextColor3 = "● ready", Th.GREEN end
    end
    statusDot.BackgroundColor3 = anyReady and Th.GREEN or (anyCool and Th.AMBER or Th.RED)
    listsLabel.Text = "🌐 " .. St.remoteStats.words .. " words · " .. St.remoteStats.phrases .. " phrases · " .. St.remoteStats.status
end

