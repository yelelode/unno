local function anyIn(s, list)
    for _, v in ipairs(list) do
        if s:find(v, 1, true) then
            return v
        end
    end
    return nil
end

-- returns sev, cats, hits, doubt, hint, ctoks, targeted
local function analyze(player, msg, stateless)
    local norm = normalize(msg)
    local glued = (norm:gsub(SYMS, ""))
    local variants = { norm }
    if glued ~= norm then
        variants[2] = glued
    end

    local sev, catSet, cats, hits = 0, {}, {}, {}
    local doubt, hints, ctoks, seenTok = false, {}, {}, {}
    local function hit(cat, s, word)
        if not catSet[cat] then
            catSet[cat] = true
            cats[#cats + 1] = cat
        end
        hits[#hits + 1] = word
        if s > sev then
            sev = s
        end
    end
    local function addDoubt(tok, h)
        doubt = true
        hints[#hints + 1] = h
        if tok and not seenTok[tok] then
            seenTok[tok] = true
            ctoks[#ctoks + 1] = tok
        end
    end

    local targeted = false
    for _, vs in ipairs(variants) do
        local tokens = tokenize(vs)
        local joined = table.concat(tokens, " ")
        local joinedSq = c1(joined)
        local compact = (joined:gsub("[^%a]", ""))

        for _, tok in ipairs(tokens) do
            local e = exactSet[tok]
            if not e and #tok >= 4 then
                e = exactSet[c1(tok)]
            end
            if e then
                hit(e.cat, e.sev, tok)
                if e.ambig then
                    addDoubt(tok, "'" .. tok .. "' may be a Hindi abuse abbreviation/evasion spelling or harmless")
                end
            elseif not whitelist[tok] then
                if #tok >= 4 and (remoteSet[tok] or remoteSet[c1(tok)]) and not STOP[tok] then
                    addDoubt(tok, "'" .. tok .. "' is on public bad-word lists (may be harmless)")
                elseif #tok >= 5 and SKEL[skeleton(tok)] then
                    hit("hindi", 3, tok)
                    addDoubt(tok, "'" .. tok .. "' sounds like Hindi abuse '" .. SKEL[skeleton(tok)] .. "'")
                elseif #tok >= 3 and #tok <= 6 and not tok:find("[aeiouy]") and not CONSONANT_OK[tok] then
                    addDoubt(tok, "unknown abbreviation '" .. tok .. "'")
                end
            end
            if TARGET_WORDS[tok] then
                targeted = true
            end
        end

        for _, e in ipairs(substrList) do
            local w, cat, s, wc, w1 = e[1], e[2], e[3], e[4], e[5]
            if joined:find(w, 1, true) or (w1 and joinedSq:find(w1, 1, true)) or (#wc >= 7 and compact:find(wc, 1, true)) then
                hit(cat, s, w)
            end
        end

        for _, p in ipairs(suspectList) do
            if joined:find(p, 1, true) then
                addDoubt(nil, "phrase '" .. p .. "' may hide an insult or unsafe request")
                break
            end
        end
    end

    -- Spam / scam-script detection (raw text)
    local rawLow = foldUnicode(msg):lower()
    for _, p in ipairs(SCAM_PATTERNS) do
        if rawLow:find(p[1], 1, true) then
            hit(p[2], p[3], p[1])
            if p[3] >= 3 then
                addDoubt(nil, "contains '" .. p[1] .. "' (possible spam/scam script)")
            end
        end
    end
    if anyIn(rawLow, SCRIPT_WORDS) and anyIn(rawLow, PUSH_WORDS) then
        hit("scam", 3, "script-ad")
        addDoubt(nil, "looks like a script/exploit advertisement")
    end
    if anyIn(rawLow, ROBUX_WORDS) and anyIn(rawLow, GIFT_WORDS) then
        hit("scam", 4, "robux-scam")
        addDoubt(nil, "possible free-Robux scam")
    end
    for _, ph in ipairs(remotePhrases) do
        if rawLow:find(ph, 1, true) then
            hit("scam", 3, ph)
            addDoubt(nil, "matches known spam phrase '" .. ph .. "'")
            break
        end
    end
    if #msg >= 60 then
        local _, letters = msg:gsub("%a", "")
        if letters / #msg < 0.35 then
            hit("spam", 2, "symbol-flood")
        end
    end

    if sev >= 2 and targeted then
        sev = math.min(5, sev + 1)
    end

    if not stateless and typeof(player) == "Instance" then
        local now = os.clock()
        local f = flood[player]
        if not f then
            f = { times = {}, last = "", lastT = 0, dup = 0 }
            flood[player] = f
        end
        table.insert(f.times, now)
        while #f.times > 0 and now - f.times[1] > 6 do
            table.remove(f.times, 1)
        end
        local low = msg:lower()
        if low == f.last and now - f.lastT < 20 then
            f.dup += 1
        else
            f.dup = 1
        end
        f.last, f.lastT = low, now
        if #f.times >= 5 or f.dup >= 3 then
            hit("spam", 2, "flood")
        end

        -- coordinated copy-paste wave (3+ different players, same text)
        if #msg >= 12 then
            local wk = norm
            local w = wave[wk]
            if not w or now - w.t > 20 then
                if not w then
                    waveN += 1
                end
                w = { t = now, players = {}, n = 0 }
                wave[wk] = w
            end
            if not w.players[player] then
                w.players[player] = true
                w.n += 1
            end
            if w.n >= 3 then
                hit("spam", 3, "wave")
                addDoubt(nil, "same text posted by " .. w.n .. " different players (spam wave)")
            end
            if waveN > 80 then
                for k, v in pairs(wave) do
                    if now - v.t > 30 then
                        wave[k] = nil
                    end
                end
                waveN = countKeys(wave)
            end
        end

        local rec = strikes[keyOf(player)]
        if rec and rec.count >= 3 and sev > 0 then
            sev = math.min(5, sev + 1)
        end
    end

    return sev, cats, hits, doubt, table.concat(hints, "; "), ctoks, targeted
end

local function quickSeverity(msg)
    local s = analyze(nil, msg, true)
    return s
end

-- ---------- Tag (####) helpers ----------
local function isTagged(text)
    return text:find("###", 1, true) ~= nil
end

local function posMatch(tagged, raw)
    if #tagged ~= #raw then
        return false
    end
    local anyTag = false
    for i = 1, #tagged do
        local a = tagged:sub(i, i)
        if a == "#" then
            anyTag = true
        elseif a ~= raw:sub(i, i) then
            return false
        end
    end
    return anyTag
end

local function filteredWords(raw, tagged)
    local out, total = {}, 0
    for s, w, e in raw:gmatch("()(%a+)()") do
        total += 1
        if tagged:sub(s, e - 1):find("#", 1, true) then
            out[#out + 1] = w:lower()
        end
    end
    return out, total
end

-- ---------- Chat log ----------
local function logMessage(player, msg, opts)
    local k = keyOf(player)
    local log = chatLog[k]
    if not log then
        log = {}
        chatLog[k] = log
    end
    local entry = {
        t = os.clock(),
        time = os.date("%H:%M:%S"),
        text = msg,
        tagged = opts.tagged or false,
        tagText = opts.tagText,
        taggedOnly = opts.taggedOnly or false,
    }
    log[#log + 1] = entry
    if #log > 15 then
        table.remove(log, 1)
    end
    return entry
end

local function findRaw(player, taggedText)
    local log = chatLog[keyOf(player)]
    if not log then
        return nil
    end
    local now = os.clock()
    for i = #log, 1, -1 do
        local e = log[i]
        if now - e.t > 6 then
            break
        end
        if not e.tagged and not e.taggedOnly and posMatch(taggedText, e.text) then
            return e
        end
    end
    return nil
end

