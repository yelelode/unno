function V.rebuild(tab)
    for _, c in ipairs(S.uiConns) do pcall(function() c:Disconnect() end) end
    S.uiConns = {}
    if V.main then V.pos, V.size = V.main.Position, V.main.Size end
    if V.gui then V.gui:Destroy() end
    V.buildAll()
    V.select(tab or "Live", true)
    V.showMain()
end
function H.cleanup()
    if not S.alive then return end
    if S.autoSave and S.flagged > 0 then pcall(R.saveFile) end
    S.alive = false
    pcall(function() if H.shieldSet then TCS.OnIncomingMessage = H.oldIncoming end end)
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(S.uiConns) do pcall(function() c:Disconnect() end) end
    table.clear(S.conns)
    table.clear(S.uiConns)
    table.clear(S.queue)
    if V.main and V.main.Parent and not S.perfNow then
        pcall(function()
            U.tw(V.scaleObj, { Scale = S.scale * 0.8 }, 0.2)
            U.tw(V.main, { BackgroundTransparency = 1 }, 0.2)
        end)
        local g = V.gui
        task.delay(0.25, function() if g then g:Destroy() end end)
    elseif V.gui then
        V.gui:Destroy()
    end
    env.PhantomOS_Cleanup = nil
end

