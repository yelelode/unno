        U.round(c, 9)
        V.sv[key] = U.label(c, "0", 15, T.NEON, Enum.Font.GothamBlack, { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 2), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
        V.sv[key]:SetAttribute("col", T.NEON)
