function V.select(name, instant)
    V.cur = name
    for i, n in ipairs(V.tabs) do
        local b = V.tabBtns[n]
        U.tw(b, { TextColor3 = (n == name) and T.WHITE or T.MUTED }, 0.2)
        if n == name and V.tabPill then
            local x = 3 + (i - 1) * 65
            if instant then V.tabPill.Position = UDim2.new(0, x, 0, 3)
            else
                U.tw(V.tabPill, { Position = UDim2.new(0, x, 0, 3), Size = UDim2.new(0, 70, 0, 22) }, 0.14)
                task.delay(0.14, function() if V.tabPill and V.tabPill.Parent then U.tw(V.tabPill, { Size = UDim2.new(0, 62, 0, 22) }, 0.22, Enum.EasingStyle.Back) end end)
            end
