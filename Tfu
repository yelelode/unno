function V.refreshProviders()
    if not V.provLabels or not V.statusDot or not V.statusDot.Parent then return end
    local enabled = { Groq = U.hasKey(KEYS.groq), Gemini = U.hasKey(KEYS.gemini), OpenRouter = U.hasKey(KEYS.openrouter), Pollinations = CFG.pollinations.enabled }
    local now = os.clock()
    local ready, cool = false, false
    V.provReady = {}
    for name, lbl in pairs(V.provLabels) do
        local dot = V.provDots[name]
        if not enabled[name] then
            lbl.Text, lbl.TextColor3 = "○ off (no key)", T.MUTED
            if dot then dot.BackgroundColor3 = T.MUTED end
        elseif A.rate[name].coolUntil > now then
            cool = true
            lbl.Text, lbl.TextColor3 = "cooling " .. math.ceil(A.rate[name].coolUntil - now) .. "s", T.AMBER
            if dot then dot.BackgroundColor3 = T.AMBER end
        else
            ready = true
            V.provReady[name] = true
            lbl.Text, lbl.TextColor3 = "ready", T.GREEN
            if dot then dot.BackgroundColor3 = T.GREEN end
        end
    end
    U.tw(V.statusDot, { BackgroundColor3 = ready and T.GREEN or (cool and T.AMBER or T.RED) }, 0.5)
    if V.listsLabel and V.listsLabel.Parent then
        V.listsLabel.Text = "🌐 " .. D.rstat.words .. " words · " .. D.rstat.phrases .. " phrases · " .. D.rstat.status
    end
end

