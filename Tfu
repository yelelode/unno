end
function H.sorted()
    local l = {}
    for _, d in pairs(S.strikes) do l[#l + 1] = d end
    table.sort(l, function(a, b)
        if a.count ~= b.count then return a.count > b.count end
        if a.tags ~= b.tags then return a.tags > b.tags end
        return a.name < b.name
    end)
    return l
end
function H.schedule()
