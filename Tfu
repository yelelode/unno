function V.refreshProviders()
    local enabled = { Groq = U.hasKey(KEYS.groq), Gemini = U.hasKey(KEYS.gemini), OpenRouter = U.hasKey(KEYS.openrouter), Pollinations = CFG.pollinations.enabled }
    local now = os.clock()
    local ready, cool = false, false
    for name, lbl in pairs(V.provLabels) do
        if not enabled[name] then lbl.Text, lbl.TextColor3 = "○ off (no key)", T.MUTED
        elseif A.rate[name].coolUntil > now then
            cool = true
            lbl.Text, lbl.TextColor3 = "● cooling " .. math.ceil(A.rate[name].coolUntil - now) .. "s", T.AMBER
        else
            ready = true
            lbl.Text, lbl.TextColor3 = "● ready", T.GREEN
        end
    end
    V.statusDot.BackgroundColor3 = ready and T.GREEN or (cool and T.AMBER or T.RED)
    V.listsLabel.Text = "🌐 " .. D.rstat.words .. " words · " .. D.rstat.phrases .. " phrases · " .. D.rstat.status
end

